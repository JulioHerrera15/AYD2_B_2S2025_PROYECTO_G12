{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMq": ""
  },
  "Outbox": {
    "Source": "despacho",
    "PollingIntervalMs": 2000,
    "BatchSize": 20,
    "MaxReintentos": 5
  },
  "Despacho": {
    "LogiExpressTimeoutMs": 3000,
    "InventarioTimeoutMs": 3000
  },
  "LogiExpress": {
    "BaseUrl": "http://logiexpress-mock:8080"
  },
  "Inventario": {
    "BaseUrl": "http://inventario-api:8080"
  }
}
