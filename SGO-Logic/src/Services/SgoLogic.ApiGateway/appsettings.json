{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ExigirJwt": false
  },
  "Auth": {
    "JwtSecret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "auth-short-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/auth" }
        ]
      },
      "carrito-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/carrito/{**remainder}" }
      },
      "carrito-short-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/carrito/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/carrito" }
        ]
      },
      "estado-route": {
        "ClusterId": "consulta-estado-cluster",
        "Match": { "Path": "/api/estado/{**remainder}" }
      },
      "estado-short-route": {
        "ClusterId": "consulta-estado-cluster",
        "Match": { "Path": "/estado/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/estado" }
        ]
      },
      "incidencias-route": {
        "ClusterId": "consulta-estado-cluster",
        "Match": { "Path": "/api/incidencias/{**remainder}" }
      },
      "incidencias-short-route": {
        "ClusterId": "consulta-estado-cluster",
        "Match": { "Path": "/incidencias/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/incidencias" }
        ]
      },
      "mensajes-route": {
        "ClusterId": "mock-mensajeria-cluster",
        "Match": { "Path": "/api/mensajes/{**remainder}" }
      },
      "ordenes-route": {
        "ClusterId": "ordenes-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/ordenes/{**remainder}" }
      },
      "ordenes-short-route": {
        "ClusterId": "ordenes-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/ordenes/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/ordenes" }
        ]
      },
      "pagos-route": {
        "ClusterId": "pagos-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/pagos/{**remainder}" }
      },
      "pagos-short-route": {
        "ClusterId": "pagos-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/pagos/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/pagos" }
        ]
      },
      "facturacion-route": {
        "ClusterId": "facturacion-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/facturacion/{**remainder}" }
      },
      "facturacion-short-route": {
        "ClusterId": "facturacion-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/facturacion/{**remainder}" },
        "Transforms": [
          { "PathPrefix": "/api/facturacion" }
        ]
      },
      "inventario-route": {
        "ClusterId": "inventario-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/inventario/{**remainder}" }
      },
      "inventario-short-route": {
        "ClusterId": "inventario-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/inventario/{**remainder}" },
        "Transforms": [
          { "PathRemovePrefix": "/inventario" },
          { "PathPrefix": "/api/inventario" }
        ]
      },
      "auditoria-route": {
        "ClusterId": "auditoria-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/auditoria/{**remainder}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/auditoria" },
          { "PathPrefix": "/auditoria" }
        ]
      },
      "auditoria-short-route": {
        "ClusterId": "auditoria-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/auditoria/{**remainder}" }
      },
      "despacho-route": {
        "ClusterId": "despacho-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/despacho/{**remainder}" }
      },
      "despacho-short-route": {
        "ClusterId": "despacho-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/despacho/{**remainder}" },
        "Transforms": [
          { "PathRemovePrefix": "/despacho" },
          { "PathPrefix": "/api/despacho" }
        ]
      },
      "erp-route": {
        "ClusterId": "erp-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/erp/{**remainder}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://auth-api:8080" }
        }
      },
      "consulta-estado-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://consulta-estado-api:8080" }
        }
      },
      "mock-mensajeria-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://mock-mensajeria:8080" }
        }
      },
      "ordenes-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://ordenes-api:8080" }
        }
      },
      "pagos-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://pagos-api:8080" }
        }
      },
      "facturacion-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://facturacion-api:8080" }
        }
      },
      "inventario-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://inventario-api:8080" }
        }
      },
      "auditoria-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://auditoria-worker:8080" }
        }
      },
      "despacho-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://despacho-api:8080" }
        }
      },
      "erp-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://integracion-erp-worker:8080" }
        }
      }
    }
  }
}
