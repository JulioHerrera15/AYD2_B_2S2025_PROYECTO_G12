{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMq": ""
  },
  "Outbox": {
    "Source": "ordenes",
    "PollingIntervalMs": 2000,
    "BatchSize": 20,
    "MaxReintentos": 5
  },
  "Auth": {
    "JwtSecret": ""
  },
  "Fiscal": {
    "TasaIva": 0.12
  },
  "Credito": {
    "TimeoutEvaluacionSegundos": 30,
    "IntervaloTimeoutSegundos": 5
  },
  "MediosPagoPorCanal": {
    "WEB": [ "TARJETA", "TRANSFERENCIA", "BILLETERA_DIGITAL", "CREDITO" ],
    "MOVIL": [ "TARJETA", "BILLETERA_DIGITAL", "CREDITO" ],
    "CALL_CENTER": [ "TARJETA", "TRANSFERENCIA" ],
    "TIENDA": [ "TARJETA", "BILLETERA_DIGITAL" ]
  }
}
