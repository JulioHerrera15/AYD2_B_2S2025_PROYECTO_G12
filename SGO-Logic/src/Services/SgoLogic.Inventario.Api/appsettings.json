{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMq": ""
  },
  "Outbox": {
    "Source": "inventario",
    "PollingIntervalMs": 2000,
