@{
    ViewData["Title"] = "Microkernel de Notificaciones - MegaStore Admin";
    var microkernel = ViewBag.MicrokernelInfo as SgoLogic.Web.Services.MicrokernelInfoModel;
    var pendientes = ViewBag.Pendientes as List<SgoLogic.Web.Services.NotificacionPendienteModel> ?? new List<SgoLogic.Web.Services.NotificacionPendienteModel>();
    var mensajes = ViewBag.Mensajes as List<SgoLogic.Web.Services.NotificacionMensajeModel> ?? new List<SgoLogic.Web.Services.NotificacionMensajeModel>();
    var exito = TempData["Exito"] as string;
    var error = TempData["Error"] as string;
    var alerta = TempData["Alerta"] as string;
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8 pb-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">extension</span>
                Patrón de Diseño &bull; Microkernel (Plugin-based Architecture)
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Gestión del Microkernel de Notificaciones</h1>
            <p class="text-xs sm:text-sm text-text-muted">Administración y observabilidad en tiempo de ejecución de plugins de mensajería, aislamiento de fallos y reintentos transaccionales.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Monitoreo" class="bg-surface-white border border-border-subtle text-primary px-4 py-2 rounded-xl text-xs font-semibold hover:bg-surface-container-low active:scale-95 transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">hub</span>
                Monitoreo Global
            </a>
            <a href="/Despacho" class="bg-surface-white border border-border-subtle text-primary px-4 py-2 rounded-xl text-xs font-semibold hover:bg-surface-container-low active:scale-95 transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                Control Despacho
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrWhiteSpace(exito))
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
            <span>@exito</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 text-xs font-semibold flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-[20px] text-red-600">error</span>
            <span>@error</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(alerta))
    {
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-[20px] text-amber-600">warning</span>
            <span>@alerta</span>
        </div>
    }

    <!-- Architecture Overview Card -->
    <div class="bg-gradient-to-br from-surface-white via-surface-container-lowest to-surface-container-low p-6 rounded-3xl border border-border-subtle shadow-sm flex flex-col lg:flex-row gap-6 items-start lg:items-center justify-between">
        <div class="flex items-start gap-4 max-w-2xl">
            <div class="w-12 h-12 rounded-2xl bg-secondary text-white flex items-center justify-center flex-shrink-0 shadow-md">
                <span class="material-symbols-outlined text-[26px]">hub</span>
            </div>
            <div>
                <h2 class="text-base font-bold text-primary">Núcleo Microkernel & Registro Dinámico</h2>
                <p class="text-xs text-text-muted mt-1 leading-relaxed">
                    El servicio central de notificaciones delega el despacho multicanal a adaptadores desacoplados registrados en <code class="bg-surface-white px-1.5 py-0.5 rounded text-[11px] font-mono border">IPluginRegistry</code>. Si un plugin falla o es deshabilitado, el kernel aísla el incidente salvaguardando la saga transaccional de órdenes y registra el reintento con backoff exponencial.
                </p>
                <div class="flex flex-wrap items-center gap-3 mt-3 text-[11px] font-medium text-text-muted">
                    <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Despacho desacoplado</span>
                    <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Aislamiento de fallas (B3)</span>
                    <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-purple-500"></span> Activación dinámica sin reinicio</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 border-t lg:border-t-0 lg:border-l border-border-subtle/80 pt-4 lg:pt-0 lg:pl-6 w-full lg:w-auto justify-between lg:justify-start">
            <div class="flex flex-col text-center">
                <span class="text-2xl font-bold font-mono text-primary">@(microkernel?.TotalPlugins ?? microkernel?.Plugins?.Count ?? 4)</span>
                <span class="text-[11px] text-text-muted uppercase tracking-wider font-semibold">Plugins Totales</span>
            </div>
            <div class="w-px h-10 bg-border-subtle"></div>
            <div class="flex flex-col text-center">
                <span class="text-2xl font-bold font-mono text-emerald-600">@(microkernel?.Plugins?.Count(p => p.Habilitado) ?? 4)</span>
                <span class="text-[11px] text-text-muted uppercase tracking-wider font-semibold">Activos</span>
            </div>
            <div class="w-px h-10 bg-border-subtle"></div>
            <div class="flex flex-col text-center">
                <span class="text-2xl font-bold font-mono text-amber-600">@pendientes.Count</span>
                <span class="text-[11px] text-text-muted uppercase tracking-wider font-semibold">Pendientes</span>
            </div>
        </div>
    </div>

    <!-- Microkernel Plugins Grid -->
    <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-lg font-bold text-primary">Plugins Instalados en el Microkernel</h2>
                <p class="text-xs text-text-muted">Activa o desactiva adaptadores de salida en caliente sin interrumpir el procesamiento de eventos.</p>
            </div>
            <span class="text-xs font-mono text-text-muted">API: /api/kernel/plugins</span>
        </div>

        @if (microkernel?.Plugins is null || microkernel.Plugins.Count == 0)
        {
            <!-- Fallback demostrativo si no responde el backend temporalmente -->
            <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 text-xs">
                No se pudo conectar directamente con <code class="font-mono">/api/kernel/plugins</code>. Mostrando la configuración estándar del microkernel.
            </div>
        }

        @{
            var pluginsList = microkernel?.Plugins ?? new List<SgoLogic.Web.Services.PluginMetadataModel>
            {
                new("plugin-email", "EmailNotificacionPlugin", "EMAIL", "1.0.0", 1, true),
                new("plugin-sms", "SmsNotificacionPlugin", "SMS", "1.0.0", 2, true),
                new("plugin-push", "PushNotificacionPlugin", "PUSH", "1.0.0", 3, true),
                new("plugin-webhook", "WebhookNotificacionPlugin", "WEBHOOK", "1.0.0", 4, true)
            };
        }

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var plugin in pluginsList)
            {
                var iconCanal = plugin.Canal switch
                {
                    "EMAIL" => "mail",
                    "SMS" => "sms",
                    "PUSH" => "notifications",
                    "WEBHOOK" => "webhook",
                    _ => "extension"
                };

                var canalColor = plugin.Canal switch
                {
                    "EMAIL" => "text-blue-600 bg-blue-50 border-blue-200",
                    "SMS" => "text-emerald-600 bg-emerald-50 border-emerald-200",
                    "PUSH" => "text-purple-600 bg-purple-50 border-purple-200",
                    "WEBHOOK" => "text-amber-600 bg-amber-50 border-amber-200",
                    _ => "text-gray-600 bg-gray-50 border-gray-200"
                };

                <div class="bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-sm flex flex-col justify-between gap-4 transition-all hover:border-secondary/40">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center border @canalColor">
                                <span class="material-symbols-outlined text-[22px]">@iconCanal</span>
                            </div>
                            @if (plugin.Habilitado)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    ACTIVO
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-red-700 bg-red-50 px-2 py-0.5 rounded-full border border-red-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                    INACTIVO
                                </span>
                            }
                        </div>

                        <h3 class="text-sm font-bold text-primary truncate" title="@plugin.Nombre">
                            @plugin.Nombre
                        </h3>
                        <p class="text-[11px] font-mono text-text-muted mt-0.5">
                            ID: @plugin.Id
                        </p>

                        <div class="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-border-subtle/60 text-[11px]">
                            <div>
                                <span class="text-text-muted block">Canal</span>
                                <span class="font-bold text-primary">@plugin.Canal</span>
                            </div>
                            <div>
                                <span class="text-text-muted block">Prioridad</span>
                                <span class="font-bold text-primary">Nivel @plugin.Prioridad</span>
                            </div>
                            <div>
                                <span class="text-text-muted block">Versión</span>
                                <span class="font-mono text-primary">v@plugin.Version</span>
                            </div>
                            <div>
                                <span class="text-text-muted block">Aislamiento</span>
                                <span class="font-semibold text-emerald-600">Aislado B3</span>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Toggle Action -->
                    <form method="post" action="/Notificaciones/TogglePlugin" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@plugin.Id" />
                        <input type="hidden" name="habilitado" value="@((!plugin.Habilitado).ToString().ToLowerInvariant())" />

                        @if (plugin.Habilitado)
                        {
                            <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-semibold bg-surface-container-low hover:bg-red-50 text-text-muted hover:text-red-700 border border-border-subtle hover:border-red-200 transition-colors flex items-center justify-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px]">pause_circle</span>
                                Desactivar Plugin
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors flex items-center justify-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px]">play_circle</span>
                                Activar Plugin
                            </button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Testing Console & Activity Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Direct Dispatch Testing Console -->
        <div class="bg-surface-white p-6 rounded-3xl border border-border-subtle shadow-sm flex flex-col gap-4">
            <div class="flex items-center gap-2 pb-3 border-b border-border-subtle">
                <span class="material-symbols-outlined text-[20px] text-secondary">send</span>
                <div>
                    <h3 class="text-sm font-bold text-primary">Consola de Despacho del Kernel</h3>
                    <p class="text-[11px] text-text-muted">Prueba el envío multicanal y el aislamiento de fallos en vivo.</p>
                </div>
            </div>

            <form method="post" action="/Notificaciones/Despachar" class="flex flex-col gap-3">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Destinatario</label>
                    <input type="text" name="destinatario" value="cliente1@sgo.local" required class="w-full px-3 py-2 text-xs rounded-xl border border-border-subtle bg-surface-container-lowest focus:outline-none focus:border-secondary transition-colors" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Canal de Salida</label>
                    <select name="canal" class="w-full px-3 py-2 text-xs rounded-xl border border-border-subtle bg-surface-container-lowest focus:outline-none focus:border-secondary transition-colors">
                        <option value="EMAIL">EMAIL (EmailNotificacionPlugin)</option>
                        <option value="SMS">SMS (SmsNotificacionPlugin)</option>
                        <option value="PUSH">PUSH (PushNotificacionPlugin)</option>
                        <option value="WEBHOOK">WEBHOOK (WebhookNotificacionPlugin)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Asunto</label>
                    <input type="text" name="asunto" value="Prueba Microkernel MegaStore" required class="w-full px-3 py-2 text-xs rounded-xl border border-border-subtle bg-surface-container-lowest focus:outline-none focus:border-secondary transition-colors" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Cuerpo del Mensaje</label>
                    <textarea name="cuerpo" rows="3" required class="w-full px-3 py-2 text-xs rounded-xl border border-border-subtle bg-surface-container-lowest focus:outline-none focus:border-secondary transition-colors resize-none">Mensaje transaccional enviado a traves del microkernel multicanal.</textarea>
                </div>

                <button type="submit" class="mt-2 bg-primary text-on-primary py-2.5 px-4 rounded-xl text-xs font-semibold hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2 shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">forward_to_inbox</span>
                    Despachar vía Microkernel
                </button>
            </form>
        </div>

        <!-- Live Dispatched Feed & Pending Retries (2 columns) -->
        <div class="lg:col-span-2 flex flex-col gap-4">
            <!-- Tabs / Filter Header -->
            <div class="flex items-center justify-between pb-2 border-b border-border-subtle">
                <div class="flex items-center gap-2">
                    <button type="button" id="btnTabEnviados" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-on-primary transition-colors" onclick="cambiarTab('enviados')">
                        Avisos Enviados (@mensajes.Count)
                    </button>
                    <button type="button" id="btnTabPendientes" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-surface-container-low text-text-muted hover:text-primary transition-colors" onclick="cambiarTab('pendientes')">
                        Cola de Reintentos (@pendientes.Count)
                    </button>
                </div>
                <span class="text-[11px] text-text-muted font-mono">Actualización en vivo</span>
            </div>

            <!-- Tab 1: Enviados -->
            <div id="tabEnviados" class="flex flex-col gap-3">
                @if (mensajes.Count == 0)
                {
                    <div class="p-8 text-center bg-surface-white rounded-2xl border border-border-subtle text-text-muted text-xs">
                        No hay mensajes registrados en el feed en este momento.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto bg-surface-white rounded-2xl border border-border-subtle shadow-sm">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-border-subtle bg-surface-container-lowest text-[11px] font-bold text-text-muted uppercase tracking-wider">
                                    <th class="py-3 px-4">Canal</th>
                                    <th class="py-3 px-4">Destinatario</th>
                                    <th class="py-3 px-4">Asunto / Contenido</th>
                                    <th class="py-3 px-4">Fecha</th>
                                    <th class="py-3 px-4 text-right">Estado</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-subtle/50">
                                @foreach (var m in mensajes.Take(15))
                                {
                                    <tr class="hover:bg-surface-container-lowest transition-colors">
                                        <td class="py-3 px-4">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider font-mono bg-surface-container-low text-primary border border-border-subtle">
                                                @m.Canal
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 font-mono font-medium text-primary">
                                            @m.Destinatario
                                        </td>
                                        <td class="py-3 px-4 max-w-xs truncate" title="@m.Cuerpo">
                                            <strong class="text-primary block truncate">@(m.Asunto ?? "(sin asunto)")</strong>
                                            <span class="text-text-muted text-[11px] block truncate">@m.Cuerpo</span>
                                        </td>
                                        <td class="py-3 px-4 text-text-muted font-mono text-[11px] whitespace-nowrap">
                                            @m.Fecha.ToLocalTime().ToString("HH:mm:ss")
                                        </td>
                                        <td class="py-3 px-4 text-right">
                                            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
                                                <span class="material-symbols-outlined text-[12px]">check</span>
                                                OK
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Tab 2: Pendientes de Reintento -->
            <div id="tabPendientes" class="hidden flex flex-col gap-3">
                @if (pendientes.Count == 0)
                {
                    <div class="p-8 text-center bg-surface-white rounded-2xl border border-border-subtle text-text-muted text-xs">
                        <span class="material-symbols-outlined text-[28px] text-emerald-600 mb-1 block">task_alt</span>
                        Cero notificaciones pendientes. Todos los envíos se han procesado exitosamente.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto bg-surface-white rounded-2xl border border-border-subtle shadow-sm">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-border-subtle bg-surface-container-lowest text-[11px] font-bold text-text-muted uppercase tracking-wider">
                                    <th class="py-3 px-4">Canal</th>
                                    <th class="py-3 px-4">Destinatario</th>
                                    <th class="py-3 px-4">Intentos</th>
                                    <th class="py-3 px-4">Último Error</th>
                                    <th class="py-3 px-4 text-right">Próximo Intento</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-subtle/50">
                                @foreach (var p in pendientes)
                                {
                                    <tr class="hover:bg-surface-container-lowest transition-colors">
                                        <td class="py-3 px-4">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider font-mono bg-amber-50 text-amber-700 border border-amber-200">
                                                @p.Canal
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 font-mono font-medium text-primary">
                                            @p.Destinatario
                                        </td>
                                        <td class="py-3 px-4 font-mono text-primary">
                                            @p.Intentos
                                        </td>
                                        <td class="py-3 px-4 text-red-600 max-w-xs truncate" title="@p.UltimoError">
                                            @(p.UltimoError ?? "Fallo de conexión con proveedor")
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono text-[11px] text-text-muted">
                                            @p.ProximoIntentoEn.ToLocalTime().ToString("HH:mm:ss")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function cambiarTab(tab) {
        const tabEnv = document.getElementById('tabEnviados');
        const tabPend = document.getElementById('tabPendientes');
        const btnEnv = document.getElementById('btnTabEnviados');
        const btnPend = document.getElementById('btnTabPendientes');

        if (tab === 'enviados') {
            tabEnv.classList.remove('hidden');
            tabPend.classList.add('hidden');
            btnEnv.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-on-primary transition-colors';
            btnPend.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-surface-container-low text-text-muted hover:text-primary transition-colors';
        } else {
            tabEnv.classList.add('hidden');
            tabPend.classList.remove('hidden');
            btnEnv.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-surface-container-low text-text-muted hover:text-primary transition-colors';
            btnPend.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-on-primary transition-colors';
        }
    }
</script>
