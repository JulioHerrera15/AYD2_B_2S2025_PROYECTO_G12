@model SgoLogic.Web.Services.CarritoModel
@{
    ViewData["Title"] = "Finalizar compra";
    var subtotal = Model.Items?.Sum(i => i.Subtotal) ?? 0m;
    var iva = Math.Round(subtotal * 0.12m / 1.12m, 2);
    var subtotalNeto = subtotal - iva;
    var tiendas = (ViewBag.Sucursales as IReadOnlyList<SgoLogic.Web.Services.SucursalModel>
        ?? Array.Empty<SgoLogic.Web.Services.SucursalModel>())
        .Where(s => s.EsTienda)
        .ToList();
    var tarjetasGuardadas = ViewBag.Tarjetas as IReadOnlyList<SgoLogic.Web.Services.TarjetaGuardadaModel>
        ?? Array.Empty<SgoLogic.Web.Services.TarjetaGuardadaModel>();
    var autenticado = (bool)(ViewBag.Autenticado ?? false);
    var hayTarjetas = autenticado && tarjetasGuardadas.Count > 0;
    // Se preselecciona la tarjeta usada mas recientemente (las vencidas no se pueden elegir).
    var tarjetaPreseleccionada = tarjetasGuardadas
        .Where(t => !t.Vencida)
        .OrderByDescending(t => t.UltimoUsoEn ?? DateTime.MinValue)
        .ThenByDescending(t => t.CreadaEn)
        .FirstOrDefault();
    // Credito MegaStore: siempre visible; solo seleccionable si hay disponible para el total.
    var opcionCredito = ViewBag.OpcionCredito as SgoLogic.Web.Services.OpcionCreditoCheckout
        ?? new SgoLogic.Web.Services.OpcionCreditoCheckout(
            SgoLogic.Web.Services.EstadoOpcionCredito.ServicioNoDisponible, null,
            SgoLogic.Web.Services.OpcionCreditoCheckout.MensajeServicioNoDisponible);
    var sucursalSeleccionada = ViewBag.SucursalSeleccionada as string;
    if (string.IsNullOrWhiteSpace(sucursalSeleccionada) || tiendas.All(t => t.Id != sucursalSeleccionada))
    {
        sucursalSeleccionada = tiendas.FirstOrDefault()?.Id ?? SgoLogic.Web.Controllers.CatalogoController.SucursalPorDefecto;
    }
}

<!-- Logos de marca de tarjeta (Font Awesome, iconos fa-cc-*) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" referrerpolicy="no-referrer" />

<div class="max-w-4xl mx-auto">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
        <nav class="flex items-center gap-2 text-xs text-text-muted mb-2">
            <a href="/" class="hover:text-primary transition-colors">Inicio</a>
            <span>/</span>
            <a href="/Carrito" class="hover:text-primary transition-colors">Carrito</a>
            <span>/</span>
            <span class="text-primary font-semibold">Finalizar compra</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Finalizar compra</h1>
        <p class="text-sm text-text-muted">Completa tus datos de entrega, facturación y pago.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-6 bg-error-container text-on-error-container border border-error/20 rounded-2xl p-4 flex items-center gap-3">
            <span class="material-symbols-outlined text-error">error</span>
            <div class="text-sm font-medium">@ViewBag.Error</div>
        </div>
    }

    <form asp-action="Procesar" method="post" id="checkout-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Shipping & Payment Details (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
            <!-- Customer & Billing Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        1
                    </div>
                    <h2 class="text-base font-bold text-primary">Tus datos y facturación</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Correo electrónico</label>
                        <input type="email" name="clienteEmail" value="@ViewBag.UserEmail" placeholder="ejemplo@correo.com" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                        <span class="text-[11px] text-text-muted mt-1 block">Te enviaremos la confirmación del pedido, tu factura electrónica y los avisos de entrega.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">NIT o CUI para tu factura</label>
                        <input type="text" name="receptorCui" value="CF" placeholder="CF o CUI de 13 dígitos" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                        <span class="text-[11px] text-text-muted mt-1 block">Escribe "CF" si no necesitas factura a tu nombre.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Nombre para la factura</label>
                        <input type="text" name="nombreFactura" value="@(ViewBag.UserName ?? "Consumidor Final")" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                    </div>
                </div>
            </div>

            <!-- Fulfillment Method Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        2
                    </div>
                    <h2 class="text-base font-bold text-primary">Entrega</h2>
                </div>

                <!-- Delivery Method Selector (Radio Cards) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                    <label class="relative flex items-center gap-3 p-4 rounded-2xl border-2 border-primary bg-surface-container-low/40 cursor-pointer hover:bg-surface-container-low transition-colors" id="label-domicilio">
                        <input type="radio" name="metodoEntrega" value="DOMICILIO" checked onchange="toggleEntrega(this.value)"
                               class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-primary flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                                Envío a domicilio
                            </span>
                            <span class="text-xs text-text-muted">Llega en 24 a 48 horas</span>
                        </div>
                    </label>

                    <label class="relative flex items-center gap-3 p-4 rounded-2xl border-2 border-border-subtle/80 bg-surface-container-low/20 cursor-pointer hover:bg-surface-container-low transition-colors" id="label-tienda">
                        <input type="radio" name="metodoEntrega" value="RECOGIDA_TIENDA" onchange="toggleEntrega(this.value)"
                               class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-primary flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px]">storefront</span>
                                Recoger en tienda
                            </span>
                            <span class="text-xs text-text-muted">Gratis &bull; Listo en 2 horas</span>
                        </div>
                    </label>
                </div>

                <!-- Aviso de origen del pedido (simulacion de reserva en Inventario) -->
                <div id="aviso-simulacion" class="hidden mb-4 p-3.5 rounded-2xl border text-xs font-medium flex items-start gap-2.5" role="status" aria-live="polite">
                    <span id="aviso-simulacion-icono" class="material-symbols-outlined text-[18px]">info</span>
                    <div class="flex-1">
                        <div id="aviso-simulacion-texto"></div>
                        <button type="button" id="btn-usar-sugerida" class="hidden mt-1.5 font-semibold text-secondary hover:underline" data-ubicacion="">
                            Elegir esa tienda
                        </button>
                    </div>
                </div>

                <!-- Domicilio Details Panel -->
                <div id="panel-domicilio" class="flex flex-col gap-3 pt-2">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Departamento</label>
                            <select name="departamento" class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary">
                                <option value="Guatemala">Guatemala</option>
                                <option value="Sacatepequez">Sacatepéquez</option>
                                <option value="Quetzaltenango">Quetzaltenango</option>
                                <option value="Escuintla">Escuintla</option>
                                <option value="Chimaltenango">Chimaltenango</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Municipio</label>
                            <input type="text" name="municipio" value="Guatemala" class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1">Dirección de entrega</label>
                        <input type="text" name="direccion" placeholder="Calle, Avenida, Zona, Edificio o Casa" value="" required
                               class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1">Referencias (opcional)</label>
                        <input type="text" name="referencia" placeholder="Ejemplo: Portón blanco, frente al parque central" value=""
                               class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                    </div>
                </div>

                <!-- Tienda Details Panel -->
                <div id="panel-tienda" class="hidden flex flex-col gap-3 pt-2">
                    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Tienda donde recogerás tu pedido</label>
                    <select name="ubicacionSolicitadaId" id="select-tienda" disabled class="w-full px-3 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary">
                        @if (tiendas.Count == 0)
                        {
                            <option value="@sucursalSeleccionada" selected>@sucursalSeleccionada</option>
                        }
                        @foreach (var grupo in tiendas.GroupBy(t => t.Departamento).OrderBy(g => g.Key == "Guatemala" ? 0 : 1).ThenBy(g => g.Key))
                        {
                            <optgroup label="@grupo.Key">
                                @foreach (var tienda in grupo)
                                {
                                    <option value="@tienda.Id" selected="@(tienda.Id == sucursalSeleccionada)">@tienda.Nombre</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <p class="text-xs text-text-muted mt-1">Te avisaremos por SMS y correo cuando tu pedido esté listo para recoger.</p>
                </div>
            </div>

            <!-- Payment Method Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        3
                    </div>
                    <h2 class="text-base font-bold text-primary">Método de pago</h2>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-border-subtle bg-surface-container-low/30 cursor-pointer hover:bg-surface-container-low transition-colors">
                        <input type="radio" name="medioPago" value="TARJETA" checked class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">credit_card</span>
                                <span class="text-sm font-semibold text-primary">Tarjeta de crédito o débito</span>
                            </div>
                            <span class="text-[11px] text-text-muted">Visa &bull; Mastercard &bull; Amex</span>
                        </div>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-border-subtle bg-surface-container-low/30 cursor-pointer hover:bg-surface-container-low transition-colors">
                        <input type="radio" name="medioPago" value="TRANSFERENCIA" class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">account_balance</span>
                                <span class="text-sm font-semibold text-primary">Transferencia bancaria</span>
                            </div>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 p-3.5 rounded-2xl border border-border-subtle bg-surface-container-low/30 transition-colors @(opcionCredito.Seleccionable ? "cursor-pointer hover:bg-surface-container-low" : "opacity-70 cursor-not-allowed")">
                        <input type="radio" name="medioPago" value="CREDITO" class="text-primary focus:ring-primary h-4 w-4 mt-0.5"
                               @(opcionCredito.Seleccionable ? "" : "disabled") />
                        <div class="flex-1 flex flex-col gap-1">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">account_balance_wallet</span>
                                <span class="text-sm font-semibold text-primary">Crédito MegaStore: compra ahora, paga en 30 días</span>
                            </div>
                            @if (opcionCredito.Estado == SgoLogic.Web.Services.EstadoOpcionCredito.Disponible)
                            {
                                <span class="text-[11px] text-emerald-800">
                                    Disponible: Q @((opcionCredito.Disponible ?? 0m).ToString("N2"))
                                    @if (opcionCredito.FechaLimitePago is DateTime fechaLimite)
                                    {
                                        <text>&bull; Pagas a más tardar el @fechaLimite.ToString("dd/MM/yyyy")</text>
                                    }
                                </span>
                            }
                            else if (opcionCredito.Estado == SgoLogic.Web.Services.EstadoOpcionCredito.NoDisponibleParaCliente)
                            {
                                <span class="text-[11px] font-semibold text-primary">@opcionCredito.Titulo</span>
                                <span class="text-[11px] text-text-muted">@opcionCredito.Mensaje</span>
                                <a href="/Cuenta/Credito" class="text-[11px] font-semibold text-primary underline self-start">Ver detalle en Mi crédito</a>
                            }
                            else
                            {
                                <span class="text-[11px] text-text-muted">@opcionCredito.Mensaje</span>
                            }
                        </div>
                    </label>
                </div>

                <!-- Panel de datos de tarjeta — solo visible con TARJETA -->
                <div id="panel-tarjeta" class="mt-4 pt-4 border-t border-border-subtle/50 flex flex-col gap-3">
                    @if (hayTarjetas)
                    {
                        <!-- Tarjetas guardadas: solo marca, ultimos cuatro, vencimiento y titular -->
                        <div id="tarjetas-guardadas" class="flex flex-col gap-2">
                            <div class="text-xs font-semibold text-on-surface-variant">Usar tarjeta guardada</div>
                            @foreach (var tarjeta in tarjetasGuardadas)
                            {
                                <div class="tarjeta-guardada flex items-start gap-2" data-id="@tarjeta.Id">
                                    <label class="flex-1 flex items-center gap-3 p-3 rounded-2xl border border-border-subtle bg-surface-container-low/30 transition-colors @(tarjeta.Vencida ? "opacity-50 cursor-not-allowed" : "cursor-pointer hover:bg-surface-container-low")">
                                        <input type="radio" name="opcion-tarjeta" value="@tarjeta.Id"
                                               class="radio-tarjeta-guardada text-primary focus:ring-primary h-4 w-4"
                                               data-marca="@tarjeta.Marca" data-ultimos="@tarjeta.Ultimos4"
                                               disabled="@tarjeta.Vencida"
                                               checked="@(tarjeta.Id == tarjetaPreseleccionada?.Id)" />
                                        <i class="@tarjeta.IconoMarca text-[28px] text-primary" aria-hidden="true"></i>
                                        <span class="sr-only">@tarjeta.Marca</span>
                                        <div class="flex-1 min-w-0">
                                            <div class="font-mono text-sm font-semibold text-primary tracking-wider">@tarjeta.Enmascarado</div>
                                            <div class="text-[11px] text-text-muted truncate">@("Vence " + tarjeta.VenceTexto + (string.IsNullOrWhiteSpace(tarjeta.Titular) ? "" : " - " + tarjeta.Titular))</div>
                                        </div>
                                        @if (tarjeta.Vencida)
                                        {
                                            <span class="text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded">Vencida</span>
                                        }
                                    </label>
                                    <button type="button" class="btn-eliminar-tarjeta mt-3 text-[11px] font-medium text-error hover:underline"
                                            data-id="@tarjeta.Id" data-ultimos="@tarjeta.Ultimos4">
                                        Eliminar
                                    </button>
                                </div>
                            }

                            <!-- Solo el CVV: el resto ya lo conoce Pagos por la tarjeta guardada -->
                            <div id="cvv-guardada-panel" class="hidden">
                                <label for="cvv-guardada" class="block text-xs font-semibold text-on-surface-variant mb-1">Código de seguridad</label>
                                <input id="cvv-guardada" type="password" inputmode="numeric" maxlength="3"
                                       placeholder="3 dígitos" autocomplete="cc-csc"
                                       oninput="this.value = this.value.replace(/\D/g, ''); limpiarErrorCampo('cvv-guardada'); actualizarBotonConfirmar();"
                                       class="w-40 px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary font-mono" />
                                <p id="error-cvv-guardada" class="hidden mt-1 text-[11px] font-semibold text-error" role="alert"></p>
                            </div>

                            <button type="button" id="btn-agregar-tarjeta" onclick="abrirNuevaTarjeta()"
                                    class="self-start text-xs font-semibold text-secondary hover:underline">
                                + Agregar tarjeta
                            </button>
                        </div>
                    }

                    <!-- Paso 1: capturar y validar la tarjeta -->
                    <div id="tarjeta-captura" class="@(tarjetaPreseleccionada is not null && hayTarjetas ? "hidden " : "")flex flex-col gap-3">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="sm:col-span-2">
                                <div class="flex items-center justify-between mb-1">
                                    <label for="pan-input" class="block text-xs font-semibold text-on-surface-variant">Número de tarjeta</label>
                                    <span id="card-brand-badge" class="hidden text-[11px] font-bold px-2 py-0.5 rounded"></span>
                                </div>
                                <input id="pan-input" type="text" inputmode="numeric" maxlength="23"
                                       placeholder="0000 0000 0000 0000" autocomplete="cc-number"
                                       oninput="formatearPan(this); limpiarErrorCampo('numero');"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary tracking-widest font-mono" />
                                <p id="error-numero" class="hidden mt-1 text-[11px] font-semibold text-error" role="alert"></p>
                            </div>
                            <div>
                                <label for="exp-input" class="block text-xs font-semibold text-on-surface-variant mb-1">Vencimiento</label>
                                <input id="exp-input" type="text" inputmode="numeric" maxlength="5"
                                       placeholder="MM/AA" autocomplete="cc-exp"
                                       oninput="formatearExp(this); limpiarErrorCampo('vencimiento');"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary font-mono" />
                                <p id="error-vencimiento" class="hidden mt-1 text-[11px] font-semibold text-error" role="alert"></p>
                            </div>
                            <div>
                                <label for="cvv-input" class="block text-xs font-semibold text-on-surface-variant mb-1">Código de seguridad</label>
                                <input id="cvv-input" type="password" inputmode="numeric" maxlength="4"
                                       placeholder="3 o 4 dígitos" autocomplete="cc-csc"
                                       oninput="this.value = this.value.replace(/\D/g, ''); limpiarErrorCampo('cvv');"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary font-mono" />
                                <p id="error-cvv" class="hidden mt-1 text-[11px] font-semibold text-error" role="alert"></p>
                            </div>
                            <div class="sm:col-span-2">
                                <label for="titular-input" class="block text-xs font-semibold text-on-surface-variant mb-1">Nombre del titular (como aparece en la tarjeta)</label>
                                <input id="titular-input" type="text" maxlength="60" autocomplete="cc-name" value="@ViewBag.UserName"
                                       oninput="limpiarErrorCampo('titular');"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                                <p id="error-titular" class="hidden mt-1 text-[11px] font-semibold text-error" role="alert"></p>
                            </div>
                        </div>

                        @if (autenticado)
                        {
                            <label class="flex items-center gap-2 text-xs text-on-surface-variant cursor-pointer">
                                <input type="checkbox" id="chk-guardar-tarjeta" checked
                                       class="rounded text-primary focus:ring-primary h-4 w-4" />
                                Guardar esta tarjeta para futuras compras (se guarda cuando el cobro se aprueba)
                            </label>
                        }
                        else
                        {
                            <p class="text-[11px] text-text-muted">
                                <a href="/Auth/Login?returnUrl=/Checkout" class="font-semibold text-secondary hover:underline">Inicia sesión</a> para guardar tus tarjetas.
                            </p>
                        }

                        <button type="button" id="btn-validar" onclick="validarTarjeta()"
                                class="w-full sm:w-auto self-start bg-surface-container-low text-primary border border-border-subtle px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-surface-variant active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">verified</span>
                            <span id="btn-validar-texto">Validar tarjeta</span>
                        </button>
                    </div>

                    <!-- Paso 1 completado: tarjeta validada -->
                    <div id="tarjeta-validada" class="hidden p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200/70 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[22px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold text-emerald-950">Tarjeta validada</span>
                                <span class="text-xs text-emerald-900"><span id="validada-marca"></span> terminada en <span id="validada-ultimos" class="font-mono"></span></span>
                            </div>
                        </div>
                        <button type="button" onclick="usarOtraTarjeta()" class="text-xs font-semibold text-secondary hover:underline">
                            Usar otra tarjeta
                        </button>
                    </div>

                    <!-- Mensajes de validación / error -->
                    <div id="tokenizacion-status" class="hidden text-xs font-semibold" role="status" aria-live="polite"></div>

                    <!-- Campo oculto que recibirá el token de la boveda de Pagos -->
                    <input type="hidden" id="token-medio-pago" name="tokenMedioPago" />

                    <p class="flex items-center gap-1.5 text-[11px] text-text-muted">
                        <span class="material-symbols-outlined text-[14px]">lock</span>
                        Tus datos de tarjeta se guardan cifrados solo mientras se procesa el cobro y se borran al terminar.
                    </p>
                </div>

                <!-- Términos y Consentimiento de Privacidad -->
                <div class="mt-5 pt-4 border-t border-border-subtle/50">
                    <label class="flex items-start gap-2.5 text-xs text-text-muted cursor-pointer">
                        <input type="checkbox" id="check-privacidad" required checked class="mt-0.5 rounded text-primary focus:ring-primary h-4 w-4" />
                        <span>
                            He leído y acepto la <a href="/Cuenta/Privacidad" target="_blank" class="font-semibold text-secondary hover:underline">Política de Privacidad y Tratamiento de Datos</a>.
                        </span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Summary (5 cols) -->
        <div class="lg:col-span-5">
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow sticky top-28">
                <h3 class="text-base font-bold text-primary mb-4 flex items-center justify-between">
                    <span>Resumen del pedido</span>
                    <span class="text-xs font-normal text-text-muted">@(Model.Items?.Count ?? 0) artículos</span>
                </h3>

                <!-- Items Scroll Container -->
                <div class="divide-y divide-border-subtle/40 max-h-72 overflow-y-auto pr-1 mb-5">
                    @if (Model.Items != null)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="py-3 flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined text-text-muted text-[22px]">inventory_2</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-xs font-semibold text-primary truncate">@item.Descripcion</div>
                                    <div class="text-[11px] text-text-muted">Cantidad: @item.Cantidad &bull; Q @item.PrecioUnitario.ToString("N2") c/u</div>
                                </div>
                                <div class="text-xs font-bold text-primary">
                                    Q @item.Subtotal.ToString("N2")
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Financial Breakdown -->
                <div class="space-y-2.5 pt-4 border-t border-border-subtle/50 text-xs">
                    <div class="flex justify-between text-text-muted">
                        <span>Subtotal</span>
                        <span>Q @subtotalNeto.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-text-muted">
                        <span>IVA (12%)</span>
                        <span>Q @iva.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-text-muted">
                        <span>Envío</span>
                        <span class="text-secondary font-semibold" id="costo-envio">Gratis</span>
                    </div>
                    <div class="flex justify-between text-base font-bold text-primary pt-3 border-t border-border-subtle/80">
                        <span>Total a pagar</span>
                        <span>Q @subtotal.ToString("N2")</span>
                    </div>
                </div>

                <!-- Submit Button: solo se habilita con una tarjeta validada (o con transferencia) -->
                <button type="button" id="btn-confirmar" disabled
                        onclick="confirmarPedido()"
                        class="w-full mt-6 bg-primary text-on-primary py-3.5 px-4 rounded-xl text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100">
                    <span class="material-symbols-outlined text-[20px]">lock</span>
                    <span id="btn-confirmar-texto">Confirmar y pagar</span>
                </button>
                <p id="confirmar-ayuda" class="mt-2 text-[11px] text-center text-text-muted">Valida tu tarjeta para continuar.</p>

                <div class="mt-4 text-center">
                    <a href="/Carrito" class="text-xs font-medium text-text-muted hover:text-primary transition-colors">
                        &larr; Volver al carrito
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Tokenizacion: el navegador manda la tarjeta a la Web (/Checkout/Tokenizar), que
    // la pasa a Pagos. Pagos la valida (es la autoridad), la cifra en su boveda
    // transitoria y devuelve un token opaco. El navegador ya no habla con PayKlik.
    // La validacion de aqui abajo solo da respuesta inmediata.
    const URL_TOKENIZACION = '/Checkout/Tokenizar';
    const TIEMPO_ESPERA_TOKENIZACION_MS = 10000;

    // El token vence (PAGOS_TOKEN_TTL_MINUTOS, 30 por defecto). Se da por vencido con
    // este margen para no enviar uno a punto de expirar.
    const MARGEN_VENCIMIENTO_MS = 60000;
    const VIGENCIA_TOKEN_POR_DEFECTO_MS = 30 * 60000;

    // { token, marca, ultimosCuatro, venceLocalMs } o null si no hay tarjeta validada.
    let tarjetaValidada = null;

    // Tarjetas guardadas: 'guardada' paga con una tarjeta de la lista (solo pide el
    // CVV y el token lo emite la boveda de Pagos); 'nueva' es el formulario de siempre.
    const USUARIO_AUTENTICADO = @(autenticado ? "true" : "false");
    const INICIA_CON_GUARDADA = @(hayTarjetas && tarjetaPreseleccionada is not null ? "true" : "false");
    let modoTarjeta = INICIA_CON_GUARDADA ? 'guardada' : 'nueva';

    function tokenAntiforgery() {
        return document.querySelector('#checkout-form input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    // Marca por prefijo: Visa 4; Mastercard 51-55 o 2221-2720; Amex 34 o 37.
    function detectarMarca(digitos) {
        if (digitos.startsWith('4')) return 'VISA';
        const dos = parseInt(digitos.substring(0, 2), 10);
        if (dos === 34 || dos === 37) return 'AMEX';
        if (dos >= 51 && dos <= 55) return 'MASTERCARD';
        const cuatro = parseInt(digitos.substring(0, 4), 10);
        if (digitos.length >= 4 && cuatro >= 2221 && cuatro <= 2720) return 'MASTERCARD';
        return null;
    }

    const ICONOS_MARCA = {
        VISA: 'fa-brands fa-cc-visa',
        MASTERCARD: 'fa-brands fa-cc-mastercard',
        AMEX: 'fa-brands fa-cc-amex'
    };

    function largoCvv(marca) {
        return marca === 'AMEX' ? 4 : 3;
    }

    // Longitudes validas por marca (las mismas que valida Pagos).
    const LONGITUDES_MARCA = { VISA: [13, 16, 19], MASTERCARD: [16], AMEX: [15] };

    // Errores por campo: numero, vencimiento (mesExp/anioExp), cvv, titular y cvv-guardada.
    const CAMPO_ERROR = { numero: 'numero', mesExp: 'vencimiento', anioExp: 'vencimiento', vencimiento: 'vencimiento', cvv: 'cvv', titular: 'titular' };

    function mostrarErrorCampo(campo, texto) {
        const el = document.getElementById('error-' + campo);
        if (!el) return;
        el.textContent = texto;
        el.classList.remove('hidden');
    }

    function limpiarErrorCampo(campo) {
        const el = document.getElementById('error-' + campo);
        if (el) {
            el.textContent = '';
            el.classList.add('hidden');
        }
    }

    function limpiarErroresTarjeta() {
        ['numero', 'vencimiento', 'cvv', 'titular', 'cvv-guardada'].forEach(limpiarErrorCampo);
    }

    // Pinta los errores {campo: mensaje} que devuelve Pagos (422) debajo de cada campo.
    function mostrarErroresServidor(errores, campoCvv) {
        let alguno = false;
        Object.entries(errores ?? {}).forEach(([campo, mensaje]) => {
            const destino = campo === 'cvv' && campoCvv ? campoCvv : (CAMPO_ERROR[campo] ?? null);
            if (destino) {
                mostrarErrorCampo(destino, mensaje);
                alguno = true;
            }
        });
        return alguno;
    }

    // Validacion local equivalente a la de Pagos: Luhn, longitud por marca,
    // vencimiento (vale hasta el ultimo dia del mes), CVV por marca y titular.
    function validarTarjetaLocal(pan, mes, anio, cvv, titular) {
        const errores = {};
        const marca = detectarMarca(pan);

        if (!pan) errores.numero = 'El número de tarjeta es obligatorio.';
        else if (!/^\d+$/.test(pan)) errores.numero = 'El número de tarjeta solo admite dígitos.';
        else if (!marca) errores.numero = 'Marca no soportada. Se admiten VISA, MASTERCARD y AMEX.';
        else if (!LONGITUDES_MARCA[marca].includes(pan.length)) errores.numero = `Longitud inválida para una tarjeta ${marca}.`;
        else if (!validarLuhn(pan)) errores.numero = 'El número de tarjeta no es válido.';

        if (isNaN(mes) || isNaN(anio)) {
            errores.vencimiento = 'Revisa el vencimiento. Usa el formato MM/AA, por ejemplo 12/28.';
        } else if (mes < 1 || mes > 12) {
            errores.vencimiento = 'El mes de vencimiento debe estar entre 1 y 12.';
        } else {
            const anioCompleto = anio < 100 ? 2000 + anio : anio;
            const hoy = new Date();
            if (anioCompleto * 12 + mes < hoy.getFullYear() * 12 + (hoy.getMonth() + 1)) {
                errores.vencimiento = 'La tarjeta está vencida.';
            }
        }

        if (!cvv) errores.cvv = 'El código de seguridad es obligatorio.';
        else if (!new RegExp(`^\\d{${largoCvv(marca)}}$`).test(cvv)) errores.cvv = `El código de seguridad debe tener ${largoCvv(marca)} dígitos.`;

        const titularLimpio = (titular ?? '').trim().replace(/\s+/g, ' ');
        if (!titularLimpio) errores.titular = 'El nombre del titular es obligatorio.';
        else if (titularLimpio.length < 2 || titularLimpio.length > 60) errores.titular = 'El nombre del titular debe tener entre 2 y 60 caracteres.';
        else if (!/^[\p{L} ]+$/u.test(titularLimpio)) errores.titular = 'El nombre del titular solo admite letras y espacios.';

        return errores;
    }

    // Milisegundos que le quedan al token segun su expiraEn, acotados para no
    // depender de que el reloj del navegador coincida con el de Pagos.
    function vigenciaTokenMs(expiraEn) {
        const restante = Date.parse(expiraEn) - Date.now();
        if (isNaN(restante)) return VIGENCIA_TOKEN_POR_DEFECTO_MS;
        return Math.min(Math.max(restante, MARGEN_VENCIMIENTO_MS * 2), VIGENCIA_TOKEN_POR_DEFECTO_MS);
    }

    function ajustarCvv(input, marca) {
        const largo = largoCvv(marca);
        input.maxLength = largo;
        input.placeholder = `${largo} dígitos`;
        if (input.value.length > largo) input.value = input.value.substring(0, largo);
    }

    function radioGuardadaSeleccionado() {
        return document.querySelector('.radio-tarjeta-guardada:checked');
    }

    // Suelta el token actual sin tocar que panel se muestra.
    function limpiarToken() {
        tarjetaValidada = null;
        document.getElementById('token-medio-pago').value = '';
    }

    function seleccionarTarjetaGuardada(radio) {
        modoTarjeta = 'guardada';
        limpiarToken();
        ocultarEstado();
        document.getElementById('tarjeta-captura').classList.add('hidden');
        document.getElementById('tarjeta-validada').classList.add('hidden');

        const cvv = document.getElementById('cvv-guardada');
        cvv.value = '';
        ajustarCvv(cvv, radio.dataset.marca);
        document.getElementById('cvv-guardada-panel').classList.remove('hidden');
        actualizarBotonConfirmar();
    }

    function abrirNuevaTarjeta() {
        modoTarjeta = 'nueva';
        limpiarToken();
        ocultarEstado();
        document.querySelectorAll('.radio-tarjeta-guardada').forEach(r => r.checked = false);
        document.getElementById('cvv-guardada-panel')?.classList.add('hidden');
        mostrarCaptura();
        actualizarBotonConfirmar();
        document.getElementById('pan-input').focus();
    }

    document.querySelectorAll('.radio-tarjeta-guardada').forEach(radio => {
        radio.addEventListener('change', function () {
            if (this.checked) seleccionarTarjetaGuardada(this);
        });
    });

    function quitarTarjetaDeLaLista(id) {
        document.querySelector(`.tarjeta-guardada[data-id="${id}"]`)?.remove();
        if (modoTarjeta === 'guardada' && !radioGuardadaSeleccionado()) {
            const siguiente = document.querySelector('.radio-tarjeta-guardada:not(:disabled)');
            if (siguiente) {
                siguiente.checked = true;
                seleccionarTarjetaGuardada(siguiente);
            } else {
                abrirNuevaTarjeta();
            }
        }
    }

    document.querySelectorAll('.btn-eliminar-tarjeta').forEach(boton => {
        boton.addEventListener('click', async function () {
            if (!confirm(`¿Eliminar la tarjeta terminada en ${this.dataset.ultimos}?`)) return;

            const datos = new URLSearchParams({ id: this.dataset.id });
            try {
                const res = await fetch('/Checkout/EliminarTarjeta', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': tokenAntiforgery() },
                    body: datos
                });
                if (res.ok) {
                    quitarTarjetaDeLaLista(this.dataset.id);
                } else {
                    mostrarEstado('error', 'No se pudo eliminar la tarjeta. Intenta de nuevo.');
                }
            } catch {
                mostrarEstado('error', 'No se pudo eliminar la tarjeta. Intenta de nuevo.');
            }
        });
    });

    // ── Toggle método de entrega ──────────────────────────────────────────────
    function toggleEntrega(valor) {
        const panelDomicilio = document.getElementById('panel-domicilio');
        const panelTienda    = document.getElementById('panel-tienda');
        const labelDomicilio = document.getElementById('label-domicilio');
        const labelTienda    = document.getElementById('label-tienda');

        // Con DOMICILIO el select de tienda queda deshabilitado y no se envia: asi
        // Inventario prioriza el centro de distribucion en lugar de la tienda.
        document.getElementById('select-tienda').disabled = valor !== 'RECOGIDA_TIENDA';
        simularOrigen();

        if (valor === 'RECOGIDA_TIENDA') {
            panelDomicilio.classList.add('hidden');
            panelTienda.classList.remove('hidden');
            labelTienda.classList.add('border-primary');
            labelTienda.classList.remove('border-border-subtle/80');
            labelDomicilio.classList.remove('border-primary');
            labelDomicilio.classList.add('border-border-subtle/80');
        } else {
            panelDomicilio.classList.remove('hidden');
            panelTienda.classList.add('hidden');
            labelDomicilio.classList.add('border-primary');
            labelDomicilio.classList.remove('border-border-subtle/80');
            labelTienda.classList.remove('border-primary');
            labelTienda.classList.add('border-border-subtle/80');
        }
    }

    // ── Toggle panel de tarjeta segun metodo de pago ─────────────────────────
    function medioPagoSeleccionado() {
        return document.querySelector('input[name="medioPago"]:checked')?.value;
    }

    document.querySelectorAll('input[name="medioPago"]').forEach(radio => {
        radio.addEventListener('change', function () {
            document.getElementById('panel-tarjeta').classList.toggle('hidden', this.value !== 'TARJETA');
            actualizarBotonConfirmar();
        });
    });

    // ── Formateo automático y detección de marca ──────────────────────────────
    function formatearPan(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 19);
        let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
        input.value = formatted;

        // Marca detectada mientras se escribe: icono, nombre y largo del CVV.
        const badge = document.getElementById('card-brand-badge');
        const marca = detectarMarca(val);
        if (marca) {
            badge.innerHTML = `<i class="${ICONOS_MARCA[marca]} text-[18px] align-middle" aria-hidden="true"></i> <span class="align-middle">${marca}</span>`;
            badge.className = 'text-[11px] font-bold px-2 py-0.5 rounded bg-surface-container-low text-primary inline-flex items-center gap-1';
        } else {
            badge.className = 'hidden';
        }
        ajustarCvv(document.getElementById('cvv-input'), marca);
    }

    function formatearExp(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 4);
        if (val.length >= 2) {
            input.value = val.substring(0, 2) + '/' + val.substring(2);
        } else {
            input.value = val;
        }
    }

    // ── Algoritmo de Luhn en cliente ──────────────────────────────────────────
    function validarLuhn(pan) {
        let sum = 0;
        let shouldDouble = false;
        for (let i = pan.length - 1; i >= 0; i--) {
            let digit = parseInt(pan.charAt(i), 10);
            if (shouldDouble) {
                digit *= 2;
                if (digit > 9) digit -= 9;
            }
            sum += digit;
            shouldDouble = !shouldDouble;
        }
        return (sum % 10) === 0;
    }

    // ── Mensajes y estado de los botones ──────────────────────────────────────
    function mostrarEstado(tipo, texto) {
        const statusEl = document.getElementById('tokenizacion-status');
        const colores = { error: 'text-error', info: 'text-text-muted', aviso: 'text-amber-800' };
        statusEl.textContent = texto;
        statusEl.className = 'text-xs font-semibold ' + (colores[tipo] ?? colores.info);
    }

    function ocultarEstado() {
        document.getElementById('tokenizacion-status').className = 'hidden';
    }

    function tokenVigente() {
        return tarjetaValidada !== null && Date.now() < tarjetaValidada.venceLocalMs - MARGEN_VENCIMIENTO_MS;
    }

    function cvvGuardadaCompleto() {
        const radio = radioGuardadaSeleccionado();
        const cvv = document.getElementById('cvv-guardada')?.value ?? '';
        return radio !== null && new RegExp(`^\\d{${largoCvv(radio.dataset.marca)}}$`).test(cvv);
    }

    function actualizarBotonConfirmar() {
        const btn = document.getElementById('btn-confirmar');
        const ayuda = document.getElementById('confirmar-ayuda');
        const conTarjeta = medioPagoSeleccionado() === 'TARJETA';
        const habilitado = !conTarjeta
            || tokenVigente()
            || (modoTarjeta === 'guardada' && cvvGuardadaCompleto());

        btn.disabled = !habilitado;
        ayuda.textContent = modoTarjeta === 'guardada'
            ? 'Escribe el código de seguridad de tu tarjeta para continuar.'
            : 'Valida tu tarjeta para continuar.';
        ayuda.classList.toggle('hidden', habilitado);
    }

    function mostrarCaptura() {
        document.getElementById('tarjeta-captura').classList.remove('hidden');
        document.getElementById('tarjeta-validada').classList.add('hidden');
    }

    // Descarta el token actual. Con tarjeta nueva vuelve al formulario; con tarjeta
    // guardada solo pide otra vez el CVV.
    function descartarTarjetaValidada() {
        limpiarToken();
        if (modoTarjeta === 'guardada') {
            const cvv = document.getElementById('cvv-guardada');
            if (cvv) cvv.value = '';
        } else {
            mostrarCaptura();
        }
        actualizarBotonConfirmar();
    }

    function usarOtraTarjeta() {
        descartarTarjetaValidada();
        ocultarEstado();
        document.getElementById('pan-input').focus();
    }

    // Si el token vence mientras el cliente sigue en la pagina, se le pide validar de nuevo.
    setInterval(() => {
        if (tarjetaValidada !== null && !tokenVigente()) {
            descartarTarjetaValidada();
            mostrarEstado('aviso', 'La validación de tu tarjeta expiró por seguridad. Ingresa los datos y valídala de nuevo.');
        }
    }, 5000);

    // ── Paso 1: validar la tarjeta (tokenizar en Pagos via la Web) ────────────
    async function validarTarjeta() {
        const btn = document.getElementById('btn-validar');
        const btnTexto = document.getElementById('btn-validar-texto');

        const pan = document.getElementById('pan-input').value.replace(/[\s-]/g, '');
        const cvv = document.getElementById('cvv-input').value.trim();
        const exp = document.getElementById('exp-input').value; // formato MM/AA
        const titular = document.getElementById('titular-input').value;

        const [mesStr, anioStr] = exp.split('/');
        const mesExp = parseInt(mesStr, 10);
        const anioExp = parseInt(anioStr, 10);

        limpiarErroresTarjeta();
        ocultarEstado();

        const erroresLocales = validarTarjetaLocal(pan, mesExp, anioExp, cvv, titular);
        if (Object.keys(erroresLocales).length > 0) {
            mostrarErroresServidor(erroresLocales);
            mostrarEstado('error', 'Revisa los datos marcados de la tarjeta.');
            return;
        }

        btn.disabled = true;
        btnTexto.textContent = 'Validando…';
        mostrarEstado('info', 'Validando tu tarjeta…');

        const cancelador = new AbortController();
        const temporizador = setTimeout(() => cancelador.abort(), TIEMPO_ESPERA_TOKENIZACION_MS);

        try {
            let res;
            try {
                const guardar = USUARIO_AUTENTICADO && document.getElementById('chk-guardar-tarjeta')?.checked === true;
                res = await fetch(URL_TOKENIZACION, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': tokenAntiforgery(), 'Accept': 'application/json' },
                    body: new URLSearchParams({
                        numero: pan,
                        mesExp: String(mesExp),
                        anioExp: String(anioExp),
                        cvv,
                        titular,
                        guardar: String(guardar)
                    }),
                    signal: cancelador.signal
                });
            } catch {
                throw new Error('SERVICIO_NO_DISPONIBLE');
            }

            const cuerpo = await res.json().catch(() => ({}));

            if (res.status === 422) {
                // Pagos es la autoridad: sus errores van debajo de cada campo.
                const conCampos = mostrarErroresServidor(cuerpo.errores);
                mostrarEstado('error', conCampos ? 'Revisa los datos marcados de la tarjeta.' : (cuerpo.mensaje || 'La tarjeta no fue aceptada.'));
                return;
            }

            if (!res.ok) {
                throw new Error('SERVICIO_NO_DISPONIBLE');
            }

            tarjetaValidada = {
                token: cuerpo.token,
                marca: cuerpo.marca,
                ultimosCuatro: cuerpo.ultimos4,
                venceLocalMs: Date.now() + vigenciaTokenMs(cuerpo.expiraEn)
            };
            document.getElementById('token-medio-pago').value = cuerpo.token;

            // Con el token emitido, los datos de la tarjeta ya no hacen falta en la pagina.
            document.getElementById('pan-input').value = '';
            document.getElementById('cvv-input').value = '';
            document.getElementById('exp-input').value = '';
            document.getElementById('card-brand-badge').className = 'hidden';

            document.getElementById('validada-marca').textContent = cuerpo.marca;
            document.getElementById('validada-ultimos').textContent = cuerpo.ultimos4;
            document.getElementById('tarjeta-captura').classList.add('hidden');
            document.getElementById('tarjeta-validada').classList.remove('hidden');
            ocultarEstado();
            actualizarBotonConfirmar();
        } catch (err) {
            console.error('Error validando la tarjeta:', err.message);
            mostrarEstado('error', 'No pudimos validar tu tarjeta en este momento. Tu carrito sigue guardado: intenta de nuevo en unos momentos.');
            btnTexto.textContent = 'Reintentar validación';
        } finally {
            clearTimeout(temporizador);
            btn.disabled = false;
            if (btnTexto.textContent === 'Validando…') {
                btnTexto.textContent = 'Validar tarjeta';
            }
        }
    }

    // Tarjeta guardada: pide a Pagos un token con el CVV escrito y lo deja en el mismo
    // lugar que la tokenizacion de una tarjeta nueva (mismo timer de vencimiento).
    async function obtenerTokenTarjetaGuardada() {
        const radio = radioGuardadaSeleccionado();
        const cvvInput = document.getElementById('cvv-guardada');
        limpiarErrorCampo('cvv-guardada');
        if (!radio || !cvvGuardadaCompleto()) {
            mostrarErrorCampo('cvv-guardada', `Escribe los ${radio ? largoCvv(radio.dataset.marca) : 3} dígitos del código de seguridad.`);
            return false;
        }

        mostrarEstado('info', 'Validando tu tarjeta…');
        const datos = new URLSearchParams({ id: radio.value, cvv: cvvInput.value });
        cvvInput.value = '';

        let res;
        try {
            res = await fetch('/Checkout/TokenTarjetaGuardada', {
                method: 'POST',
                headers: { 'RequestVerificationToken': tokenAntiforgery(), 'Accept': 'application/json' },
                body: datos
            });
        } catch {
            mostrarEstado('error', 'No pudimos validar tu tarjeta en este momento. Intenta de nuevo en unos momentos.');
            actualizarBotonConfirmar();
            return false;
        }

        const cuerpo = await res.json().catch(() => ({}));
        if (!res.ok) {
            const conCampos = res.status === 422 && mostrarErroresServidor(cuerpo.errores, 'cvv-guardada');
            mostrarEstado('error', conCampos ? 'Revisa el código de seguridad.' : (cuerpo.mensaje || 'No se pudo usar la tarjeta guardada.'));
            // 404: la tarjeta ya no existe o no es del cliente.
            if (res.status === 404) quitarTarjetaDeLaLista(radio.value);
            actualizarBotonConfirmar();
            return false;
        }

        tarjetaValidada = {
            token: cuerpo.token,
            marca: cuerpo.marca,
            ultimosCuatro: cuerpo.ultimos4,
            venceLocalMs: Date.now() + vigenciaTokenMs(cuerpo.expiraEn)
        };
        document.getElementById('token-medio-pago').value = cuerpo.token;
        ocultarEstado();
        return true;
    }

    // ── Paso 2: confirmar el pedido con el token ya emitido ───────────────────
    async function confirmarPedido() {
        const form = document.getElementById('checkout-form');

        if (!document.getElementById('check-privacidad').checked) {
            alert('Debes aceptar la política de privacidad y tratamiento de datos para continuar.');
            return;
        }

        if (medioPagoSeleccionado() === 'TARJETA') {
            if (modoTarjeta === 'guardada' && !tokenVigente()) {
                const btnConfirmar = document.getElementById('btn-confirmar');
                btnConfirmar.disabled = true;
                const obtenido = await obtenerTokenTarjetaGuardada();
                if (!obtenido) return;
            }

            if (!tokenVigente()) {
                descartarTarjetaValidada();
                mostrarEstado('aviso', 'La validación de tu tarjeta expiró por seguridad. Ingresa los datos y valídala de nuevo.');
                return;
            }
        } else {
            // Con transferencia o credito no se envia ningun token.
            document.getElementById('token-medio-pago').value = '';
        }

        const btn = document.getElementById('btn-confirmar');
        btn.disabled = true;
        document.getElementById('btn-confirmar-texto').textContent = 'Procesando tu pedido…';
        form.submit();
    }

    // ── Aviso de origen: simula la reserva sin reservar ───────────────────────
    function metodoEntregaSeleccionado() {
        return document.querySelector('input[name="metodoEntrega"]:checked')?.value ?? 'DOMICILIO';
    }

    function mostrarAvisoSimulacion(tipo, texto, sugerida) {
        const aviso = document.getElementById('aviso-simulacion');
        const icono = document.getElementById('aviso-simulacion-icono');
        const botonSugerida = document.getElementById('btn-usar-sugerida');
        const estilos = {
            aviso: ['bg-amber-50', 'border-amber-200/70', 'text-amber-950', 'local_shipping'],
            error: ['bg-rose-50', 'border-rose-200/70', 'text-rose-950', 'error']
        };
        const [fondo, borde, color, simbolo] = estilos[tipo] ?? estilos.aviso;

        aviso.className = `mb-4 p-3.5 rounded-2xl border text-xs font-medium flex items-start gap-2.5 ${fondo} ${borde} ${color}`;
        icono.textContent = simbolo;
        document.getElementById('aviso-simulacion-texto').textContent = texto;

        if (sugerida) {
            botonSugerida.dataset.ubicacion = sugerida;
            botonSugerida.classList.remove('hidden');
        } else {
            botonSugerida.classList.add('hidden');
        }
    }

    function ocultarAvisoSimulacion() {
        document.getElementById('aviso-simulacion').className = 'hidden';
    }

    let simulacionEnCurso = 0;

    async function simularOrigen() {
        const metodo = metodoEntregaSeleccionado();
        const tienda = document.getElementById('select-tienda').value;
        const turno = ++simulacionEnCurso;

        const parametros = new URLSearchParams({ metodoEntrega: metodo, _: Date.now() });
        if (metodo === 'RECOGIDA_TIENDA' && tienda) parametros.set('ubicacionSolicitadaId', tienda);

        try {
            const res = await fetch(`/Checkout/Simular?${parametros}`, { headers: { 'Accept': 'application/json' } });
            if (turno !== simulacionEnCurso) return;
            if (!res.ok || res.status === 204) {
                ocultarAvisoSimulacion();
                return;
            }

            const sim = await res.json();

            if (!sim.ubicacionId) {
                mostrarAvisoSimulacion('error', sim.motivo || 'No hay unidades suficientes para todo tu pedido en una misma ubicación.');
            } else if (metodo === 'DOMICILIO' && sim.esOtraSucursal) {
                mostrarAvisoSimulacion('aviso',
                    `Tu pedido se enviará desde la tienda ${sim.nombreUbicacion}, no desde tu sucursal ni desde el centro de distribución. Puede tardar más en llegar.`);
            } else if (metodo === 'RECOGIDA_TIENDA' && !sim.factible) {
                mostrarAvisoSimulacion('aviso',
                    `Tu sucursal no tiene todos los productos. ${sim.nombreUbicacion} sí los tiene para que los recojas ahí.`,
                    sim.ubicacionId);
            } else {
                ocultarAvisoSimulacion();
            }
        } catch {
            if (turno === simulacionEnCurso) ocultarAvisoSimulacion();
        }
    }

    document.getElementById('select-tienda').addEventListener('change', simularOrigen);

    document.getElementById('btn-usar-sugerida').addEventListener('click', function () {
        const select = document.getElementById('select-tienda');
        const destino = this.dataset.ubicacion;
        if (!destino || ![...select.options].some(o => o.value === destino)) return;
        select.value = destino;
        simularOrigen();
    });

    // Tarjeta guardada preseleccionada (la de uso mas reciente): solo falta el CVV.
    const preseleccionada = radioGuardadaSeleccionado();
    if (preseleccionada) seleccionarTarjetaGuardada(preseleccionada);

    actualizarBotonConfirmar();
    simularOrigen();
</script>
