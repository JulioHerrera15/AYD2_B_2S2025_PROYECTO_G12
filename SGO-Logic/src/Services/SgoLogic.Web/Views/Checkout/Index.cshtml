@model SgoLogic.Web.Services.CarritoModel
@{
    ViewData["Title"] = "Finalizar compra";
    var subtotal = Model.Items?.Sum(i => i.Subtotal) ?? 0m;
    var iva = Math.Round(subtotal * 0.12m / 1.12m, 2);
    var subtotalNeto = subtotal - iva;
}

<div class="max-w-4xl mx-auto">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
        <nav class="flex items-center gap-2 text-xs text-text-muted mb-2">
            <a href="/" class="hover:text-primary transition-colors">Inicio</a>
            <span>/</span>
            <a href="/Carrito" class="hover:text-primary transition-colors">Carrito</a>
            <span>/</span>
            <span class="text-primary font-semibold">Finalizar compra</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Finalizar compra</h1>
        <p class="text-sm text-text-muted">Completa tus datos de entrega, facturación y pago.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-6 bg-error-container text-on-error-container border border-error/20 rounded-2xl p-4 flex items-center gap-3">
            <span class="material-symbols-outlined text-error">error</span>
            <div class="text-sm font-medium">@ViewBag.Error</div>
        </div>
    }

    <form asp-action="Procesar" method="post" id="checkout-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Shipping & Payment Details (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
            <!-- Customer & Billing Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        1
                    </div>
                    <h2 class="text-base font-bold text-primary">Tus datos y facturación</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Correo electrónico</label>
                        <input type="email" name="clienteEmail" value="@ViewBag.UserEmail" placeholder="ejemplo@correo.com" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                        <span class="text-[11px] text-text-muted mt-1 block">Te enviaremos la confirmación del pedido, tu factura electrónica y los avisos de entrega.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">NIT o CUI para tu factura</label>
                        <input type="text" name="receptorCui" value="CF" placeholder="CF o CUI de 13 dígitos" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                        <span class="text-[11px] text-text-muted mt-1 block">Escribe "CF" si no necesitas factura a tu nombre.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Nombre para la factura</label>
                        <input type="text" name="nombreFactura" value="@(ViewBag.UserName ?? "Consumidor Final")" required
                               class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
                    </div>
                </div>
            </div>

            <!-- Fulfillment Method Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        2
                    </div>
                    <h2 class="text-base font-bold text-primary">Entrega</h2>
                </div>

                <!-- Delivery Method Selector (Radio Cards) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                    <label class="relative flex items-center gap-3 p-4 rounded-2xl border-2 border-primary bg-surface-container-low/40 cursor-pointer hover:bg-surface-container-low transition-colors" id="label-domicilio">
                        <input type="radio" name="metodoEntrega" value="DOMICILIO" checked onchange="toggleEntrega(this.value)"
                               class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-primary flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                                Envío a domicilio
                            </span>
                            <span class="text-xs text-text-muted">Llega en 24 a 48 horas</span>
                        </div>
                    </label>

                    <label class="relative flex items-center gap-3 p-4 rounded-2xl border-2 border-border-subtle/80 bg-surface-container-low/20 cursor-pointer hover:bg-surface-container-low transition-colors" id="label-tienda">
                        <input type="radio" name="metodoEntrega" value="RECOGIDA_TIENDA" onchange="toggleEntrega(this.value)"
                               class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-primary flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px]">storefront</span>
                                Recoger en tienda
                            </span>
                            <span class="text-xs text-text-muted">Gratis &bull; Listo en 2 horas</span>
                        </div>
                    </label>
                </div>

                <!-- Domicilio Details Panel -->
                <div id="panel-domicilio" class="flex flex-col gap-3 pt-2">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Departamento</label>
                            <select name="departamento" class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary">
                                <option value="Guatemala">Guatemala</option>
                                <option value="Sacatepequez">Sacatepéquez</option>
                                <option value="Quetzaltenango">Quetzaltenango</option>
                                <option value="Escuintla">Escuintla</option>
                                <option value="Chimaltenango">Chimaltenango</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Municipio</label>
                            <input type="text" name="municipio" value="Guatemala" class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1">Dirección de entrega</label>
                        <input type="text" name="direccion" placeholder="Calle, Avenida, Zona, Edificio o Casa" value="" required
                               class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-on-surface-variant mb-1">Referencias (opcional)</label>
                        <input type="text" name="referencia" placeholder="Ejemplo: Portón blanco, frente al parque central" value=""
                               class="w-full px-3 py-2 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary" />
                    </div>
                </div>

                <!-- Tienda Details Panel -->
                <div id="panel-tienda" class="hidden flex flex-col gap-3 pt-2">
                    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Tienda donde recogerás tu pedido</label>
                    <select name="ubicacionSolicitadaId" class="w-full px-3 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary">
                        <option value="TIENDA-01-CENTRAL">MegaStore Central — Zona 10 (Abierto 8:00 - 20:00)</option>
                        <option value="TIENDA-02-MIRAFLORES">MegaStore Miraflores — Zona 11 (Abierto 9:00 - 21:00)</option>
                        <option value="TIENDA-03-PORTALES">MegaStore Portales — Zona 17 (Abierto 9:00 - 20:00)</option>
                        <option value="TIENDA-04-PRADERA">MegaStore Pradera Concepción (Abierto 9:00 - 21:00)</option>
                    </select>
                    <p class="text-xs text-text-muted mt-1">Te avisaremos por SMS y correo cuando tu pedido esté listo para recoger.</p>
                </div>
            </div>

            <!-- Payment Method Section -->
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold text-xs">
                        3
                    </div>
                    <h2 class="text-base font-bold text-primary">Método de pago</h2>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-border-subtle bg-surface-container-low/30 cursor-pointer hover:bg-surface-container-low transition-colors">
                        <input type="radio" name="medioPago" value="TARJETA" checked class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">credit_card</span>
                                <span class="text-sm font-semibold text-primary">Tarjeta de crédito o débito</span>
                            </div>
                            <span class="text-[11px] text-text-muted">Visa &bull; Mastercard &bull; Amex</span>
                        </div>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-border-subtle bg-surface-container-low/30 cursor-pointer hover:bg-surface-container-low transition-colors">
                        <input type="radio" name="medioPago" value="TRANSFERENCIA" class="text-primary focus:ring-primary h-4 w-4" />
                        <div class="flex-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">account_balance</span>
                                <span class="text-sm font-semibold text-primary">Transferencia bancaria</span>
                            </div>
                        </div>
                    </label>
                </div>

                <!-- Panel de datos de tarjeta — solo visible con TARJETA -->
                <div id="panel-tarjeta" class="mt-4 pt-4 border-t border-border-subtle/50 flex flex-col gap-3">
                    <!-- Paso 1: capturar y validar la tarjeta -->
                    <div id="tarjeta-captura" class="flex flex-col gap-3">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="sm:col-span-2">
                                <div class="flex items-center justify-between mb-1">
                                    <label for="pan-input" class="block text-xs font-semibold text-on-surface-variant">Número de tarjeta</label>
                                    <span id="card-brand-badge" class="hidden text-[11px] font-bold px-2 py-0.5 rounded"></span>
                                </div>
                                <input id="pan-input" type="text" inputmode="numeric" maxlength="19"
                                       placeholder="0000 0000 0000 0000" autocomplete="cc-number"
                                       oninput="formatearPan(this)"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary tracking-widest font-mono" />
                            </div>
                            <div>
                                <label for="exp-input" class="block text-xs font-semibold text-on-surface-variant mb-1">Vencimiento</label>
                                <input id="exp-input" type="text" inputmode="numeric" maxlength="5"
                                       placeholder="MM/AA" autocomplete="cc-exp"
                                       oninput="formatearExp(this)"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary font-mono" />
                            </div>
                            <div>
                                <label for="cvv-input" class="block text-xs font-semibold text-on-surface-variant mb-1">Código de seguridad</label>
                                <input id="cvv-input" type="password" inputmode="numeric" maxlength="4"
                                       placeholder="3 o 4 dígitos" autocomplete="cc-csc"
                                       class="w-full px-3.5 py-2.5 rounded-xl border border-border-subtle bg-surface-container-low text-sm text-primary focus:outline-none focus:border-secondary font-mono" />
                            </div>
                        </div>

                        <button type="button" id="btn-validar" onclick="validarTarjeta()"
                                class="w-full sm:w-auto self-start bg-surface-container-low text-primary border border-border-subtle px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-surface-variant active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">verified</span>
                            <span id="btn-validar-texto">Validar tarjeta</span>
                        </button>
                    </div>

                    <!-- Paso 1 completado: tarjeta validada -->
                    <div id="tarjeta-validada" class="hidden p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200/70 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[22px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold text-emerald-950">Tarjeta validada</span>
                                <span class="text-xs text-emerald-900"><span id="validada-marca"></span> terminada en <span id="validada-ultimos" class="font-mono"></span></span>
                            </div>
                        </div>
                        <button type="button" onclick="usarOtraTarjeta()" class="text-xs font-semibold text-secondary hover:underline">
                            Usar otra tarjeta
                        </button>
                    </div>

                    <!-- Mensajes de validación / error -->
                    <div id="tokenizacion-status" class="hidden text-xs font-semibold" role="status" aria-live="polite"></div>

                    <!-- Campo oculto que recibirá el token de PayKlik -->
                    <input type="hidden" id="token-medio-pago" name="tokenMedioPago" />

                    <p class="flex items-center gap-1.5 text-[11px] text-text-muted">
                        <span class="material-symbols-outlined text-[14px]">lock</span>
                        Tus datos de tarjeta viajan cifrados directamente al procesador de pagos. Nunca los almacenamos.
                    </p>
                </div>

                <!-- Términos y Consentimiento de Privacidad -->
                <div class="mt-5 pt-4 border-t border-border-subtle/50">
                    <label class="flex items-start gap-2.5 text-xs text-text-muted cursor-pointer">
                        <input type="checkbox" id="check-privacidad" required checked class="mt-0.5 rounded text-primary focus:ring-primary h-4 w-4" />
                        <span>
                            He leído y acepto la <a href="/Cuenta/Privacidad" target="_blank" class="font-semibold text-secondary hover:underline">Política de Privacidad y Tratamiento de Datos</a>.
                        </span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Summary (5 cols) -->
        <div class="lg:col-span-5">
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow sticky top-28">
                <h3 class="text-base font-bold text-primary mb-4 flex items-center justify-between">
                    <span>Resumen del pedido</span>
                    <span class="text-xs font-normal text-text-muted">@(Model.Items?.Count ?? 0) artículos</span>
                </h3>

                <!-- Items Scroll Container -->
                <div class="divide-y divide-border-subtle/40 max-h-72 overflow-y-auto pr-1 mb-5">
                    @if (Model.Items != null)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="py-3 flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined text-text-muted text-[22px]">inventory_2</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-xs font-semibold text-primary truncate">@item.Descripcion</div>
                                    <div class="text-[11px] text-text-muted">Cantidad: @item.Cantidad &bull; Q @item.PrecioUnitario.ToString("N2") c/u</div>
                                </div>
                                <div class="text-xs font-bold text-primary">
                                    Q @item.Subtotal.ToString("N2")
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Financial Breakdown -->
                <div class="space-y-2.5 pt-4 border-t border-border-subtle/50 text-xs">
                    <div class="flex justify-between text-text-muted">
                        <span>Subtotal</span>
                        <span>Q @subtotalNeto.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-text-muted">
                        <span>IVA (12%)</span>
                        <span>Q @iva.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-text-muted">
                        <span>Envío</span>
                        <span class="text-secondary font-semibold" id="costo-envio">Gratis</span>
                    </div>
                    <div class="flex justify-between text-base font-bold text-primary pt-3 border-t border-border-subtle/80">
                        <span>Total a pagar</span>
                        <span>Q @subtotal.ToString("N2")</span>
                    </div>
                </div>

                <!-- Submit Button: solo se habilita con una tarjeta validada (o con transferencia) -->
                <button type="button" id="btn-confirmar" disabled
                        onclick="confirmarPedido()"
                        class="w-full mt-6 bg-primary text-on-primary py-3.5 px-4 rounded-xl text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100">
                    <span class="material-symbols-outlined text-[20px]">lock</span>
                    <span id="btn-confirmar-texto">Confirmar y pagar</span>
                </button>
                <p id="confirmar-ayuda" class="mt-2 text-[11px] text-center text-text-muted">Valida tu tarjeta para continuar.</p>

                <div class="mt-4 text-center">
                    <a href="/Carrito" class="text-xs font-medium text-text-muted hover:text-primary transition-colors">
                        &larr; Volver al carrito
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Endpoint de tokenizacion de PayKlik. El navegador le envia la tarjeta directo:
    // el numero y el CVV nunca pasan por SgoLogic.Web ni por el gateway (RES-08).
    const URL_TOKENIZACION = 'http://localhost:8084/v1/tokens';
    const TIEMPO_ESPERA_TOKENIZACION_MS = 10000;

    // El token de PayKlik es de un solo uso y vence (VigenciaSegundos, 900 s por
    // defecto). Pagos lo consume al cobrar, unos segundos despues de confirmar,
    // asi que se da por vencido con este margen para no enviar uno a punto de expirar.
    const MARGEN_VENCIMIENTO_MS = 60000;

    // { token, marca, ultimosCuatro, venceLocalMs } o null si no hay tarjeta validada.
    let tarjetaValidada = null;

    // ── Toggle método de entrega ──────────────────────────────────────────────
    function toggleEntrega(valor) {
        const panelDomicilio = document.getElementById('panel-domicilio');
        const panelTienda    = document.getElementById('panel-tienda');
        const labelDomicilio = document.getElementById('label-domicilio');
        const labelTienda    = document.getElementById('label-tienda');

        if (valor === 'RECOGIDA_TIENDA') {
            panelDomicilio.classList.add('hidden');
            panelTienda.classList.remove('hidden');
            labelTienda.classList.add('border-primary');
            labelTienda.classList.remove('border-border-subtle/80');
            labelDomicilio.classList.remove('border-primary');
            labelDomicilio.classList.add('border-border-subtle/80');
        } else {
            panelDomicilio.classList.remove('hidden');
            panelTienda.classList.add('hidden');
            labelDomicilio.classList.add('border-primary');
            labelDomicilio.classList.remove('border-border-subtle/80');
            labelTienda.classList.remove('border-primary');
            labelTienda.classList.add('border-border-subtle/80');
        }
    }

    // ── Toggle panel de tarjeta segun metodo de pago ─────────────────────────
    function medioPagoSeleccionado() {
        return document.querySelector('input[name="medioPago"]:checked')?.value;
    }

    document.querySelectorAll('input[name="medioPago"]').forEach(radio => {
        radio.addEventListener('change', function () {
            document.getElementById('panel-tarjeta').classList.toggle('hidden', this.value !== 'TARJETA');
            actualizarBotonConfirmar();
        });
    });

    // ── Formateo automático y detección de marca ──────────────────────────────
    function formatearPan(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 16);
        let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
        input.value = formatted;

        const badge = document.getElementById('card-brand-badge');
        const marcas = {
            '4': ['VISA', 'bg-blue-100 text-blue-800'],
            '5': ['MASTERCARD', 'bg-amber-100 text-amber-800'],
            '3': ['AMEX', 'bg-teal-100 text-teal-800']
        };
        const marca = marcas[val.charAt(0)];
        if (marca) {
            badge.textContent = marca[0];
            badge.className = 'text-[11px] font-bold px-2 py-0.5 rounded ' + marca[1];
        } else {
            badge.className = 'hidden';
        }
    }

    function formatearExp(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 4);
        if (val.length >= 2) {
            input.value = val.substring(0, 2) + '/' + val.substring(2);
        } else {
            input.value = val;
        }
    }

    // ── Algoritmo de Luhn en cliente ──────────────────────────────────────────
    function validarLuhn(pan) {
        let sum = 0;
        let shouldDouble = false;
        for (let i = pan.length - 1; i >= 0; i--) {
            let digit = parseInt(pan.charAt(i), 10);
            if (shouldDouble) {
                digit *= 2;
                if (digit > 9) digit -= 9;
            }
            sum += digit;
            shouldDouble = !shouldDouble;
        }
        return (sum % 10) === 0;
    }

    // ── Mensajes y estado de los botones ──────────────────────────────────────
    function mostrarEstado(tipo, texto) {
        const statusEl = document.getElementById('tokenizacion-status');
        const colores = { error: 'text-error', info: 'text-text-muted', aviso: 'text-amber-800' };
        statusEl.textContent = texto;
        statusEl.className = 'text-xs font-semibold ' + (colores[tipo] ?? colores.info);
    }

    function ocultarEstado() {
        document.getElementById('tokenizacion-status').className = 'hidden';
    }

    function tokenVigente() {
        return tarjetaValidada !== null && Date.now() < tarjetaValidada.venceLocalMs - MARGEN_VENCIMIENTO_MS;
    }

    function actualizarBotonConfirmar() {
        const btn = document.getElementById('btn-confirmar');
        const ayuda = document.getElementById('confirmar-ayuda');
        const conTarjeta = medioPagoSeleccionado() === 'TARJETA';
        const habilitado = !conTarjeta || tokenVigente();

        btn.disabled = !habilitado;
        ayuda.classList.toggle('hidden', habilitado);
    }

    function mostrarCaptura() {
        document.getElementById('tarjeta-captura').classList.remove('hidden');
        document.getElementById('tarjeta-validada').classList.add('hidden');
    }

    // Descarta el token actual y vuelve al formulario de tarjeta.
    function descartarTarjetaValidada() {
        tarjetaValidada = null;
        document.getElementById('token-medio-pago').value = '';
        mostrarCaptura();
        actualizarBotonConfirmar();
    }

    function usarOtraTarjeta() {
        descartarTarjetaValidada();
        ocultarEstado();
        document.getElementById('pan-input').focus();
    }

    // Si el token vence mientras el cliente sigue en la pagina, se le pide validar de nuevo.
    setInterval(() => {
        if (tarjetaValidada !== null && !tokenVigente()) {
            descartarTarjetaValidada();
            mostrarEstado('aviso', 'La validación de tu tarjeta expiró por seguridad. Ingresa los datos y valídala de nuevo.');
        }
    }, 5000);

    // ── Paso 1: validar la tarjeta (tokenizar contra PayKlik) ─────────────────
    async function validarTarjeta() {
        const btn = document.getElementById('btn-validar');
        const btnTexto = document.getElementById('btn-validar-texto');

        const pan = document.getElementById('pan-input').value.replace(/\s/g, '');
        const cvv = document.getElementById('cvv-input').value;
        const exp = document.getElementById('exp-input').value; // formato MM/AA

        if (!pan || !cvv || !exp || !exp.includes('/')) {
            mostrarEstado('error', 'Completa el número de tarjeta, el vencimiento y el código de seguridad.');
            return;
        }

        if (pan.length < 13 || !validarLuhn(pan)) {
            mostrarEstado('error', 'El número de tarjeta no es válido. Revisa los dígitos.');
            return;
        }

        const [mesStr, anioStr] = exp.split('/');
        const mesExpiracion = parseInt(mesStr, 10);
        const anioExpiracion = parseInt(anioStr, 10);

        if (isNaN(mesExpiracion) || isNaN(anioExpiracion) || mesExpiracion < 1 || mesExpiracion > 12) {
            mostrarEstado('error', 'Revisa el vencimiento. Usa el formato MM/AA, por ejemplo 12/28.');
            return;
        }

        btn.disabled = true;
        btnTexto.textContent = 'Validando…';
        mostrarEstado('info', 'Validando tu tarjeta con el procesador de pagos…');

        const cancelador = new AbortController();
        const temporizador = setTimeout(() => cancelador.abort(), TIEMPO_ESPERA_TOKENIZACION_MS);

        try {
            let res;
            try {
                res = await fetch(URL_TOKENIZACION, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ numeroTarjeta: pan, cvv, mesExpiracion, anioExpiracion }),
                    signal: cancelador.signal
                });
            } catch {
                // Sin respuesta: el procesador esta caido, inalcanzable o tardo demasiado.
                throw new Error('PROVEEDOR_NO_DISPONIBLE');
            }

            if (res.status === 422) {
                const problema = await res.json().catch(() => ({}));
                const motivos = (problema.errores ?? []).map(e => e.motivo).filter(Boolean);
                mostrarEstado('error', 'La tarjeta no fue aceptada: ' + (motivos.join(' ') || 'revisa los datos e intenta de nuevo.'));
                return;
            }

            if (!res.ok) {
                throw new Error('PROVEEDOR_NO_DISPONIBLE');
            }

            const respuesta = await res.json();

            // La vigencia se toma en segundos desde ahora (no de VenceEn) para no
            // depender de que el reloj del navegador coincida con el del procesador.
            tarjetaValidada = {
                token: respuesta.token,
                marca: respuesta.marca,
                ultimosCuatro: respuesta.ultimosCuatro,
                venceLocalMs: Date.now() + (respuesta.vigenciaSegundos ?? 900) * 1000
            };
            document.getElementById('token-medio-pago').value = respuesta.token;

            // Con el token emitido, los datos de la tarjeta ya no hacen falta en la pagina.
            document.getElementById('pan-input').value = '';
            document.getElementById('cvv-input').value = '';
            document.getElementById('exp-input').value = '';
            document.getElementById('card-brand-badge').className = 'hidden';

            document.getElementById('validada-marca').textContent = respuesta.marca;
            document.getElementById('validada-ultimos').textContent = respuesta.ultimosCuatro;
            document.getElementById('tarjeta-captura').classList.add('hidden');
            document.getElementById('tarjeta-validada').classList.remove('hidden');
            ocultarEstado();
            actualizarBotonConfirmar();
        } catch (err) {
            console.error('Error validando la tarjeta:', err);
            mostrarEstado('error', 'No pudimos comunicarnos con el procesador de pagos. Tu carrito sigue guardado: intenta validar la tarjeta de nuevo en unos momentos.');
            btnTexto.textContent = 'Reintentar validación';
        } finally {
            clearTimeout(temporizador);
            btn.disabled = false;
            if (btnTexto.textContent === 'Validando…') {
                btnTexto.textContent = 'Validar tarjeta';
            }
        }
    }

    // ── Paso 2: confirmar el pedido con el token ya emitido ───────────────────
    function confirmarPedido() {
        const form = document.getElementById('checkout-form');

        if (!document.getElementById('check-privacidad').checked) {
            alert('Debes aceptar la política de privacidad y tratamiento de datos para continuar.');
            return;
        }

        if (medioPagoSeleccionado() === 'TARJETA') {
            if (!tokenVigente()) {
                descartarTarjetaValidada();
                mostrarEstado('aviso', 'La validación de tu tarjeta expiró por seguridad. Ingresa los datos y valídala de nuevo.');
                return;
            }
        } else {
            // Con transferencia no se envia ningun token.
            document.getElementById('token-medio-pago').value = '';
        }

        const btn = document.getElementById('btn-confirmar');
        btn.disabled = true;
        document.getElementById('btn-confirmar-texto').textContent = 'Procesando tu pedido…';
        form.submit();
    }

    actualizarBotonConfirmar();
</script>
