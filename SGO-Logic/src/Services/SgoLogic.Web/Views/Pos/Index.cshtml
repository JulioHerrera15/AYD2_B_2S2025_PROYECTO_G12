@model SgoLogic.Web.Services.CarritoModel?
@{
    ViewData["Title"] = "OmniPOS - Recuperación de Carrito Web";
    var subtotal = Model?.Items?.Sum(i => i.Subtotal) ?? 0m;
    var descuento = subtotal > 0 ? 150.00m : 0m;
    var subtotalConDescuento = Math.Max(0, subtotal - descuento);
    var iva = Math.Round(subtotalConDescuento * 0.12m / 1.12m, 2);
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header OmniPOS -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">point_of_sale</span>
                Terminal 01 &bull; Tienda Central Zona 10
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">OmniPOS — Recuperación de Carrito</h1>
            <p class="text-xs sm:text-sm text-text-muted">Recupera una sesión de compra iniciada en la web o app móvil para cerrarla presencialmente.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                Redis Sincronizado
            </span>
        </div>
    </div>

    <!-- Omnichannel Search Bar -->
    <div class="max-w-2xl mx-auto w-full">
        <form asp-action="Index" method="get" class="relative flex items-center bg-surface-white rounded-2xl border-2 border-border-subtle focus-within:border-secondary p-2 ambient-shadow transition-all">
            <span class="material-symbols-outlined text-text-muted ml-3 text-[22px]">search</span>
            <input type="text" name="busqueda" value="@ViewBag.Busqueda"
                   placeholder="Buscar carrito web por correo del cliente o ID..."
                   class="w-full px-3 py-2.5 text-sm bg-transparent border-none outline-none text-primary placeholder:text-text-muted" />
            <button type="submit"
                    class="bg-primary text-on-primary font-semibold text-xs px-5 py-2.5 rounded-xl hover:opacity-90 active:scale-95 transition-all">
                Buscar Carrito
            </button>
        </form>

        <div class="flex items-center justify-center gap-2 text-xs text-text-muted mt-2">
            <span>Búsqueda en tiempo real por correo del cliente o número de orden registrada</span>
        </div>
    </div>

    @if (ViewBag.ExitoBusqueda != null)
    {
        <div class="bg-emerald-50 text-emerald-800 border border-emerald-200 p-4 rounded-2xl flex items-center justify-center gap-2.5 text-sm font-medium ambient-shadow max-w-2xl mx-auto">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
            <span>@ViewBag.ExitoBusqueda</span>
        </div>
    }

    @if (ViewBag.Mensaje != null)
    {
        <div class="bg-surface-container-low text-on-surface-variant border border-border-subtle p-4 rounded-2xl flex items-center justify-center gap-2.5 text-sm ambient-shadow max-w-2xl mx-auto">
            <span class="material-symbols-outlined text-secondary text-[20px]">info</span>
            <span>@ViewBag.Mensaje</span>
        </div>
    }

    @if (ViewBag.OrdenEncontrada is SgoLogic.Web.Services.OrdenEstadoModel orden)
    {
        <div class="bg-surface-white rounded-3xl p-6 md:p-8 border border-border-subtle/80 ambient-shadow max-w-3xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-border-subtle/60 gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">receipt_long</span>
                    </div>
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Orden Consultada en POS</span>
                        <h3 class="text-lg font-bold text-primary tracking-tight">@orden.OrdenId</h3>
                    </div>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-primary border border-border-subtle/60 self-start sm:self-auto">
                    Estado: @orden.Estado
                </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs mb-6">
                <div class="bg-surface-container-low/50 p-3 rounded-xl">
                    <span class="text-text-muted block mb-0.5">Correlativo</span>
                    <span class="font-bold text-primary text-sm">@(orden.NumeroOrden ?? "N/A")</span>
                </div>
                <div class="bg-surface-container-low/50 p-3 rounded-xl">
                    <span class="text-text-muted block mb-0.5">Canal</span>
                    <span class="font-bold text-primary text-sm">@(orden.Canal ?? "WEB")</span>
                </div>
                <div class="bg-surface-container-low/50 p-3 rounded-xl">
                    <span class="text-text-muted block mb-0.5">Entrega</span>
                    <span class="font-bold text-primary text-sm">@(orden.MetodoEntrega ?? "DOMICILIO")</span>
                </div>
                <div class="bg-surface-container-low/50 p-3 rounded-xl">
                    <span class="text-text-muted block mb-0.5">Total</span>
                    <span class="font-bold text-primary text-sm">@(orden.Moneda ?? "GTQ") @(orden.Total?.ToString("N2") ?? "0.00")</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(orden.MotivoUltimoCambio))
            {
                <div class="mb-6 p-3.5 rounded-xl border @(orden.Estado == "RECHAZADA" ? "bg-error-container/60 border-error/30 text-on-error-container" : "bg-surface-container-low border-border-subtle text-primary") text-xs">
                    <strong>Motivo de Estado:</strong> @orden.MotivoUltimoCambio
                </div>
            }

            <div class="flex items-center justify-end gap-3">
                <a href="/Estado?ordenId=@orden.OrdenId" class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-full text-xs font-semibold hover:opacity-90 transition-all">
                    <span>Ver Trazabilidad Completa en Consulta de Estado</span>
                    <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
            </div>
        </div>
    }

    <!-- Content: Products & POS Summary -->
    @if (Model?.Items != null && Model.Items.Count > 0)
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left: Recovered Items (7 cols) -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-primary flex items-center gap-2">
                        <span>Artículos del Cliente</span>
                        <span class="text-xs font-semibold bg-surface-container-low px-2.5 py-0.5 rounded-full text-text-muted">
                            @Model.Items.Count items
                        </span>
                    </h2>
                    <span class="text-xs text-secondary font-medium flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">cloud_done</span>
                        Recuperado desde Redis
                    </span>
                </div>

                <div class="space-y-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle/60 ambient-shadow flex items-center gap-4 hover:border-primary/30 transition-colors">
                            <div class="w-16 h-16 rounded-xl bg-surface-container-low flex items-center justify-center flex-shrink-0 text-text-muted">
                                <span class="material-symbols-outlined text-[28px]">devices</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-2 mb-1">
                                    <h3 class="text-sm font-bold text-primary truncate">@item.Descripcion</h3>
                                    <span class="text-sm font-bold text-primary">Q @item.Subtotal.ToString("N2")</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-text-muted">
                                    <span class="font-mono bg-surface-container-low px-2 py-0.5 rounded text-[11px]">@item.Sku</span>
                                    <span>Cantidad: <strong class="text-primary font-semibold">@item.Cantidad</strong></span>
                                    <span>&bull;</span>
                                    <span>Q @item.PrecioUnitario.ToString("N2") c/u</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Client Identification Notice -->
                <div class="bg-surface-container-low/70 rounded-2xl p-4 border border-border-subtle/50 flex items-center gap-3">
                    <span class="material-symbols-outlined text-secondary text-[24px]">verified</span>
                    <div class="text-xs">
                        <span class="font-semibold text-primary block">Identidad Omnicanal Verificada</span>
                        <span class="text-text-muted">Sesión asociada al cliente: <code class="font-mono text-primary">@(ViewBag.Busqueda ?? "Sesión Activa")</code></span>
                    </div>
                </div>
            </div>

            <!-- Right: POS Action Panel (5 cols) -->
            <div class="lg:col-span-5">
                <div class="bg-surface-white rounded-2xl p-6 border border-border-subtle/60 ambient-shadow sticky top-28">
                    <!-- Badge status -->
                    <div class="flex items-center justify-between pb-4 border-b border-border-subtle/40 mb-4">
                        <div class="text-xs font-semibold text-text-muted uppercase tracking-wider">Resumen de Venta POS</div>
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            Sincronizado en Redis
                        </span>
                    </div>

                    <!-- Financial breakdown -->
                    <div class="space-y-2.5 text-xs mb-6">
                        <div class="flex justify-between text-text-muted">
                            <span>Subtotal Catálogo</span>
                            <span class="font-medium text-primary">Q @subtotal.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-green-700">
                            <span>Descuento Omnicanal (POS)</span>
                            <span class="font-medium">- Q @descuento.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-text-muted">
                            <span>IVA (12% incluido)</span>
                            <span>Q @iva.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-base font-bold text-primary pt-3 border-t border-border-subtle/80">
                            <span>Total a Cobrar</span>
                            <span>Q @subtotalConDescuento.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Payment processing form -->
                    <form asp-action="Cobrar" method="post" class="space-y-4">
                        <input type="hidden" name="clienteId" value="@(ViewBag.Busqueda ?? "")" />

                        <div>
                            <label class="block text-xs font-semibold text-primary mb-1.5">Sucursal / Terminal POS</label>
                            <select name="tiendaId" class="w-full bg-surface-container-low border border-border-subtle/80 rounded-xl px-3 py-2 text-xs font-medium text-primary focus:outline-none focus:ring-2 focus:ring-secondary">
                                <option value="TIENDA-01-CENTRAL" selected>MegaStore Central — Zona 10 (POS T01)</option>
                                <option value="TIENDA-02-MIRAFLORES">MegaStore Miraflores — Zona 11 (POS T02)</option>
                                <option value="TIENDA-03-PORTALES">MegaStore Portales — Zona 17 (POS T03)</option>
                                <option value="TIENDA-04-PRADERA">MegaStore Pradera Concepción (POS T04)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-primary mb-2">Método de Cobro en Caja</label>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <label class="flex items-center gap-2 p-3 rounded-xl border border-border-subtle bg-surface-container-low/40 cursor-pointer hover:bg-surface-container-low transition-colors">
                                    <input type="radio" name="medioPago" value="EFECTIVO" checked class="text-primary focus:ring-primary h-3.5 w-3.5" />
                                    <span class="font-semibold text-primary">Efectivo</span>
                                </label>
                                <label class="flex items-center gap-2 p-3 rounded-xl border border-border-subtle bg-surface-container-low/40 cursor-pointer hover:bg-surface-container-low transition-colors">
                                    <input type="radio" name="medioPago" value="TARJETA_CREDITO_DEBITO" class="text-primary focus:ring-primary h-3.5 w-3.5" />
                                    <span class="font-semibold text-primary">Tarjeta POS</span>
                                </label>
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full bg-primary text-on-primary py-3 px-4 rounded-xl text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition-all shadow-sm flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[19px]">point_of_sale</span>
                            Completar Venta en Tienda (POS)
                        </button>
                    </form>

                    <!-- Enlace de pago alternativo omnicanal -->
                    <form asp-action="EnviarLinkPago" method="post" class="mt-3">
                        <input type="hidden" name="clienteId" value="@(ViewBag.Busqueda ?? "")" />
                        <button type="submit"
                                class="w-full bg-surface-container-low text-primary py-2.5 px-4 rounded-xl text-xs font-semibold hover:bg-surface-variant transition-colors border border-border-subtle/60 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[17px]">sms</span>
                            Enviar Enlace de Pago por SMS / WhatsApp
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty / Search State -->
        <div class="bg-surface-white rounded-3xl p-12 border border-border-subtle/60 text-center ambient-shadow max-w-xl mx-auto">
            <div class="w-16 h-16 rounded-full bg-surface-container-low text-text-muted flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-3xl">shopping_cart_checkout</span>
            </div>
            <h3 class="text-base font-bold text-primary mb-1">Ningún Carrito Seleccionado</h3>
            <p class="text-xs text-text-muted max-w-sm mx-auto mb-6">
                Ingresa el correo o NIT del cliente arriba para recuperar su carrito iniciado en la tienda online o app móvil.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
                <a href="/Catalogo" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-primary text-on-primary hover:opacity-90 transition-opacity">
                    Ver Catálogo Comercial &rarr;
                </a>
            </div>
        </div>
    }
</div>
