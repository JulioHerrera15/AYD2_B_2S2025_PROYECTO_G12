@{
    ViewData["Title"] = "Centro de Control & Topología de Arquitectura";
    var servicios = ViewBag.Servicios as List<SgoLogic.Web.Controllers.ServicioHealthStatus> ?? new();
    var tarjetas = ViewBag.Tarjetas as List<SgoLogic.Web.Controllers.TarjetaPrueba> ?? new();
    var jwtToken = ViewBag.JwtToken as string;
    var jwtSubject = ViewBag.JwtSubject as string;
    var jwtEmail = ViewBag.JwtEmail as string;
    var jwtExp = ViewBag.JwtExp as DateTime?;
    var tokenValido = (bool)(ViewBag.TokenValido ?? false);
    var exigirJwt = ViewBag.ExigirJwt as string ?? "false";
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">hub</span>
                Topología Distribuida &bull; Observabilidad Integral
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Centro de Control & Monitoreo del Sistema</h1>
            <p class="text-xs sm:text-sm text-text-muted">Supervisión en vivo de microservicios, autenticación en el borde (ADR-020) y pruebas de pago (RES-08).</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                @servicios.Count Microservicios Operativos
            </span>
        </div>
    </div>

    <!-- ADR-020 Border Authentication Inspector Card -->
    <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-border-subtle/60 ambient-shadow">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-6 border-b border-border-subtle">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[22px]">vpn_key</span>
                </div>
                <div>
                    <h2 class="text-base font-bold text-primary">Autenticación en el Borde (ADR-020)</h2>
                    <p class="text-xs text-text-muted">Inspección de tokens Bearer validados en el YARP API Gateway</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="text-xs text-text-muted">Bandera Gateway:ExigirJwt:</span>
                <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold @(exigirJwt.Contains("true") ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-blue-100 text-blue-800 border border-blue-300")">
                    @exigirJwt
                </span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(jwtToken))
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-2 space-y-4 text-xs">
                    <div class="p-4 rounded-2xl bg-surface-container-low/60 border border-border-subtle/50 font-mono text-[11px] break-all">
                        <span class="text-text-muted block mb-1 font-sans text-xs font-semibold uppercase">Token Bearer Actual (Cookie sgo_jwt):</span>
                        <span class="text-secondary select-all">@jwtToken</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="p-3 rounded-xl bg-surface-container-low/40 border border-border-subtle/40">
                            <span class="text-text-muted block text-[11px] mb-0.5">Subject (ID):</span>
                            <span class="font-bold text-primary truncate block">@(jwtSubject ?? "N/A")</span>
                        </div>
                        <div class="p-3 rounded-xl bg-surface-container-low/40 border border-border-subtle/40">
                            <span class="text-text-muted block text-[11px] mb-0.5">Email Reclamado:</span>
                            <span class="font-bold text-primary truncate block">@(jwtEmail ?? "N/A")</span>
                        </div>
                        <div class="p-3 rounded-xl bg-surface-container-low/40 border border-border-subtle/40">
                            <span class="text-text-muted block text-[11px] mb-0.5">Expiración (UTC):</span>
                            <span class="font-bold text-primary block">@(jwtExp?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-1 flex flex-col items-center justify-center p-6 rounded-2xl bg-surface-container-low/30 border border-border-subtle/40 text-center">
                    <div class="w-14 h-14 rounded-2xl @(tokenValido ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800") flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-[28px]">@(tokenValido ? "verified_user" : "gpp_bad")</span>
                    </div>
                    <span class="text-xs font-bold @(tokenValido ? "text-emerald-700" : "text-rose-700") mb-1">
                        @(tokenValido ? "TOKEN VÁLIDO Y VIGENTE" : "TOKEN EXPIRADO")
                    </span>
                    <p class="text-[11px] text-text-muted leading-tight">
                        @(tokenValido ? "El Gateway YARP autorizará peticiones a /api/ordenes, /api/pagos, /api/inventario y /api/despacho." : "Requiere renovar sesión.")
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="p-6 rounded-2xl bg-surface-container-low/50 border border-border-subtle/50 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-amber-600 text-[28px]">info</span>
                    <div>
                        <h4 class="font-bold text-sm text-primary">No hay token JWT en esta sesión de navegador</h4>
                        <p class="text-xs text-text-muted">Actualmente estás navegando de forma anónima. Inicia sesión para activar la cabecera Bearer.</p>
                    </div>
                </div>
                <a href="/Auth/Login" class="shrink-0 bg-primary text-on-primary px-4 py-2 rounded-xl text-xs font-semibold hover:opacity-90 transition-opacity">
                    Iniciar Sesión
                </a>
            </div>
        }
    </div>

    <!-- Microservices Topolgy Grid -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-lg font-bold text-primary tracking-tight">Topología de Microservicios</h2>
                <p class="text-xs text-text-muted">Ecosistema distribuido bajo arquitectura orientada a eventos y CQRS</p>
            </div>
            <span class="text-xs text-text-muted font-mono">11 Componentes Registrados</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var s in servicios)
            {
                <div class="bg-surface-white p-5 rounded-3xl border border-border-subtle/60 ambient-shadow hover:border-secondary transition-colors flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-bold text-sm text-primary font-mono">@s.Nombre</span>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                @s.Estado
                            </span>
                        </div>
                        <div class="text-xs font-semibold text-secondary mb-2">@s.Rol</div>
                        <p class="text-xs text-text-muted leading-relaxed mb-4">@s.Descripcion</p>
                    </div>
                    <div class="pt-3 border-t border-border-subtle flex items-center justify-between text-[11px] text-text-muted font-mono">
                        <span>Endpoint:</span>
                        <strong class="text-primary">@s.Endpoint</strong>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- PayKlik Test Sandbox Library (RES-08 / ADR-010) -->
    <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-border-subtle/60 ambient-shadow">
        <div class="flex items-center gap-3 pb-4 mb-6 border-b border-border-subtle">
            <div class="w-10 h-10 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[22px]">credit_card</span>
            </div>
            <div>
                <h2 class="text-base font-bold text-primary">Laboratorio de Pruebas de Medios de Pago PayKlik (RES-08)</h2>
                <p class="text-xs text-text-muted">Tarjetas de prueba simuladas en la pasarela externa <code class="bg-surface-container-low px-1 rounded font-mono">http://localhost:8084</code></p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/60 text-text-muted uppercase tracking-wider font-semibold border-b border-border-subtle/70">
                        <th class="py-3 px-4">Franquicia</th>
                        <th class="py-3 px-4">Número de Tarjeta</th>
                        <th class="py-3 px-4">Vencimiento</th>
                        <th class="py-3 px-4">CVV</th>
                        <th class="py-3 px-4">Titular</th>
                        <th class="py-3 px-4">Escenario</th>
                        <th class="py-3 px-4">Resultado Esperado</th>
                        <th class="py-3 px-4 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle/50">
                    @foreach (var t in tarjetas)
                    {
                        <tr class="hover:bg-surface-container-low/30 transition-colors">
                            <td class="py-3 px-4 font-semibold text-primary">
                                @t.Franquicia
                            </td>
                            <td class="py-3 px-4 font-mono font-bold text-primary">
                                @t.Numero
                            </td>
                            <td class="py-3 px-4 font-mono text-text-muted">
                                @t.Vencimiento
                            </td>
                            <td class="py-3 px-4 font-mono text-text-muted">
                                @t.Cvv
                            </td>
                            <td class="py-3 px-4 text-text-muted">
                                @t.Titular
                            </td>
                            <td class="py-3 px-4">
                                <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold border @t.ColorBadge">
                                    @t.Escenario
                                </span>
                            </td>
                            <td class="py-3 px-4 text-text-muted text-[11px] max-w-xs">
                                @t.ResultadoEsperado
                            </td>
                            <td class="py-3 px-4 text-right">
                                <button type="button" 
                                        onclick="copiarTarjeta('@t.Numero', '@t.Vencimiento', '@t.Cvv', '@t.Titular')"
                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-surface-container-low hover:bg-surface-variant text-primary text-[11px] font-semibold transition-all">
                                    <span class="material-symbols-outlined text-[13px]">content_copy</span>
                                    Copiar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function copiarTarjeta(numero, vencimiento, cvv, titular) {
        const texto = `Tarjeta: ${numero} | Exp: ${vencimiento} | CVV: ${cvv} | Titular: ${titular}`;
        navigator.clipboard.writeText(numero).then(() => {
            alert('Número de tarjeta copiado al portapapeles: ' + numero);
        });
    }
</script>
