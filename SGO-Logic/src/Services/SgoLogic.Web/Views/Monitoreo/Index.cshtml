@{
    ViewData["Title"] = "Centro de Control y Monitoreo del Sistema";
    var servicios = ViewBag.Servicios as List<SgoLogic.Web.Controllers.ServicioHealthStatus> ?? new();
    var userEmail = ViewBag.UserEmail as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "OPERADOR";
    var jwtExp = ViewBag.JwtExp as DateTime?;
    var tokenValido = (bool)(ViewBag.TokenValido ?? false);
    var exigirJwt = ViewBag.ExigirJwt as string ?? "Modo Permisivo";
    var totalEnLinea = ViewBag.TotalEnLinea as int? ?? 0;
    var totalServicios = ViewBag.TotalServicios as int? ?? servicios.Count;
    var latenciaPromedio = ViewBag.LatenciaPromedio != null ? Convert.ToDouble(ViewBag.LatenciaPromedio).ToString("F1") : "0.0";
    var ultimaActualizacion = ViewBag.UltimaActualizacion as DateTime? ?? DateTime.UtcNow;
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header with Live Metric Badges -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">hub</span>
                Observabilidad en Tiempo Real &bull; Ecosistema MegaStore
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Centro de Control y Monitoreo</h1>
            <p class="text-xs sm:text-sm text-text-muted">Supervisión en vivo de microservicios, seguridad perimetral y salud de la plataforma distribuida.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <span id="badge-total-en-linea" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-1.5 rounded-full @(totalEnLinea == totalServicios ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-amber-100 text-amber-800 border border-amber-300")">
                <span class="w-2 h-2 rounded-full @(totalEnLinea == totalServicios ? "bg-emerald-500" : "bg-amber-500") animate-pulse"></span>
                <span id="txt-en-linea">@totalEnLinea / @totalServicios Microservicios Operativos</span>
            </span>

            <button type="button" id="btn-refrescar-estado" onclick="actualizarEstadoEnVivo()"
                    class="inline-flex items-center gap-1.5 bg-surface-white hover:bg-surface-container-low border border-border-subtle text-primary px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all shadow-sm active:scale-95">
                <span class="material-symbols-outlined text-[16px] text-secondary" id="icon-refresh">sync</span>
                <span>Actualizar en Vivo</span>
            </button>
        </div>
    </div>

    <!-- Live System Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Disponibilidad del Clúster</div>
            <div class="text-2xl font-black text-emerald-700" id="card-porcentaje-disponibilidad">
                @(totalServicios > 0 ? ((totalEnLinea * 100) / totalServicios).ToString() : "100")%
            </div>
            <div class="text-[10px] text-text-muted mt-1">Servicios respondiendo /health/live</div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Latencia Media Interna</div>
            <div class="text-2xl font-black text-primary" id="card-latencia-promedio">
                @latenciaPromedio ms
            </div>
            <div class="text-[10px] text-text-muted mt-1">Tiempo de respuesta HTTP local</div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Seguridad del Gateway</div>
            <div class="text-sm font-bold text-primary truncate mt-1">
                @exigirJwt
            </div>
            <div class="text-[10px] text-text-muted mt-1">Validación de firmas Bearer</div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Último Sondeo</div>
            <div class="text-xs font-mono font-bold text-primary truncate mt-1" id="card-ultima-actualizacion">
                @ultimaActualizacion.ToString("HH:mm:ss UTC")
            </div>
            <div class="text-[10px] text-text-muted mt-1">Comprobación concurrente activa</div>
        </div>
    </div>

    <!-- Active Session & Perimeter Security Card (WITHOUT printing raw JWT tokens) -->
    <div class="bg-surface-white rounded-3xl p-6 sm:p-7 border border-border-subtle/70 ambient-shadow">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-border-subtle/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
                </div>
                <div>
                    <h2 class="text-base font-bold text-primary">Estado de Seguridad del Perímetro</h2>
                    <p class="text-xs text-text-muted">Credenciales de sesión y validación de acceso en el API Gateway</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold @(tokenValido ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-amber-100 text-amber-800 border border-amber-300")">
                    <span class="material-symbols-outlined text-[16px]">@(tokenValido ? "verified" : "schedule")</span>
                    <span>@(tokenValido ? "Sesión Activa y Verificada" : "Sesión Pendiente de Renovación")</span>
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-5">
            <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-border-subtle/50">
                <span class="text-[10px] uppercase tracking-wider font-bold text-text-muted block mb-0.5">Operador / Administrador</span>
                <span class="font-bold text-xs text-primary truncate block font-mono">@userEmail</span>
            </div>

            <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-border-subtle/50">
                <span class="text-[10px] uppercase tracking-wider font-bold text-text-muted block mb-0.5">Rol de Autorización</span>
                <span class="font-bold text-xs text-primary block">@userRole</span>
            </div>

            <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-border-subtle/50">
                <span class="text-[10px] uppercase tracking-wider font-bold text-text-muted block mb-0.5">Vigencia de Sesión</span>
                <span class="font-bold text-xs text-primary block">
                    @(jwtExp?.ToString("dd/MM/yyyy HH:mm:ss UTC") ?? "Activa")
                </span>
            </div>
        </div>
    </div>

    <!-- Live Microservices Topology Grid -->
    <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
                <h2 class="text-lg font-bold text-primary tracking-tight">Topología de Microservicios en Vivo</h2>
                <p class="text-xs text-text-muted">Estado operativo real, latencias en milisegundos y endpoints de salud</p>
            </div>
            <span class="text-xs text-text-muted font-mono" id="txt-contador-servicios">@servicios.Count componentes supervisados</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-servicios">
            @foreach (var s in servicios)
            {
                <div class="bg-surface-white p-5 rounded-3xl border border-border-subtle/70 ambient-shadow hover:border-secondary transition-all flex flex-col justify-between"
                     data-servicio-card="@s.Nombre">
                    <div>
                        <!-- Header with Name, Badge and Latency -->
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-bold text-sm text-primary font-mono">@s.Nombre</span>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold @(s.EstaEnLinea ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-rose-100 text-rose-800 border border-rose-300")"
                                  data-status-badge="@s.Nombre">
                                <span class="w-1.5 h-1.5 rounded-full @(s.EstaEnLinea ? "bg-emerald-500 animate-pulse" : "bg-rose-500")"></span>
                                <span data-status-text="@s.Nombre">@s.Estado</span>
                            </span>
                        </div>

                        <!-- Category & Role -->
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <span class="text-[11px] font-semibold text-secondary">@s.Rol</span>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface-container-low text-text-muted font-bold" data-latency="@s.Nombre">
                                @s.LatenciaMs ms
                            </span>
                        </div>

                        <p class="text-xs text-text-muted leading-relaxed mb-4">@s.Descripcion</p>
                    </div>

                    <!-- Footer: Public Port & Endpoint -->
                    <div class="pt-3 border-t border-border-subtle/60 flex items-center justify-between text-[11px] text-text-muted font-mono">
                        <span>Puerto: <strong class="text-primary">@s.PuertoPublico</strong></span>
                        <span class="truncate max-w-[140px]" title="@s.Endpoint">@s.Endpoint.Replace("http://", "").Replace("/health/live", "")</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Directrices de Seguridad, Resiliencia y Auditoría -->
    <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-border-subtle/60 ambient-shadow">
        <div class="flex items-center gap-3 pb-4 mb-6 border-b border-border-subtle">
            <div class="w-10 h-10 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[22px]">verified_user</span>
            </div>
            <div>
                <h2 class="text-base font-bold text-primary">Gobernanza y Resiliencia del Ecosistema</h2>
                <p class="text-xs text-text-muted">Estrategias operativas de tolerancia a fallos, consistencia y trazabilidad</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-3 text-secondary">
                        <span class="material-symbols-outlined text-[20px]">shield_person</span>
                        <h3 class="font-bold text-sm text-primary">Autenticación Perimetral</h3>
                    </div>
                    <p class="text-xs text-text-muted leading-relaxed mb-4">
                        El API Gateway centraliza la validación de credenciales en rutas protegidas. Si un cliente no está autenticado, la solicitud es rechazada en el borde protegiendo la red de microservicios internos.
                    </p>
                </div>
                <div class="text-[11px] font-mono text-text-muted bg-surface-white p-2.5 rounded-xl border border-border-subtle">
                    Seguridad: <strong class="text-primary">Validación en Borde</strong>
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-3 text-secondary">
                        <span class="material-symbols-outlined text-[20px]">lock_reset</span>
                        <h3 class="font-bold text-sm text-primary">Bitácora Inmutable</h3>
                    </div>
                    <p class="text-xs text-text-muted leading-relaxed mb-4">
                        Registro transaccional append-only en PostgreSQL. Los eventos de dominio, confirmaciones de pago y cancelaciones se registran mediante triggers inmutables sin posibilidad de borrado ni alteración.
                    </p>
                </div>
                <div class="text-[11px] font-mono text-text-muted bg-surface-white p-2.5 rounded-xl border border-border-subtle">
                    Auditoría: <strong class="text-emerald-700">Persistencia Append-Only</strong>
                </div>
            </div>

            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-3 text-secondary">
                        <span class="material-symbols-outlined text-[20px]">schema</span>
                        <h3 class="font-bold text-sm text-primary">Orquestación de Sagas</h3>
                    </div>
                    <p class="text-xs text-text-muted leading-relaxed mb-4">
                        Coordinación asíncrona mediante RabbitMQ Topic Exchange. Transiciones garantizadas entre reserva de existencias, cobro y despacho con compensaciones automáticas en caso de fallo.
                    </p>
                </div>
                <div class="text-[11px] font-mono text-text-muted bg-surface-white p-2.5 rounded-xl border border-border-subtle">
                    Mensajería: <strong class="text-primary">RabbitMQ Event-Driven</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function actualizarEstadoEnVivo() {
        const btn = document.getElementById('btn-refrescar-estado');
        const icon = document.getElementById('icon-refresh');
        if (btn) btn.disabled = true;
        if (icon) icon.classList.add('animate-spin');

        try {
            const res = await fetch('/api/monitoreo/estado');
            if (!res.ok) throw new Error('Error al consultar estado');
            const data = await res.json();

            // Actualizar resumen superior
            const txtEnLinea = document.getElementById('txt-en-linea');
            if (txtEnLinea) {
                txtEnLinea.textContent = `${data.totalEnLinea} / ${data.totalServicios} Microservicios Operativos`;
            }

            const badgeTotal = document.getElementById('badge-total-en-linea');
            if (badgeTotal) {
                if (data.totalEnLinea === data.totalServicios) {
                    badgeTotal.className = 'inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300';
                } else {
                    badgeTotal.className = 'inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300';
                }
            }

            const cardPorcentaje = document.getElementById('card-porcentaje-disponibilidad');
            if (cardPorcentaje && data.totalServicios > 0) {
                cardPorcentaje.textContent = `${Math.round((data.totalEnLinea * 100) / data.totalServicios)}%`;
            }

            const cardLatencia = document.getElementById('card-latencia-promedio');
            if (cardLatencia) {
                cardLatencia.textContent = `${data.latenciaPromedio} ms`;
            }

            const cardActualizacion = document.getElementById('card-ultima-actualizacion');
            if (cardActualizacion) {
                const now = new Date();
                cardActualizacion.textContent = now.toTimeString().split(' ')[0] + ' Local';
            }

            // Actualizar cada tarjeta individual
            if (data.servicios && Array.isArray(data.servicios)) {
                data.servicios.forEach(s => {
                    const badge = document.querySelector(`[data-status-badge="${s.nombre}"]`);
                    const text = document.querySelector(`[data-status-text="${s.nombre}"]`);
                    const lat = document.querySelector(`[data-latency="${s.nombre}"]`);

                    if (badge && text) {
                        if (s.estaEnLinea) {
                            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
                            text.textContent = 'OPERATIVO';
                        } else {
                            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300';
                            text.textContent = 'NO DISPONIBLE';
                        }
                    }

                    if (lat) {
                        lat.textContent = `${s.latenciaMs} ms`;
                    }
                });
            }
        } catch (e) {
            console.error('[Monitoreo] Error al refrescar en vivo:', e);
        } finally {
            if (btn) btn.disabled = false;
            if (icon) icon.classList.remove('animate-spin');
        }
    }

    // Auto-refrescar cada 30 segundos
    setInterval(actualizarEstadoEnVivo, 30000);
</script>
