@using SgoLogic.Web.Services
@{
    ViewData["Title"] = "Centro de Control";
    var isAuthenticated = !string.IsNullOrWhiteSpace(Context.Request.Cookies["sgo_jwt"]);
    var userName = Context.Request.Cookies["sgo_user_name"];
    var userEmail = Context.Request.Cookies["sgo_user_email"];
    var userRole = Context.Request.Cookies["sgo_user_role"] ?? "CLIENTE";
    var isStaff = PermisosHelper.EsPersonalAutorizado(userRole, userEmail, Context.Request.Cookies["sgo_jwt"]);
}

<!-- Hero Section -->
<div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-4 ambient-shadow">
        <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">bolt</span>
        SGO-Logic MegaStore Omnicanal &bull; Ecosistema Completo
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-primary tracking-tight mb-4">
        Centro de Control Logístico y Comercio Omnicanal
    </h1>
    <p class="text-base sm:text-lg text-text-muted max-w-3xl leading-relaxed mb-8">
        Plataforma distribuida de alto rendimiento (.NET 8, Redis, PostgreSQL y RabbitMQ) que integra identidad unificada, sincronización cross-canal de carritos, recuperación en POS, despacho con transportistas y trazabilidad CQRS con respuesta garantizada.
    </p>

    <div class="flex flex-wrap items-center gap-3">
        <a href="/Catalogo" class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-2.5 rounded-full font-medium text-sm hover:opacity-90 transition-opacity shadow-sm active:scale-95 duration-150">
            <span class="material-symbols-outlined text-[18px]">storefront</span>
            Explorar Catálogo
        </a>
        <a href="/Carrito" class="inline-flex items-center gap-2 bg-secondary text-white px-5 py-2.5 rounded-full font-medium text-sm hover:bg-secondary/90 transition-colors shadow-sm active:scale-95 duration-150">
            <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
            Ver Carrito
        </a>
        <a href="/Estado" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
            <span class="material-symbols-outlined text-[18px]">track_changes</span>
            Rastrear Pedido
        </a>
        @if (isStaff)
        {
            <a href="/Pos" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
                Terminal OmniPOS
            </a>
            <a href="/Monitoreo" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">hub</span>
                Centro de Monitoreo
            </a>
        }
        else if (isAuthenticated)
        {
            <a href="/Cuenta/Ordenes" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                Mis Pedidos
            </a>
            <a href="/Cuenta/Perfil" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">account_circle</span>
                Mi Perfil
            </a>
        }
        else
        {
            <a href="/Auth/Login" class="inline-flex items-center gap-2 bg-surface-container-low text-primary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">login</span>
                Iniciar Sesión
            </a>
            <a href="/Auth/Registro" class="inline-flex items-center gap-2 bg-surface-container-low text-secondary px-5 py-2.5 rounded-full font-medium text-sm hover:bg-surface-variant transition-colors active:scale-95 duration-150 border border-border-subtle/50">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Registrarse
            </a>
        }
    </div>
</div>

<!-- Bento Grid: Core Commercial Capabilities -->
<div class="mb-4 flex items-center justify-between pb-2 border-b border-border-subtle">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-text-muted">
        <span class="material-symbols-outlined text-[18px] text-secondary">store</span>
        Portal Comercial & Atención al Cliente
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
    <!-- Card 1: Catálogo Comercial -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">storefront</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Catálogo Comercial Omnicanal</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Consulta de productos con existencias en vivo de las 32 tiendas físicas y 2 centros de distribución, optimizado sin bloqueos.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="/Catalogo" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                Explorar catálogo <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Stock en Tiempo Real</span>
        </div>
    </div>

    <!-- Card 2: Unified Cart in Redis -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">shopping_bag</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Carrito Unificado</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Sincronización multidispositivo en tiempo real con guardado automático y recuperación fluida al iniciar sesión.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="/Carrito" class="text-xs font-semibold text-secondary hover:underline inline-flex items-center gap-1 transition-colors">
                Ver carrito <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Persistencia Cloud</span>
        </div>
    </div>

    <!-- Card 3: Checkout Omnicanal -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">credit_card</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Checkout & Órdenes</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Entrega a domicilio o Click & Collect en tiendas físicas, facturación fiscal SAT FEL y confirmación inmediata con pasarela tokenizada.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="/Checkout" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                Ir a pagar <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Pago Seguro PayKlik</span>
        </div>
    </div>

    <!-- Card 4: Trazabilidad CQRS -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">track_changes</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Rastreo & Estado de Pedidos</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Consulta en caliente con actualización inmediata de eventos logísticos, número de guía y confirmación de entrega.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="/Estado" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                Rastrear orden <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Trazabilidad en Vivo</span>
        </div>
    </div>

    <!-- Card 5: Identidad & Acceso -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">badge</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Identidad & Acceso Seguro</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Protección de credenciales con hash criptográfico BCrypt, verificación segura en dos pasos mediante código numérico y tokens de sesión protegidos.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="@(isAuthenticated ? "/Cuenta/Perfil" : "/Auth/Login")" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                @(isAuthenticated ? "Mi perfil" : "Iniciar sesión") <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Identidad Cifrada</span>
        </div>
    </div>

    <!-- Card 6: Privacidad & Cumplimiento -->
    <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
        <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[26px]">shield_person</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Privacidad & Datos</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Centro de derechos ARCO, descarga estructurada de datos (JSON), política de derecho al olvido y resguardo de datos personales.
            </p>
        </div>
        <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
            <a href="/Cuenta/Privacidad" class="text-xs font-semibold text-secondary hover:underline inline-flex items-center gap-1 transition-colors">
                Gestionar privacidad <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
            <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Protección de Datos</span>
        </div>
    </div>
</div>

@if (isStaff)
{
    <!-- Bento Grid: Internal Staff & Operational Tools (Only visible to authorized staff/admin) -->
    <div class="mb-4 flex items-center justify-between pb-2 border-b border-border-subtle">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-secondary">
            <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
            Herramientas Operativas Internas (Personal & Administradores)
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <!-- Card: OmniPOS Terminal -->
        <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-900 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-[26px]">point_of_sale</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">OmniPOS (Tienda Física)</h3>
                <p class="text-xs text-text-muted leading-relaxed mb-6">
                    Recuperación en mostrador de carritos iniciados en la web o app móvil mediante correo o NIT. Cobro presencial en caja física.
                </p>
            </div>
            <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
                <a href="/Pos" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                    Abrir Terminal POS <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
                <span class="text-[11px] font-mono text-text-muted bg-surface-container-low px-2 py-0.5 rounded">POS Central</span>
            </div>
        </div>

        <!-- Card: Visión 360 & Soporte -->
        <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-900 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-[26px]">support_agent</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">Visión 360 del Cliente</h3>
                <p class="text-xs text-text-muted leading-relaxed mb-6">
                    Historial completo de compras, métricas consolidadas (LTV, pedidos), carritos en caliente e incidencias post-venta.
                </p>
            </div>
            <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
                <a href="/Vision360" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                    Atención 360° <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
                <span class="text-[11px] font-mono text-text-muted bg-surface-container-low px-2 py-0.5 rounded">Soporte 360</span>
            </div>
        </div>

        <!-- Card: Despacho Logístico -->
        <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-900 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-[26px]">local_shipping</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">Despacho & LogiExpress</h3>
                <p class="text-xs text-text-muted leading-relaxed mb-6">
                    Centro de control de preparación en Centro de Distribución, guías de transporte con LogiExpress y entregas en tienda.
                </p>
            </div>
            <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
                <a href="/Despacho" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                    Control logístico <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
                <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Bodega & Logística</span>
            </div>
        </div>

        <!-- Card: Incidencias & Post-Venta -->
        <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-[26px]">gavel</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">Incidencias & Post-Venta</h3>
                <p class="text-xs text-text-muted leading-relaxed mb-6">
                    Bandeja operativa para gestión de incidencias reportadas, dictámenes de resolución y trazabilidad para auditoría.
                </p>
            </div>
            <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
                <a href="/Incidencias" class="text-xs font-semibold text-primary hover:text-secondary inline-flex items-center gap-1 transition-colors">
                    Ver incidencias <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
                <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Atención Post-Venta</span>
            </div>
        </div>

        <!-- Card: Monitoreo & Topología -->
        <div class="bg-surface-white rounded-3xl p-7 border border-border-subtle/50 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md">
            <div>
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-800 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-[26px]">hub</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">Consola de Control del Ecosistema</h3>
                <p class="text-xs text-text-muted leading-relaxed mb-6">
                    Supervisión de salud de microservicios, autenticación centralizada en el borde y telemetría operativa.
                </p>
            </div>
            <div class="pt-4 border-t border-border-subtle/40 flex items-center justify-between">
                <a href="/Monitoreo" class="text-xs font-semibold text-secondary hover:underline inline-flex items-center gap-1 transition-colors">
                    Consola de Monitoreo <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                </a>
                <span class="text-[11px] font-medium text-text-muted bg-surface-container-low px-2.5 py-1 rounded-full">Monitoreo Activo</span>
            </div>
        </div>
    </div>
}

<!-- Architecture Status Banner -->
<div class="bg-surface-container-low rounded-3xl p-6 border border-border-subtle/60 flex flex-col md:flex-row items-center justify-between gap-4 ambient-shadow">
    <div class="flex items-center gap-3">
        <div class="w-3.5 h-3.5 rounded-full bg-green-500 animate-pulse flex-shrink-0"></div>
        <div>
            <div class="text-sm font-bold text-primary">Ecosistema y Servicios Omnicanal Operativos</div>
            <div class="text-xs text-text-muted">Infraestructura de alta disponibilidad con procesamiento transaccional en tiempo real.</div>
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a href="/Estado" class="text-xs font-semibold text-primary bg-surface-white hover:bg-surface-bright px-3.5 py-2 rounded-xl border border-border-subtle shadow-sm transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">track_changes</span>
            Rastrear Pedido
        </a>
        <a href="/Cuenta/Privacidad" class="text-xs font-semibold text-text-muted hover:text-primary px-3 py-2 transition-colors">
            Aviso de Privacidad &rarr;
        </a>
    </div>
</div>
