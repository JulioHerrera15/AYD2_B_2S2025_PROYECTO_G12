<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MegaStore Logística & Comercio Omnicanal</title>
    <!-- Preconnect and Preload Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Tailwind CSS Design System Tokens -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "outline": "#77767b",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed": "#001b3e",
                        "surface-container-low": "#f3f3f5",
                        "on-tertiary-container": "#8c8382",
                        "surface-variant": "#e2e2e4",
                        "surface-container-lowest": "#ffffff",
                        "on-primary": "#ffffff",
                        "border-subtle": "#D2D2D7",
                        "surface-white": "#FFFFFF",
                        "outline-variant": "#c7c6ca",
                        "tertiary": "#040302",
                        "on-secondary-container": "#002d61",
                        "on-tertiary-fixed": "#1f1a19",
                        "surface-dim": "#d9dadc",
                        "background": "#f9f9fb",
                        "secondary-fixed-dim": "#aac7ff",
                        "on-tertiary-fixed-variant": "#4c4544",
                        "surface": "#f9f9fb",
                        "surface-container": "#eeeef0",
                        "tertiary-fixed-dim": "#cec4c2",
                        "tertiary-container": "#211c1b",
                        "on-primary-fixed-variant": "#474649",
                        "primary-fixed": "#e4e2e4",
                        "inverse-primary": "#c8c6c8",
                        "primary-container": "#1d1d1f",
                        "on-tertiary": "#ffffff",
                        "surface-bright": "#f9f9fb",
                        "on-primary-container": "#868587",
                        "surface-tint": "#5f5e60",
                        "error": "#ba1a1a",
                        "primary": "#030304",
                        "inverse-on-surface": "#f0f0f2",
                        "on-error": "#ffffff",
                        "secondary-fixed": "#d7e3ff",
                        "surface-container-high": "#e8e8ea",
                        "secondary-container": "#5095fe",
                        "on-surface-variant": "#46464a",
                        "on-secondary": "#ffffff",
                        "surface-container-highest": "#e2e2e4",
                        "primary-fixed-dim": "#c8c6c8",
                        "on-error-container": "#93000a",
                        "on-primary-fixed": "#1b1b1d",
                        "tertiary-fixed": "#ebe0de",
                        "on-surface": "#1a1c1d",
                        "secondary": "#005cba",
                        "text-muted": "#6E6E73",
                        "on-secondary-fixed-variant": "#00458e",
                        "inverse-surface": "#2f3132",
                        "on-background": "#1a1c1d"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        sans: ["Inter", "-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        html, body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f9f9fb;
            color: #030304;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .ambient-shadow {
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }

        .dropdown-container:hover > .dropdown-menu,
        .dropdown-container.is-open > .dropdown-menu {
            display: block;
        }
    </style>
</head>
<body class="bg-background text-primary antialiased min-h-full flex flex-col font-sans">
    <!-- TopNavBar (Glassmorphism / Apple-Inspired Minimalist) -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface-white/85 backdrop-blur-xl border-b border-border-subtle shadow-sm">
        <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
                <div class="w-9 h-9 rounded-xl bg-primary text-on-primary flex items-center justify-center font-bold text-sm shadow-sm group-hover:scale-105 transition-transform duration-200">
                    ML
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-base tracking-tight text-primary leading-tight">MegaStore</span>
                    <span class="text-[10px] font-semibold tracking-wider uppercase text-text-muted">SGO-Logic Omnicanal</span>
                </div>
            </a>

            @{
                var jwt = Context.Request.Cookies["sgo_jwt"];
                var isAuthenticated = !string.IsNullOrWhiteSpace(jwt);
                var userName = Context.Request.Cookies["sgo_user_name"];
                var userEmail = Context.Request.Cookies["sgo_user_email"];
                var userRole = Context.Request.Cookies["sgo_user_role"] ?? "CLIENTE";
                var isStaff = PermisosHelper.EsPersonalAutorizado(userRole, userEmail, jwt);
            }

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-1">
                <a href="/Catalogo" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors hover:bg-surface-container-low text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined text-[17px]">store</span>
                    <span>Catálogo</span>
                </a>
                <a href="/Carrito" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors hover:bg-surface-container-low text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined text-[17px]">shopping_cart</span>
                    <span>Carrito</span>
                </a>
                <a href="/Estado" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors hover:bg-surface-container-low text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined text-[17px]">track_changes</span>
                    <span>Rastreo</span>
                </a>

                @if (isStaff)
                {
                    <!-- Dropdown for Internal / Operational Tools (Only authorized staff/admin) -->
                    <div class="relative dropdown-container">
                        <button type="button" class="dropdown-trigger flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors hover:bg-surface-container-low text-secondary bg-secondary-fixed/30 border border-secondary-container/30">
                            <span class="material-symbols-outlined text-[17px]">admin_panel_settings</span>
                            <span>Operaciones</span>
                            <span class="material-symbols-outlined text-[15px]">expand_more</span>
                        </button>
                        <div class="dropdown-menu absolute left-0 pt-1.5 w-56 hidden z-50 animate-fadeIn">
                            <div class="bg-surface-white rounded-2xl shadow-xl border border-border-subtle/80 py-2">
                                <div class="px-4 py-1.5 text-[10px] font-bold uppercase tracking-wider text-text-muted border-b border-border-subtle/40 mb-1">
                                    Herramientas Operativas
                                </div>
                                <a href="/Pos" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px] text-secondary">point_of_sale</span>
                                    Terminal OmniPOS (Caja)
                                </a>
                                <a href="/Vision360" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px] text-secondary">support_agent</span>
                                    Visión 360 del Cliente
                                </a>
                                <a href="/Despacho" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px] text-secondary">local_shipping</span>
                                    Control de Despacho
                                </a>
                                <a href="/Incidencias" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px] text-secondary">gavel</span>
                                    Gestión de Incidencias
                                </a>
                                <a href="/Monitoreo" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px] text-secondary">hub</span>
                                    Topología & Monitoreo
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </nav>

            <!-- User Session / Auth Controls -->
            <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                @if (isAuthenticated)
                {
                    <div class="relative dropdown-container">
                        <button type="button" class="dropdown-trigger flex items-center gap-2 bg-surface-container-low hover:bg-surface-container border border-border-subtle/70 px-3 py-1.5 rounded-full transition-colors">
                            <div class="w-6 h-6 rounded-full bg-secondary text-white font-bold text-[11px] flex items-center justify-center shadow-sm">
                                @((userName ?? userEmail ?? "U").Substring(0, 1).ToUpper())
                            </div>
                            <span class="text-xs font-semibold text-primary max-w-[110px] truncate hidden sm:inline">
                                @(userName ?? userEmail)
                            </span>
                            <span class="material-symbols-outlined text-[16px] text-text-muted">expand_more</span>
                        </button>
                        <div class="dropdown-menu absolute right-0 pt-1.5 w-48 hidden z-50">
                            <div class="bg-surface-white rounded-2xl shadow-xl border border-border-subtle/80 py-2">
                                <div class="px-4 py-2 border-b border-border-subtle/40 mb-1">
                                    <span class="text-[11px] font-bold text-primary block truncate">@(userName ?? "Usuario")</span>
                                    <span class="text-[10px] text-text-muted block truncate font-mono">@userEmail</span>
                                </div>
                                <a href="/Cuenta/Perfil" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px]">account_circle</span>
                                    Mi Perfil
                                </a>
                                <a href="/Cuenta/Ordenes" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px]">receipt_long</span>
                                    Mis Órdenes
                                </a>
                                <a href="/Cuenta/Privacidad" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-primary hover:bg-surface-container-low">
                                    <span class="material-symbols-outlined text-[17px]">shield</span>
                                    Privacidad & Datos
                                </a>
                                <hr class="my-1 border-border-subtle/50" />
                                <a href="/Auth/Logout" class="flex items-center gap-2 px-4 py-2 text-xs font-medium text-error hover:bg-error-container/30">
                                    <span class="material-symbols-outlined text-[17px]">logout</span>
                                    Cerrar Sesión
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="text-xs font-semibold text-primary hover:text-secondary transition-colors px-2.5 py-1.5">
                        Ingresar
                    </a>
                    <a href="/Auth/Registro" class="bg-primary text-on-primary rounded-full px-3.5 py-1.5 text-xs font-semibold hover:opacity-90 transition-all shadow-sm active:scale-95 duration-150">
                        Registrarse
                    </a>
                }
            </div>
        </div>

        <!-- Mobile Navigation Sub-bar -->
        <div class="md:hidden flex items-center justify-around border-t border-border-subtle/60 py-2 px-2 bg-surface-white overflow-x-auto text-[11px] gap-1">
            <a href="/Catalogo" class="flex flex-col items-center px-2 py-1 font-medium text-on-surface-variant hover:text-primary">
                <span class="material-symbols-outlined text-[18px]">store</span>
                <span>Catálogo</span>
            </a>
            <a href="/Carrito" class="flex flex-col items-center px-2 py-1 font-medium text-on-surface-variant hover:text-primary">
                <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
                <span>Carrito</span>
            </a>
            <a href="/Estado" class="flex flex-col items-center px-2 py-1 font-medium text-on-surface-variant hover:text-primary">
                <span class="material-symbols-outlined text-[18px]">track_changes</span>
                <span>Rastreo</span>
            </a>
            @if (isStaff)
            {
                <a href="/Pos" class="flex flex-col items-center px-2 py-1 font-medium text-secondary">
                    <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                    <span>Operaciones</span>
                </a>
            }
            else if (isAuthenticated)
            {
                <a href="/Cuenta/Ordenes" class="flex flex-col items-center px-2 py-1 font-medium text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                    <span>Pedidos</span>
                </a>
            }
            else
            {
                <a href="/Auth/Login" class="flex flex-col items-center px-2 py-1 font-medium text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined text-[18px]">login</span>
                    <span>Entrar</span>
                </a>
            }
        </div>
    </header>

    <!-- Main Content Canvas -->
    <main class="flex-1 w-full max-w-[1240px] mx-auto px-4 sm:px-6 pt-24 md:pt-28 pb-16">
        @if (TempData["Exito"] != null)
        {
            <div class="mb-6 bg-secondary-fixed text-on-secondary-fixed border border-secondary-container/40 rounded-2xl p-4 flex items-center gap-3 ambient-shadow">
                <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                <div class="font-medium text-sm">@TempData["Exito"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-error-container text-on-error-container border border-error/20 rounded-2xl p-4 flex items-center gap-3 ambient-shadow">
                <span class="material-symbols-outlined text-error" style="font-variation-settings: 'FILL' 1;">error</span>
                <div class="font-medium text-sm">@TempData["Error"]</div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-surface-white border-t border-border-subtle py-10 text-xs text-text-muted mt-auto">
        <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <!-- Col 1: Brand -->
                <div class="md:col-span-1">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-6 h-6 rounded-lg bg-primary text-on-primary flex items-center justify-center text-xs font-bold">
                            ML
                        </div>
                        <span class="font-bold text-sm text-primary">MegaStore SGO-Logic</span>
                    </div>
                    <p class="text-[11px] leading-relaxed text-text-muted mb-3">
                        Plataforma de comercio omnicanal y gestión de pedidos distribuidos (.NET 8, Redis, PostgreSQL y RabbitMQ).
                    </p>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        PCI-DSS & SAT FEL Certificado
                    </span>
                </div>

                <!-- Col 2: Accesos Clientes -->
                <div>
                    <h4 class="font-bold text-primary mb-3 text-xs uppercase tracking-wider">Comercio & Cliente</h4>
                    <ul class="space-y-2">
                        <li><a href="/Catalogo" class="hover:text-primary transition-colors">Catálogo de Productos</a></li>
                        <li><a href="/Carrito" class="hover:text-primary transition-colors">Carrito de Compras</a></li>
                        <li><a href="/Checkout" class="hover:text-primary transition-colors">Finalizar Compra</a></li>
                        <li><a href="/Estado" class="hover:text-primary transition-colors">Rastreo de Órdenes</a></li>
                        <li><a href="/Cuenta/Privacidad" class="hover:text-primary transition-colors font-semibold text-secondary">Portal de Privacidad</a></li>
                    </ul>
                </div>

                <!-- Col 3: Operaciones Internas o Mi Cuenta -->
                @if (isStaff)
                {
                    <div>
                        <h4 class="font-bold text-primary mb-3 text-xs uppercase tracking-wider">Operaciones & Tiendas</h4>
                        <ul class="space-y-2">
                            <li><a href="/Pos" class="hover:text-primary transition-colors">Terminal OmniPOS (Tiendas 1-32)</a></li>
                            <li><a href="/Vision360" class="hover:text-primary transition-colors">Visión 360 Call Center</a></li>
                            <li><a href="/Despacho" class="hover:text-primary transition-colors">Dashboard Logístico</a></li>
                            <li><a href="/Incidencias" class="hover:text-primary transition-colors">Bandeja de Incidencias</a></li>
                            <li><a href="/Monitoreo" class="hover:text-primary transition-colors">Centro de Monitoreo & ADRs</a></li>
                        </ul>
                    </div>
                }
                else if (isAuthenticated)
                {
                    <div>
                        <h4 class="font-bold text-primary mb-3 text-xs uppercase tracking-wider">Mi Cuenta</h4>
                        <ul class="space-y-2">
                            <li><a href="/Cuenta/Perfil" class="hover:text-primary transition-colors">Mi Perfil</a></li>
                            <li><a href="/Cuenta/Ordenes" class="hover:text-primary transition-colors">Mis Pedidos</a></li>
                            <li><a href="/Estado" class="hover:text-primary transition-colors">Rastrear Pedido</a></li>
                            <li><a href="/Cuenta/Privacidad" class="hover:text-primary transition-colors">Privacidad & Datos</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div>
                        <h4 class="font-bold text-primary mb-3 text-xs uppercase tracking-wider">Acceso a Tu Cuenta</h4>
                        <ul class="space-y-2">
                            <li><a href="/Auth/Login" class="hover:text-primary transition-colors">Iniciar Sesión</a></li>
                            <li><a href="/Auth/Registro" class="hover:text-primary transition-colors">Registrar Nueva Cuenta</a></li>
                            <li><a href="/Estado" class="hover:text-primary transition-colors">Rastrear Mi Pedido</a></li>
                            <li><a href="/Cuenta/Privacidad" class="hover:text-primary transition-colors">Derechos ARCO & Datos</a></li>
                        </ul>
                    </div>
                }
            </div>

            <div class="pt-6 border-t border-border-subtle/50 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px]">
                <div>
                    &copy; 2026 MegaStore Inc. &bull; Plataforma Omnicanal de Comercio Electrónico & Logística Integral
                </div>
                <div class="flex items-center gap-4">
                    <a href="/Cuenta/Privacidad" class="hover:text-primary transition-colors">Aviso de Privacidad</a>
                    @if (isStaff)
                    {
                        <span>&bull;</span>
                        <a href="/Monitoreo" class="hover:text-primary transition-colors">Centro de Monitoreo</a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var containers = document.querySelectorAll('.dropdown-container');
            containers.forEach(function(container) {
                var trigger = container.querySelector('.dropdown-trigger');
                if (trigger) {
                    trigger.addEventListener('click', function(e) {
                        e.stopPropagation();
                        var isOpen = container.classList.contains('is-open');
                        containers.forEach(function(c) { c.classList.remove('is-open'); });
                        if (!isOpen) {
                            container.classList.add('is-open');
                        }
                    });
                }
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.dropdown-container')) {
                    containers.forEach(function(c) { c.classList.remove('is-open'); });
                }
            });
        });
    </script>
</body>
</html>
