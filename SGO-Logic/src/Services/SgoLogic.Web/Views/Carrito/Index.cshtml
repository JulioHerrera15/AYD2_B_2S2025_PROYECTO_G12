                        <button type="button" onclick="const input = this.parentNode.querySelector('input'); if(parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;" class="w-7 h-7 rounded-lg bg-surface-white text-primary text-xs font-bold hover:bg-surface-container-low flex items-center justify-center transition-colors shadow-2xs">-</button>
