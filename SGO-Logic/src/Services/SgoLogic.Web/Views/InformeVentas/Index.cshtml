@model SgoLogic.Web.Services.InformeVentasModel?
@{
    ViewData["Title"] = "Informe de Ventas Conciliado";
    var desde = (ViewBag.Desde as DateTime?)?.ToString("yyyy-MM-dd");
    var hasta = (ViewBag.Hasta as DateTime?)?.ToString("yyyy-MM-dd");
    var lotes = Model?.Lotes ?? new();
    var montoSgo = lotes.Sum(l => l.MontoTotal);
    var montoErp = lotes.Sum(l => l.Conciliacion?.MontoErp ?? 0m);
    var registrosSgo = lotes.Sum(l => l.CantidadRegistros);
    var registrosErp = lotes.Sum(l => l.Conciliacion?.RegistrosErp ?? 0);
    var conciliados = lotes.Count(l => l.Conciliacion?.Conciliada == true);
    var conDiferencias = lotes.Count(l => l.Conciliacion is { Conciliada: false });
    var sinConciliar = lotes.Count(l => l.Conciliacion is null);
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Informe de Ventas Conciliado</h1>
            <p class="text-xs sm:text-sm text-text-muted">Lotes enviados al ERP-Core, totales SGO vs ERP, diferencias y trazabilidad hasta la orden y su bitácora de auditoría.</p>
            @if (Model is not null)
            {
                <p class="text-[11px] text-text-muted mt-1">Generado: @Model.GeneradoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</p>
            }
        </div>
        <div class="flex flex-wrap items-end gap-2">
            <form method="get" class="flex flex-wrap items-end gap-2">
                <label class="text-[11px] font-semibold text-text-muted">Desde
                    <input type="date" name="desde" value="@desde" class="block border border-border-subtle rounded-lg px-2 py-1 text-xs" />
                </label>
                <label class="text-[11px] font-semibold text-text-muted">Hasta
                    <input type="date" name="hasta" value="@hasta" class="block border border-border-subtle rounded-lg px-2 py-1 text-xs" />
                </label>
                <button class="bg-surface-white border border-border-subtle text-primary px-3 py-1.5 rounded-lg text-xs font-semibold">Filtrar</button>
            </form>
            <a href="/InformeVentas/Csv?desde=@desde&hasta=@hasta" class="inline-flex items-center gap-1 bg-surface-white border border-border-subtle text-primary px-3 py-1.5 rounded-lg text-xs font-semibold">
                <span class="material-symbols-outlined text-[16px]">download</span> Exportar CSV
            </a>
            <form method="post" action="/InformeVentas/Conciliar">
                <button class="inline-flex items-center gap-1 bg-primary text-on-primary px-3 py-1.5 rounded-lg text-xs font-semibold">
                    <span class="material-symbols-outlined text-[16px]">sync</span> Conciliar ahora
                </button>
            </form>
        </div>
    </div>

    @if (Model is null)
    {
        <div class="bg-error-container/20 border border-error/40 text-error rounded-2xl p-5 text-sm">
            No se pudo obtener el informe del servicio de Integración ERP. Verifica que <code>integracion-erp-worker</code> esté en línea.
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80">
                <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Ventas SGO (enviadas)</div>
                <div class="text-2xl font-black text-primary">Q @montoSgo.ToString("N2")</div>
                <div class="text-[10px] text-text-muted mt-1">@registrosSgo registros en @lotes.Count lotes</div>
            </div>
            <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80">
                <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Confirmado por ERP</div>
                <div class="text-2xl font-black text-primary">Q @montoErp.ToString("N2")</div>
                <div class="text-[10px] text-text-muted mt-1">@registrosErp registros</div>
            </div>
            <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80">
                <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Diferencia SGO − ERP</div>
                <div class="text-2xl font-black @(montoSgo - montoErp == 0 ? "text-emerald-700" : "text-error")">Q @((montoSgo - montoErp).ToString("N2"))</div>
                <div class="text-[10px] text-text-muted mt-1">@(registrosSgo - registrosErp) registros de diferencia</div>
            </div>
            <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80">
                <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Estado de lotes</div>
                <div class="text-sm font-semibold"><span class="text-emerald-700">@conciliados conciliados</span> · <span class="text-error">@conDiferencias con diferencias</span></div>
                <div class="text-[10px] text-text-muted mt-1">@sinConciliar sin conciliar · @Model.VentasPendientes ventas pendientes de lote (Q @Model.MontoPendiente.ToString("N2"))</div>
            </div>
        </div>

        <div class="bg-surface-white rounded-2xl border border-border-subtle/80 overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-surface-container-low text-text-muted uppercase tracking-wider text-[10px]">
                    <tr>
                        <th class="py-3 px-4">Lote</th>
                        <th class="py-3 px-4">Generado</th>
                        <th class="py-3 px-4">Envío</th>
                        <th class="py-3 px-4 text-right">SGO</th>
                        <th class="py-3 px-4 text-right">ERP</th>
                        <th class="py-3 px-4">Conciliación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lotes.Count == 0)
                    {
                        <tr><td colspan="6" class="py-6 px-4 text-center text-text-muted">No hay lotes en el rango seleccionado.</td></tr>
                    }
                    @foreach (var l in lotes)
                    {
                        var c = l.Conciliacion;
                        <tr class="border-t border-border-subtle/60 align-top">
                            <td class="py-3 px-4 font-mono font-semibold text-primary">@l.LoteId<div class="text-[10px] text-text-muted font-sans">#@l.Secuencia · @l.Formato</div></td>
                            <td class="py-3 px-4">@l.FechaGeneracion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3 px-4">@l.Estado<div class="text-[10px] text-text-muted">HTTP @(l.CodigoHttp?.ToString() ?? "—") · @l.Intentos intento(s)</div></td>
                            <td class="py-3 px-4 text-right">Q @l.MontoTotal.ToString("N2")<div class="text-[10px] text-text-muted">@l.CantidadRegistros reg.</div></td>
                            <td class="py-3 px-4 text-right">@(c is null ? "—" : $"Q {c.MontoErp:N2}")<div class="text-[10px] text-text-muted">@(c is null ? "" : $"{c.RegistrosErp} reg.")</div></td>
                            <td class="py-3 px-4">
                                @if (c is null)
                                {
                                    <span class="px-2 py-0.5 rounded-full bg-surface-container-low text-text-muted font-semibold">SIN CONCILIAR</span>
                                }
                                else if (c.Conciliada)
                                {
                                    <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">CONCILIADO</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-800 font-semibold">DIFERENCIA</span>
                                    <div class="text-[10px] text-error mt-1">@c.Diferencias</div>
                                }
                                @if (c is not null)
                                {
                                    <div class="text-[10px] text-text-muted mt-1">@c.CreadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="px-4 pb-3">
                                <details class="bg-surface-container-low rounded-xl px-3 py-2" data-lote="@l.LoteId">
                                    <summary class="cursor-pointer text-[11px] font-semibold text-primary">Órdenes del lote (@l.Registros.Count) y bitácora de auditoría</summary>
                                    <table class="w-full mt-2 text-[11px]">
                                        <thead class="text-text-muted"><tr><th class="py-1">Orden</th><th>Canal</th><th>Tienda</th><th>Fecha</th><th class="text-right">Monto</th></tr></thead>
                                        <tbody>
                                            @foreach (var r in l.Registros)
                                            {
                                                <tr class="border-t border-border-subtle/40">
                                                    <td class="py-1 font-mono"><a class="text-primary underline" href="/Estado?ordenId=@r.OrdenId">@r.OrdenId</a></td>
                                                    <td>@r.Canal</td>
                                                    <td>@r.Tienda</td>
                                                    <td>@r.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td class="text-right @(r.Monto < 0 ? "text-error" : "")">Q @r.Monto.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <div class="mt-3 text-[11px] font-semibold text-text-muted">Eventos de auditoría del lote</div>
                                    <ul class="auditoria text-[11px] font-mono mt-1"><li class="text-text-muted">Cargando…</li></ul>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    // Carga la bitacora de auditoria del lote al expandirlo.
    document.querySelectorAll('details[data-lote]').forEach(d => d.addEventListener('toggle', async () => {
        if (!d.open || d.dataset.cargado) return;
        d.dataset.cargado = '1';
        const ul = d.querySelector('.auditoria');
        try {
            const eventos = await (await fetch('/InformeVentas/Auditoria?id=' + encodeURIComponent(d.dataset.lote))).json();
            ul.innerHTML = '';
            if (!eventos.length) ul.innerHTML = '<li class="text-text-muted">Sin eventos registrados.</li>';
            for (const e of eventos) {
                const li = document.createElement('li');
                li.textContent = `${new Date(e.occurredAt).toLocaleString()} · ${e.eventType} · ${e.source} · tx ${e.transactionId} · evento ${e.eventId}`;
                ul.appendChild(li);
            }
        } catch {
            ul.innerHTML = '<li class="text-error">No se pudo consultar la auditoría.</li>';
        }
    }));
</script>
