@model List<SgoLogic.Web.Controllers.ProductoCatalogo>
@{
    ViewData["Title"] = "Catálogo Comercial Omnicanal";
    var categoriaActual = ViewBag.Categoria as string ?? "TODOS";
    var busquedaActual = ViewBag.Busqueda as string ?? "";
    var sucursales = ViewBag.Sucursales as IReadOnlyList<SgoLogic.Web.Services.SucursalModel>
        ?? Array.Empty<SgoLogic.Web.Services.SucursalModel>();
    var sucursalSeleccionada = ViewBag.SucursalSeleccionada as string ?? SgoLogic.Web.Controllers.CatalogoController.SucursalPorDefecto;
    var centrosDistribucion = sucursales.Where(s => !s.EsTienda).ToList();
    var tiendasPorDepartamento = sucursales
        .Where(s => s.EsTienda)
        .GroupBy(s => s.Departamento)
        .OrderBy(g => g.Key == "Guatemala" ? 0 : 1)
        .ThenBy(g => g.Key)
        .ToList();
}

<div class="mb-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">storefront</span>
                Catálogo Comercial MegaStore &bull; Existencias en Vivo
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Tienda & Catálogo de Productos</h1>
            <p class="text-xs sm:text-sm text-text-muted">Consulta disponibilidad en tiempo real en nuestras 32 tiendas físicas y 2 Centros de Distribución.</p>
        </div>

        <!-- Store Selector Filter -->
        <div class="flex items-center gap-2 bg-surface-white px-3.5 py-2 rounded-2xl border border-border-subtle/80 shadow-sm">
            <span class="material-symbols-outlined text-secondary text-[20px]">location_on</span>
            <div class="flex flex-col">
                <span class="text-[10px] text-text-muted font-semibold uppercase tracking-wider">Sucursal Seleccionada</span>
                <select id="sucursal-selector" class="text-xs font-bold text-primary bg-transparent border-none p-0 focus:ring-0 cursor-pointer">
                    @if (sucursales.Count == 0)
                    {
                        <option value="@sucursalSeleccionada" selected>@sucursalSeleccionada</option>
                    }
                    else
                    {
                        if (centrosDistribucion.Count > 0)
                        {
                            <optgroup label="Centros de Distribución">
                                @foreach (var cd in centrosDistribucion)
                                {
                                    <option value="@cd.Id" selected="@(cd.Id == sucursalSeleccionada)">@cd.Nombre</option>
                                }
                            </optgroup>
                        }
                        foreach (var grupo in tiendasPorDepartamento)
                        {
                            <optgroup label="@grupo.Key">
                                @foreach (var tienda in grupo)
                                {
                                    <option value="@tienda.Id" selected="@(tienda.Id == sucursalSeleccionada)">@tienda.Nombre</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Search & Category Filters -->
    <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle/70 ambient-shadow mb-6 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Categories Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 text-xs font-medium">
            <a href="/Catalogo" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "TODOS" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Todos
            </a>
            <a href="/Catalogo?categoria=Línea Blanca" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Línea Blanca" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Línea Blanca
            </a>
            <a href="/Catalogo?categoria=Televisores" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Televisores" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Televisores
            </a>
            <a href="/Catalogo?categoria=Audio" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Audio" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Audio
            </a>
            <a href="/Catalogo?categoria=Informática" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Informática" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Informática
            </a>
            <a href="/Catalogo?categoria=Climatización" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Climatización" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Climatización
            </a>
            <a href="/Catalogo?categoria=Hogar Inteligente" class="px-3.5 py-1.5 rounded-full transition-colors whitespace-nowrap @(categoriaActual == "Hogar Inteligente" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-variant")">
                Smart Home
            </a>
        </div>

        <!-- Search Bar -->
        <form method="get" action="/Catalogo" class="relative flex-shrink-0 min-w-[260px]">
            <input type="hidden" name="categoria" value="@categoriaActual" />
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-[18px] text-text-muted">search</span>
            <input type="text" name="busqueda" value="@busquedaActual" placeholder="Buscar por nombre o SKU..."
                   class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-border-subtle bg-surface-container-low focus:outline-none focus:border-secondary focus:bg-surface-white transition-all" />
        </form>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var prod in Model)
        {
            <div class="bg-surface-white rounded-3xl p-5 border border-border-subtle/60 ambient-shadow flex flex-col justify-between hover:border-primary/40 transition-all hover:shadow-md group" data-sku="@prod.Sku">
                <div>
                    <!-- Product Card Top: Badge & Category -->
                    <div class="flex items-center justify-between mb-4">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-surface-container-low text-primary border border-border-subtle/50">
                            @prod.Badge
                        </span>
                        <span class="text-[11px] font-mono text-text-muted">@prod.Sku</span>
                    </div>

                    <!-- Product Visual Frame -->
                    <div class="w-full h-40 rounded-2xl bg-surface-container-low/70 flex items-center justify-center mb-4 group-hover:scale-[1.02] transition-transform duration-200">
                        <span class="material-symbols-outlined text-[64px] text-primary/70">@prod.Icono</span>
                    </div>

                    <!-- Category & Title -->
                    <div class="text-[11px] font-semibold text-secondary uppercase tracking-wider mb-1">@prod.Categoria</div>
                    <h3 class="text-sm font-bold text-primary leading-snug mb-2 line-clamp-2">@prod.Nombre</h3>
                    <p class="text-[11px] text-text-muted leading-relaxed mb-4 line-clamp-3">@prod.DescripcionCorta</p>

                    <!-- Real-Time Stock Pill -->
                    <div class="mb-4 p-2 rounded-xl bg-surface-container-low border border-border-subtle/40 flex items-center justify-between text-[11px]">
                        <span class="text-text-muted flex items-center gap-1">
                            <span class="material-symbols-outlined text-[15px] text-secondary">inventory</span>
                            Stock en Sucursal:
                        </span>
                        <span id="stock-badge-@prod.Sku" class="font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md text-right" data-stock="loading">
                            Consultando...
                        </span>
                    </div>
                    <div id="stock-cercana-@prod.Sku" class="hidden -mt-2 mb-4 text-right">
                        <button type="button" class="btn-cambiar-sucursal inline-flex items-center gap-1 text-[11px] font-semibold text-secondary hover:underline" data-ubicacion="">
                            <span class="material-symbols-outlined text-[14px]">swap_horiz</span>
                            Cambiar a esa sucursal
                        </button>
                    </div>
                </div>

                <!-- Price & Add Action -->
                <div class="pt-3 border-t border-border-subtle/50">
                    <div class="flex items-baseline justify-between mb-3">
                        <span class="text-xs text-text-muted">Precio con IVA</span>
                        <div class="text-base font-bold text-primary">
                            Q @prod.PrecioUnitario.ToString("N2")
                        </div>
                    </div>

                    <form method="post" action="/Carrito/Agregar" class="flex items-center gap-2 form-agregar-carrito" data-stock-form="@prod.Sku">
                        <input type="hidden" name="sku" value="@prod.Sku" />
                        <input type="hidden" name="descripcion" value="@prod.Nombre" />
                        <input type="hidden" name="precioUnitario" value="@prod.PrecioUnitario" />
                        <input type="hidden" name="returnUrl" value="/Catalogo" />
                        <input type="number" name="cantidad" value="1" min="1" max="10"
                               class="w-14 px-2 py-2 text-center text-xs font-semibold rounded-xl border border-border-subtle bg-surface-container-low focus:outline-none" />
                        <button type="submit" class="flex-1 bg-primary text-on-primary hover:opacity-90 active:scale-95 py-2 px-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-sm" disabled>
                            <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
                            <span>Agregar</span>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Global Stock Refresh Controls -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-surface-white rounded-2xl border border-border-subtle/60 ambient-shadow">
        <div class="flex items-center gap-3 text-xs text-text-muted">
            <span class="material-symbols-outlined text-secondary text-[18px]">sync</span>
            <span>Los stocks se consultan en tiempo real.</span>
            <span id="stock-global-status" class="text-xs text-emerald-700 ml-2 hidden">Actualizado</span>
        </div>
        <div class="flex items-center gap-2">
            <button id="btn-refrescar-todo" type="button" class="inline-flex items-center gap-1.5 bg-surface-container-low text-primary px-4 py-2 rounded-xl text-xs font-semibold hover:bg-surface-variant transition-colors border border-border-subtle/60">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                <span>Refrescar Todos</span>
            </button>
            <label class="inline-flex items-center gap-1.5 text-xs font-medium text-text-muted cursor-pointer">
                <input type="checkbox" id="chk-auto-refresh" class="rounded border-border-subtle text-secondary focus:ring-secondary" />
                Auto-refresh (30s)
            </label>
        </div>
    </div>
</div>

<script>
    // Helper: normaliza claves a camelCase para robustez ante variaciones de serialización
    function normalizeKeys(obj) {
        if (!obj || typeof obj !== 'object') return obj;
        if (Array.isArray(obj)) return obj.map(normalizeKeys);
        const out = {};
        for (const [k, v] of Object.entries(obj)) {
            const nk = k.charAt(0).toLowerCase() + k.slice(1);
            out[nk] = normalizeKeys(v);
        }
        return out;
    }

    // Obtener stock disponible para una ubicación (maneja camelCase y PascalCase)
    function getDisponible(existencia) {
        if (!existencia) return 0;
        return existencia.disponible ?? existencia.cantidadDisponible ?? existencia.Disponible ?? existencia.CantidadDisponible ?? 0;
    }

    function getUbicacionId(existencia) {
        if (!existencia) return '';
        return existencia.ubicacionId ?? existencia.UbicacionId ?? '';
    }

    function guardarSucursal(ubicacionId) {
        document.cookie = `sgo_sucursal=${encodeURIComponent(ubicacionId)}; path=/; max-age=2592000`;
    }

    function formatearKm(km) {
        if (km === null || km === undefined) return null;
        return Number(km).toLocaleString('es-GT', { maximumFractionDigits: 1 });
    }

    function habilitarAgregar(btn, qtyInput, maximo) {
        if (!btn) return;
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
        if (qtyInput && maximo) qtyInput.max = Math.min(10, maximo);
    }

    function deshabilitarAgregar(btn) {
        if (!btn) return;
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    // Consultar stock en tiempo real desde inventario-api al cambiar de sucursal
    async function actualizarDisponibilidadTienda(ubicacionId) {
        const skus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Sku)));
        let anyError = false;

        for (const sku of skus) {
            const el = document.getElementById(`stock-badge-${sku}`);
            const contenedorCercana = document.getElementById(`stock-cercana-${sku}`);
            const btnCambiar = contenedorCercana?.querySelector('.btn-cambiar-sucursal');
            const form = document.querySelector(`form[data-stock-form="${sku}"]`);
            const btn = form?.querySelector('button[type="submit"]');
            const qtyInput = form?.querySelector('input[name="cantidad"]');
            if (!el) continue;
            contenedorCercana?.classList.add('hidden');

            try {
                // Cache-busting: timestamp único por petición para evitar cache de navegador/gateway
                const cacheBust = Date.now();
                const res = await fetch(`/Catalogo/Stock?sku=${encodeURIComponent(sku)}&ubicacionId=${encodeURIComponent(ubicacionId)}&_=${cacheBust}`, {
                    headers: { 'Cache-Control': 'no-cache, no-store, must-revalidate', 'Pragma': 'no-cache' }
                });
                if (res.ok) {
                    const data = normalizeKeys(await res.json());
                    const existencias = data.existencias ?? [];
                    const cercana = data.cercana;

                    const existencia = existencias.find(e => getUbicacionId(e) === ubicacionId);
                    const disponible = getDisponible(existencia);
                    const totalGlobal = existencias.reduce((acc, curr) => acc + Math.max(0, getDisponible(curr)), 0);

                    if (existencia && disponible > 0) {
                        el.textContent = `${disponible} en stock`;
                        el.className = "font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md text-right";
                        el.dataset.stock = 'available';
                        habilitarAgregar(btn, qtyInput, disponible);
                    } else if (cercana) {
                        // Agotado en la sucursal elegida: se sugiere la tienda mas cercana
                        // con stock. Agregar sigue habilitado: el carrito aparta en esa tienda.
                        const km = formatearKm(cercana.distanciaKm);
                        el.textContent = km
                            ? `Agotado aquí - disponible en ${cercana.nombre} a ${km} km`
                            : `Agotado aquí - disponible en ${cercana.nombre}`;
                        el.className = "font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-md text-right";
                        el.dataset.stock = 'other';
                        if (btnCambiar) {
                            btnCambiar.dataset.ubicacion = cercana.ubicacionId;
                            contenedorCercana.classList.remove('hidden');
                        }
                        habilitarAgregar(btn, qtyInput, cercana.disponible);
                    } else if (totalGlobal > 0) {
                        // Ninguna tienda tiene, pero un centro de distribucion si.
                        el.textContent = "Agotado aquí - disponible en centro de distribución";
                        el.className = "font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-md text-right";
                        el.dataset.stock = 'cd';
                        habilitarAgregar(btn, qtyInput, totalGlobal);
                    } else {
                        el.textContent = "Sin existencias en ninguna sucursal";
                        el.className = "font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-md text-right";
                        el.dataset.stock = 'none';
                        deshabilitarAgregar(btn);
                    }
                } else {
                    anyError = true;
                    el.textContent = "Error al consultar";
                    el.className = "font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-md";
                    el.dataset.stock = 'error';
                }
            } catch (err) {
                anyError = true;
                console.error("Error consultando stock de " + sku, err);
                el.textContent = "Error de red";
                el.className = "font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-md";
                el.dataset.stock = 'error';
            }
        }

        const statusEl = document.getElementById('stock-global-status');
        if (statusEl) {
            statusEl.textContent = anyError ? 'Algunas consultas fallaron' : 'Actualizado';
            statusEl.className = anyError ? 'text-xs text-amber-700' : 'text-xs text-emerald-700';
        }
    }

    let autoRefreshInterval = null;

    function iniciarAutoRefresh(ubicacionId) {
        if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        autoRefreshInterval = setInterval(() => actualizarDisponibilidadTienda(ubicacionId), 30000);
    }

    function detenerAutoRefresh() {
        if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        autoRefreshInterval = null;
    }

    document.addEventListener("DOMContentLoaded", function () {
        const selector = document.getElementById("sucursal-selector");
        const btnRefrescar = document.getElementById("btn-refrescar-todo");
        const chkAuto = document.getElementById("chk-auto-refresh");

        if (selector) {
            // La sucursal elegida viaja en la cookie: el carrito la usa para apartar ahi.
            if (!document.cookie.split('; ').some(c => c.startsWith('sgo_sucursal='))) {
                guardarSucursal(selector.value);
            }

            actualizarDisponibilidadTienda(selector.value);

            selector.addEventListener("change", function () {
                guardarSucursal(this.value);
                actualizarDisponibilidadTienda(this.value);
                if (chkAuto?.checked) {
                    iniciarAutoRefresh(this.value);
                }
            });
        }

        document.querySelectorAll('.btn-cambiar-sucursal').forEach(boton => {
            boton.addEventListener('click', function () {
                const destino = this.dataset.ubicacion;
                if (!destino || !selector) return;
                selector.value = destino;
                guardarSucursal(destino);
                actualizarDisponibilidadTienda(destino);
                if (chkAuto?.checked) {
                    iniciarAutoRefresh(destino);
                }
            });
        });

        if (btnRefrescar) {
            btnRefrescar.addEventListener("click", function () {
                const ubicacionId = selector?.value || "@sucursalSeleccionada";
                this.disabled = true;
                this.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span><span>Actualizando...</span>';
                actualizarDisponibilidadTienda(ubicacionId).finally(() => {
                    this.disabled = false;
                    this.innerHTML = '<span class="material-symbols-outlined text-[16px]">refresh</span><span>Refrescar Todos</span>';
                });
            });
        }

        if (chkAuto) {
            chkAuto.addEventListener("change", function () {
                const ubicacionId = selector?.value || "@sucursalSeleccionada";
                if (this.checked) {
                    iniciarAutoRefresh(ubicacionId);
                } else {
                    detenerAutoRefresh();
                }
            });
        }

        // Limpiar intervalo al salir de la página
        window.addEventListener('beforeunload', detenerAutoRefresh);

        // Page Visibility API: refrescar al volver a la pestaña (ej. tras compra)
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden && selector) {
                console.log('[Stock] Pestaña visible, refrescando stock...');
                actualizarDisponibilidadTienda(selector.value);
            }
        });

        // ── Manejador de Carrito sin salir del Catalogo ──────────────────────
        function actualizarBadgeCarrito(total) {
            const badgeDesktop = document.getElementById('nav-cart-badge');
            const badgeMobile = document.getElementById('nav-cart-badge-mobile');
            if (total > 0) {
                if (badgeDesktop) {
                    badgeDesktop.textContent = total;
                    badgeDesktop.classList.remove('hidden');
                }
                if (badgeMobile) {
                    badgeMobile.textContent = total;
                    badgeMobile.classList.remove('hidden');
                }
            }
        }

        function mostrarErrorCarrito(mensaje) {
            let toast = document.getElementById('cart-toast-error');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'cart-toast-error';
                toast.className = 'fixed bottom-5 right-5 z-50 transition-all duration-300 max-w-sm';
                document.body.appendChild(toast);
            }

            toast.innerHTML = `
                <div class="bg-surface-white border border-rose-200 shadow-2xl rounded-2xl p-4 flex items-center gap-3 text-xs font-medium text-primary ambient-shadow">
                    <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">inventory</span>
                    </div>
                    <div class="flex-1 text-rose-900"></div>
                </div>
            `;
            toast.querySelector('.flex-1').textContent = mensaje;
            toast.classList.remove('hidden');

            if (window._toastErrorTimeout) clearTimeout(window._toastErrorTimeout);
            window._toastErrorTimeout = setTimeout(() => toast.classList.add('hidden'), 6000);
        }

        function mostrarNotificacionCarrito(descripcion, total) {
            let toast = document.getElementById('cart-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'cart-toast';
                toast.className = 'fixed bottom-5 right-5 z-50 transition-all duration-300 transform translate-y-12 opacity-0 pointer-events-none';
                document.body.appendChild(toast);
            }

            toast.innerHTML = `
                <div class="bg-surface-white border border-border-subtle shadow-2xl rounded-2xl p-4 flex items-center gap-4 text-xs font-medium text-primary max-w-sm ambient-shadow">
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                    </div>
                    <div class="flex-1">
                        <div class="font-bold text-primary truncate max-w-[190px]">${descripcion}</div>
                        <div class="text-[11px] text-text-muted">Agregado al carrito (${total} items en total)</div>
                    </div>
                    <a href="/Carrito" class="bg-primary text-on-primary font-bold px-3 py-1.5 rounded-xl hover:opacity-90 transition-all whitespace-nowrap">
                        Ver Carrito
                    </a>
                </div>
            `;

            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            if (window._toastTimeout) clearTimeout(window._toastTimeout);
            window._toastTimeout = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }

        document.querySelectorAll('.form-agregar-carrito').forEach(form => {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = form.querySelector('button[type="submit"]');
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">sync</span><span>Agregando...</span>';

                try {
                    const formData = new FormData(form);
                    const res = await fetch('/Carrito/Agregar', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: formData
                    });

                    const data = await res.json().catch(() => null);

                    if (data && (!res.ok || data.exito === false)) {
                        // Inventario no aparto el stock (409) o no respondio (503): el
                        // carrito no cambio y se avisa sin salir del catalogo.
                        mostrarErrorCarrito(data.mensaje || 'No se pudo agregar el producto.');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                        actualizarDisponibilidadTienda(selector?.value || "@sucursalSeleccionada");
                    } else if (res.ok && data) {
                        actualizarBadgeCarrito(data.totalItems);
                        mostrarNotificacionCarrito(data.descripcion || 'Producto', data.totalItems);

                        btn.classList.remove('bg-primary');
                        btn.classList.add('bg-emerald-600');
                        btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span><span>Agregado</span>';
                        setTimeout(() => {
                            btn.classList.remove('bg-emerald-600');
                            btn.classList.add('bg-primary');
                            btn.disabled = false;
                            btn.innerHTML = originalHtml;
                        }, 1200);
                    } else {
                        form.submit();
                    }
                } catch {
                    form.submit();
                }
            });
        });
    });
</script>
