@model List<SgoLogic.Web.Services.UsuarioDto>
@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
    var query = ViewBag.SearchQuery as string ?? "";
    var currentEmail = ViewBag.CurrentUserEmail as string ?? "";
    var currentRole = ViewBag.CurrentUserRole as string ?? "";
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header with Breadcrumbs & Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">admin_panel_settings</span>
                Control de Acceso &bull; Identidad y Seguridad
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Usuarios y Asignación de Roles</h1>
            <p class="text-xs sm:text-sm text-text-muted">Asigna roles canónicos del sistema (CLIENTE, OPERADOR, ADMIN) a cualquier cuenta registrada en tiempo real.</p>
        </div>

        <form asp-action="Index" method="get" class="flex items-center gap-2">
            <div class="relative flex items-center bg-surface-white rounded-xl border border-border-subtle focus-within:border-secondary p-1 pl-3 ambient-shadow">
                <span class="material-symbols-outlined text-text-muted text-[19px]">search</span>
                <input type="text" name="q" value="@query" placeholder="Buscar por email, nombre o rol..."
                       class="px-2 py-1.5 text-xs bg-transparent border-none outline-none text-primary placeholder:text-text-muted w-56 sm:w-72" />
            </div>
            <button type="submit" class="bg-primary text-on-primary text-xs font-semibold px-4 py-2 rounded-xl hover:opacity-90 active:scale-95 transition-all">
                Filtrar
            </button>
            @if (!string.IsNullOrWhiteSpace(query))
            {
                <a href="/Usuarios" class="text-xs font-semibold text-text-muted hover:text-primary px-2">Limpiar</a>
            }
        </form>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 text-emerald-800 border border-emerald-200 p-4 rounded-2xl flex items-center gap-2.5 text-xs font-medium ambient-shadow">
            <span class="material-symbols-outlined text-emerald-600 text-[18px]">check_circle</span>
            <span>@TempData["Exito"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container border border-error/20 p-4 rounded-2xl flex items-center gap-2.5 text-xs font-medium ambient-shadow">
            <span class="material-symbols-outlined text-error text-[18px]">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-text-muted uppercase tracking-wider mb-1">Total Cuentas</div>
            <div class="text-2xl font-black text-primary">@Model.Count</div>
            <div class="text-[10px] text-text-muted mt-1">Registradas en Auth.Api</div>
        </div>
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider mb-1">Clientes</div>
            <div class="text-2xl font-black text-emerald-700">@Model.Count(u => u.Rol == "CLIENTE")</div>
            <div class="text-[10px] text-text-muted mt-1">Canal Ecommerce</div>
        </div>
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-blue-700 uppercase tracking-wider mb-1">Operadores</div>
            <div class="text-2xl font-black text-blue-700">@Model.Count(u => u.Rol == "OPERADOR")</div>
            <div class="text-[10px] text-text-muted mt-1">Tiendas & Call Center</div>
        </div>
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle/80 ambient-shadow">
            <div class="text-[11px] font-bold text-purple-700 uppercase tracking-wider mb-1">Administradores</div>
            <div class="text-2xl font-black text-purple-700">@Model.Count(u => u.Rol == "ADMIN")</div>
            <div class="text-[10px] text-text-muted mt-1">Control Total</div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-surface-white rounded-3xl border border-border-subtle/80 overflow-hidden ambient-shadow">
        <div class="p-6 border-b border-border-subtle/60 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-primary">Directorio de Usuarios</h2>
                <p class="text-xs text-text-muted">Selecciona el rol deseado en el selector de cada fila y haz clic en Guardar para aplicarlo de inmediato.</p>
            </div>
            <span class="text-xs font-mono text-text-muted">@Model.Count resultados</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-lowest text-[11px] uppercase tracking-wider font-bold text-text-muted border-b border-border-subtle">
                        <th class="py-3 px-6">Usuario</th>
                        <th class="py-3 px-6">Email / Verificación</th>
                        <th class="py-3 px-6">Rol Actual</th>
                        <th class="py-3 px-6">Asignar Nuevo Rol</th>
                        <th class="py-3 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle/40 text-xs">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-text-muted">
                                <span class="material-symbols-outlined text-[36px] text-text-muted/60 block mb-2">person_search</span>
                                No se encontraron usuarios con el criterio de búsqueda.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var u in Model)
                        {
                            var esYo = string.Equals(u.Email, currentEmail, StringComparison.OrdinalIgnoreCase);
                            <tr class="hover:bg-surface-container-lowest/60 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-surface-container flex items-center justify-center font-bold text-sm text-primary">
                                            @((u.NombreCompleto ?? u.Email).Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="font-bold text-primary flex items-center gap-2">
                                                <span>@(string.IsNullOrWhiteSpace(u.NombreCompleto) ? "Sin nombre" : u.NombreCompleto)</span>
                                                @if (esYo)
                                                {
                                                    <span class="text-[9px] bg-secondary-fixed text-on-secondary-fixed px-1.5 py-0.5 rounded font-bold uppercase">Tú</span>
                                                }
                                            </div>
                                            <div class="text-[10px] text-text-muted font-mono">ID: @u.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-mono text-primary font-medium">@u.Email</div>
                                    <div class="mt-1 flex items-center gap-1.5">
                                        @if (u.EmailVerificado)
                                        {
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                                <span class="material-symbols-outlined text-[12px]">verified</span>
                                                Verificado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                                                <span class="material-symbols-outlined text-[12px]">schedule</span>
                                                Pendiente OTP
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    @if (u.Rol == "ADMIN")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-black bg-purple-100 text-purple-800 border border-purple-300">
                                            <span class="material-symbols-outlined text-[13px]">shield_person</span>
                                            ADMIN
                                        </span>
                                    }
                                    else if (u.Rol == "OPERADOR")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-100 text-blue-800 border border-blue-300">
                                            <span class="material-symbols-outlined text-[13px]">badge</span>
                                            OPERADOR
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                                            <span class="material-symbols-outlined text-[13px]">person</span>
                                            CLIENTE
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    <form asp-action="AsignarRol" method="post" class="flex items-center gap-2">
                                        <input type="hidden" name="email" value="@u.Email" />
                                        <select name="nuevoRol" class="bg-surface-white border border-border-subtle rounded-xl px-2.5 py-1.5 text-xs text-primary font-semibold outline-none focus:border-secondary">
                                            <option value="CLIENTE" selected="@(u.Rol == "CLIENTE" ? "selected" : null)">CLIENTE</option>
                                            <option value="OPERADOR" selected="@(u.Rol == "OPERADOR" ? "selected" : null)">OPERADOR</option>
                                            <option value="ADMIN" selected="@(u.Rol == "ADMIN" ? "selected" : null)">ADMIN</option>
                                        </select>
                                        <button type="submit" class="bg-primary hover:opacity-90 text-on-primary font-semibold text-xs px-3 py-1.5 rounded-xl transition-all shadow-sm active:scale-95">
                                            Guardar
                                        </button>
                                    </form>
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <a href="/Vision360?email=@Uri.EscapeDataString(u.Email)" class="inline-flex items-center gap-1 text-xs font-semibold text-secondary hover:underline">
                                        <span class="material-symbols-outlined text-[15px]">visibility</span>
                                        Visión 360
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
