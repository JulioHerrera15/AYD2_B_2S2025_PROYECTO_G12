@{
    ViewData["Title"] = "Visión 360 del Cliente";
    var cliente = ViewBag.TargetCliente as string ?? "";
    var historial = ViewBag.Historial as SgoLogic.Web.Services.HistorialClienteModel;
    var carrito = ViewBag.Carrito as SgoLogic.Web.Services.CarritoModel;
    var incidencias = ViewBag.Incidencias as List<SgoLogic.Web.Services.IncidenciaModel> ?? new();
    var infoUsuario = ViewBag.InfoUsuario as SgoLogic.Web.Services.UsuarioDto;
    var latenciaMs = ViewBag.LatenciaMs as long? ?? 12L;

    var totalOrdenes = historial?.Ordenes?.Count ?? 0;
    var totalGastado = historial?.Ordenes?.Sum(o => o.Total) ?? 0m;
    string canalHabitual = totalOrdenes > 0 ? "Omnicanal (Web & POS)" : "Sin compras registradas";
    var rolCliente = infoUsuario?.Rol ?? "CLIENTE";
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header with Search -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">support_agent</span>
                Portal de Soporte &bull; Call Center Omnicanal
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Visión 360 del Cliente</h1>
            <p class="text-xs sm:text-sm text-text-muted">Consulta consolidada de compras, estados en caliente, carritos en Redis e incidencias post-venta.</p>
        </div>

        <form asp-action="Index" method="get" class="flex items-center gap-2">
            <div class="relative flex items-center bg-surface-white rounded-xl border border-border-subtle focus-within:border-secondary p-1 pl-3 ambient-shadow">
                <span class="material-symbols-outlined text-text-muted text-[19px]">search</span>
                <input type="text" name="email" value="@cliente" placeholder="Buscar por email o ID..."
                       class="px-2 py-1.5 text-xs bg-transparent border-none outline-none text-primary placeholder:text-text-muted w-48 sm:w-60" />
            </div>
            <button type="submit" class="bg-primary text-on-primary text-xs font-semibold px-4 py-2 rounded-xl hover:opacity-90 active:scale-95 transition-all">
                Buscar
            </button>
        </form>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 text-emerald-800 border border-emerald-200 p-4 rounded-2xl flex items-center gap-2.5 text-xs font-medium ambient-shadow">
            <span class="material-symbols-outlined text-emerald-600 text-[18px]">check_circle</span>
            <span>@TempData["Exito"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container border border-error/20 p-4 rounded-2xl flex items-center gap-2.5 text-xs font-medium ambient-shadow">
            <span class="material-symbols-outlined text-error text-[18px]">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(cliente))
    {
        <!-- Client Profile Bento Header -->
        <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-border-subtle/60 ambient-shadow">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-border-subtle/50">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-secondary text-white font-bold text-2xl flex items-center justify-center shadow-md">
                        @(cliente.Length > 0 ? cliente.Substring(0, 1).ToUpper() : "C")
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <h2 class="text-xl font-bold text-primary">@cliente</h2>
                            <span class="bg-surface-container-low text-primary text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-border-subtle flex items-center gap-1 uppercase">
                                <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">badge</span>
                                Rol: @rolCliente
                            </span>
                        </div>
                        <div class="flex flex-wrap items-center gap-3 text-xs text-text-muted">
                            <span>ID / Email: <strong class="text-primary font-mono">@cliente</strong></span>
                            @if (infoUsuario != null && !string.IsNullOrWhiteSpace(infoUsuario.NombreCompleto))
                            {
                                <span>&bull;</span>
                                <span>Nombre: <strong class="text-primary">@infoUsuario.NombreCompleto</strong></span>
                            }
                            <span>&bull;</span>
                            <span>Canal Habitual: <strong class="text-primary">@canalHabitual</strong></span>
                            <span>&bull;</span>
                            <span>Estado de Cuenta: <strong class="text-emerald-700 font-semibold">@(infoUsuario?.EmailVerificado == true ? "Verificada (OTP)" : "Activa")</strong></span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5">
                    <a href="/Incidencias/Crear"
                       class="bg-surface-container-low text-primary px-4 py-2 rounded-xl text-xs font-semibold hover:bg-surface-variant transition-colors border border-border-subtle/60 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">report_problem</span>
                        Abrir Incidencia
                    </a>
                    <a href="/Pos?busqueda=@cliente"
                       class="bg-primary text-on-primary px-4 py-2 rounded-xl text-xs font-semibold hover:opacity-90 active:scale-95 transition-all flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">point_of_sale</span>
                        Recuperar en POS
                    </a>
                </div>
            </div>

            <!-- 4 Core KPIs -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6">
                <div class="p-4 rounded-2xl bg-surface-container-low/50 border border-border-subtle/40">
                    <span class="text-xs text-text-muted block mb-1">Valor Total de Compras (LTV)</span>
                    <div class="text-xl font-bold text-primary">Q @totalGastado.ToString("N2")</div>
                    <span class="text-[11px] text-text-muted">Total histórico acumulado</span>
                </div>
                <div class="p-4 rounded-2xl bg-surface-container-low/50 border border-border-subtle/40">
                    <span class="text-xs text-text-muted block mb-1">Órdenes Realizadas</span>
                    <div class="text-xl font-bold text-primary">@totalOrdenes pedidos</div>
                    <span class="text-[11px] text-text-muted">Modelo de lectura CQRS</span>
                </div>
                <div class="p-4 rounded-2xl bg-surface-container-low/50 border border-border-subtle/40">
                    <span class="text-xs text-text-muted block mb-1">Carrito Activo en Redis</span>
                    <div class="text-xl font-bold text-secondary">
                        @(carrito?.Items?.Count ?? 0) artículos
                    </div>
                    <span class="text-[11px] text-text-muted">Clave en Redis (TTL 72h)</span>
                </div>
                <div class="p-4 rounded-2xl bg-surface-container-low/50 border border-border-subtle/40">
                    <span class="text-xs text-text-muted block mb-1">Latencia de Consulta</span>
                    <div class="text-xl font-bold text-primary">@latenciaMs ms</div>
                    <span class="text-[11px] text-secondary font-medium">Medición en tiempo real</span>
                </div>
            </div>

            <!-- Asignacion de Rol Oficial del Usuario -->
            <div class="mt-6 pt-5 border-t border-border-subtle/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-surface-container-low text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-primary block">Gestión de Rol en el Sistema</span>
                        <span class="text-[11px] text-text-muted">Asigna roles oficiales (CLIENTE, OPERADOR, ADMIN). No se permiten roles ficticios.</span>
                    </div>
                </div>

                <form asp-action="AsignarRol" method="post" class="flex items-center gap-2">
                    <input type="hidden" name="email" value="@cliente" />
                    <select name="nuevoRol" class="bg-surface-container-low border border-border-subtle rounded-xl px-3 py-1.5 text-xs font-semibold text-primary focus:bg-surface-white focus:outline-none">
                        <option value="CLIENTE" selected="@(rolCliente == "CLIENTE")">CLIENTE</option>
                        <option value="OPERADOR" selected="@(rolCliente == "OPERADOR")">OPERADOR</option>
                        <option value="ADMIN" selected="@(rolCliente == "ADMIN")">ADMIN</option>
                    </select>
                    <button type="submit" class="bg-primary text-on-primary text-xs font-semibold px-3 py-1.5 rounded-xl hover:opacity-90 active:scale-95 transition-all">
                        Asignar Rol
                    </button>
                </form>
            </div>
        </div>


        <!-- Navigation Tabs -->
        <div class="flex items-center gap-2 border-b border-border-subtle pb-2 text-sm font-semibold">
            <button onclick="showTab('tab-ordenes')" id="btn-tab-ordenes" class="px-4 py-2 rounded-xl bg-primary text-on-primary transition-all text-xs">
                Historial de Órdenes (@totalOrdenes)
            </button>
            <button onclick="showTab('tab-carrito')" id="btn-tab-carrito" class="px-4 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low transition-all text-xs">
                Carrito Activo en Redis (@(carrito?.Items?.Count ?? 0))
            </button>
            <button onclick="showTab('tab-incidencias')" id="btn-tab-incidencias" class="px-4 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low transition-all text-xs">
                Incidencias (@incidencias.Count)
            </button>
            <button onclick="showTab('tab-notificaciones')" id="btn-tab-notificaciones" class="px-4 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low transition-all text-xs">
                Notificaciones
            </button>
        </div>

        <!-- Tab 1: Orders History -->
        <div id="tab-ordenes" class="space-y-4">
            @if (historial?.Ordenes != null && historial.Ordenes.Count > 0)
            {
                <div class="bg-surface-white rounded-3xl border border-border-subtle/60 overflow-hidden ambient-shadow">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-surface-container-low border-b border-border-subtle text-text-muted font-semibold uppercase text-[10px] tracking-wider">
                            <tr>
                                <th class="py-3.5 px-5">Número de Orden</th>
                                <th class="py-3.5 px-4">Estado en Vivo</th>
                                <th class="py-3.5 px-4">Total</th>
                                <th class="py-3.5 px-4">Última Actualización</th>
                                <th class="py-3.5 px-4 text-right">Acción</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-subtle/50">
                            @foreach (var ord in historial.Ordenes)
                            {
                                <tr class="hover:bg-surface-container-low/40 transition-colors">
                                    <td class="py-4 px-5 font-mono font-bold text-primary">@ord.NumeroOrden</td>
                                    <td class="py-4 px-4">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold
                                            @(ord.Estado == "ENTREGADA" ? "bg-green-100 text-green-800" :
                                              ord.Estado == "CONFIRMADA" ? "bg-blue-100 text-blue-800" :
                                              ord.Estado == "EN_TRANSITO" ? "bg-purple-100 text-purple-800" : "bg-gray-100 text-gray-800")">
                                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                            @ord.Estado
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 font-bold text-primary">Q @ord.Total.ToString("N2")</td>
                                    <td class="py-4 px-4 text-text-muted">@FechaHelper.Formatear(ord.CreadaEn ?? ord.ActualizadaEn)</td>
                                    <td class="py-4 px-4 text-right">
                                        <a href="/Estado?ordenId=@ord.OrdenId" class="text-secondary font-semibold hover:underline">
                                            Detalle CQRS &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="bg-surface-white rounded-3xl p-8 border border-border-subtle/60 text-center ambient-shadow">
                    <span class="material-symbols-outlined text-4xl text-text-muted mb-2">inventory_2</span>
                    <p class="text-xs text-text-muted">El cliente no tiene órdenes de compra registradas en el sistema.</p>
                </div>
            }
        </div>

        <!-- Tab 2: Cart in Redis -->
        <div id="tab-carrito" class="hidden space-y-4">
            @if (carrito?.Items != null && carrito.Items.Count > 0)
            {
                <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                    <div class="flex items-center justify-between pb-4 border-b border-border-subtle/50 mb-4">
                        <div class="text-sm font-bold text-primary">Artículos Almacenados en Clave Redis: <code class="text-xs font-mono text-secondary">carrito:@cliente</code></div>
                        <span class="text-xs text-text-muted">TTL: 72 horas restantes</span>
                    </div>
                    <div class="divide-y divide-border-subtle/40">
                        @foreach (var it in carrito.Items)
                        {
                            <div class="py-3 flex items-center justify-between text-xs">
                                <div>
                                    <span class="font-semibold text-primary block">@it.Descripcion</span>
                                    <span class="text-text-muted font-mono text-[11px]">@it.Sku &bull; Cantidad: @it.Cantidad</span>
                                </div>
                                <span class="font-bold text-primary text-sm">Q @it.Subtotal.ToString("N2")</span>
                            </div>
                        }
                    </div>
                    <div class="mt-4 pt-4 border-t border-border-subtle/50 flex justify-between items-center">
                        <span class="font-bold text-sm text-primary">Total en Carrito:</span>
                        <span class="font-bold text-base text-primary">Q @carrito.Total.ToString("N2")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-surface-white rounded-3xl p-8 border border-border-subtle/60 text-center ambient-shadow">
                    <span class="material-symbols-outlined text-4xl text-text-muted mb-2">shopping_bag</span>
                    <p class="text-xs text-text-muted">El cliente no tiene un carrito activo en memoria Redis en este momento.</p>
                </div>
            }
        </div>

        <!-- Tab 3: Incidencias -->
        <div id="tab-incidencias" class="hidden space-y-4">
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <div class="flex items-center justify-between pb-4 border-b border-border-subtle/50 mb-4">
                    <h3 class="text-sm font-bold text-primary">Incidencias y Reclamaciones de Servicio</h3>
                    <a href="/Incidencias/Crear" class="text-xs bg-primary text-on-primary px-3 py-1.5 rounded-lg font-semibold hover:opacity-90">
                        + Nueva Incidencia
                    </a>
                </div>
                @if (incidencias != null && incidencias.Count > 0)
                {
                    <div class="space-y-3">
                        @foreach (var inc in incidencias)
                        {
                            var badgeClass = inc.Estado switch
                            {
                                "ABIERTA" => "bg-amber-100 text-amber-800",
                                "EN_INVESTIGACION" => "bg-blue-100 text-blue-800",
                                "RESUELTA" => "bg-green-100 text-green-800",
                                _ => "bg-gray-100 text-gray-800"
                            };
                            <div class="p-4 rounded-xl bg-surface-container-low border border-border-subtle/40 flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="@badgeClass text-[10px] font-bold px-2 py-0.5 rounded">@inc.Estado</span>
                                        <span class="font-mono text-xs font-bold text-primary">@inc.Id.ToString().Substring(0, 8)...</span>
                                        <span class="text-text-muted text-[11px]">&bull; Orden @inc.OrdenId</span>
                                    </div>
                                    <p class="text-xs text-on-surface-variant">@inc.Descripcion</p>
                                    @if (!string.IsNullOrWhiteSpace(inc.Resolucion))
                                    {
                                        <p class="text-[11px] text-green-700 mt-1 font-medium">Resolución: @inc.Resolucion</p>
                                    }
                                </div>
                                <span class="text-[11px] text-text-muted whitespace-nowrap">@FechaHelper.Formatear(inc.CreadaEn)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-6 text-center text-xs text-text-muted">
                        <span class="material-symbols-outlined text-3xl text-emerald-600 mb-1">task_alt</span>
                        <p>No se registran incidencias activas para este cliente.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Tab 4: Notificaciones Omnicanal -->
        <div id="tab-notificaciones" class="hidden space-y-4">
            <div class="bg-surface-white rounded-3xl p-6 border border-border-subtle/60 ambient-shadow">
                <h3 class="text-sm font-bold text-primary mb-4">Registro de Notificaciones Entregadas</h3>
                @if (historial?.Ordenes != null && historial.Ordenes.Count > 0)
                {
                    <div class="space-y-3 text-xs">
                        @foreach (var ord in historial.Ordenes.Take(4))
                        {
                            <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low border border-border-subtle/40">
                                <div class="flex items-center gap-3">
                                    <span class="material-symbols-outlined text-secondary text-[20px]">sms</span>
                                    <div>
                                        <span class="font-semibold text-primary block">SMS / Correo Transaccional — Orden @ord.NumeroOrden</span>
                                        <span class="text-text-muted text-[11px]">Estado actual sincronizado: @ord.Estado. Notificación despachada por broker RabbitMQ.</span>
                                    </div>
                                </div>
                                <span class="text-green-700 font-semibold text-[11px]">Entregado</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-6 text-center text-xs text-text-muted">
                        <span class="material-symbols-outlined text-3xl text-text-muted mb-1">notifications_off</span>
                        <p>No hay eventos de notificación para este cliente.</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="bg-surface-white rounded-3xl p-12 border border-border-subtle/60 text-center ambient-shadow max-w-xl mx-auto">
            <div class="w-16 h-16 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[32px]">support_agent</span>
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">Consulta de Cliente 360°</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-6">
                Ingresa arriba el correo o identificador del cliente para cargar su expediente consolidado: historial de órdenes CQRS, carritos activos en Redis e incidencias abiertas.
            </p>
        </div>
    }
</div>

<script>
    function showTab(tabId) {
        const tabs = ['tab-ordenes', 'tab-carrito', 'tab-incidencias', 'tab-notificaciones'];
        tabs.forEach(id => {
            const el = document.getElementById(id);
            const btn = document.getElementById('btn-' + id);
            if (el && btn) {
                if (id === tabId) {
                    el.classList.remove('hidden');
                    btn.classList.add('bg-primary', 'text-on-primary');
                    btn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low');
                } else {
                    el.classList.add('hidden');
                    btn.classList.remove('bg-primary', 'text-on-primary');
                    btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low');
                }
            }
        });
    }
</script>
