@model SgoLogic.Web.Controllers.DespachoViewModel
@{
    ViewData["Title"] = "Centro de Control - Despacho Logístico";
    var filtro = Model?.Filtro ?? "TODOS";
    var ubicacionActiva = (ViewBag.UbicacionId as string) ?? "TODAS";
}

<div class="w-full max-w-container-max mx-auto flex flex-col gap-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border-subtle">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                LogiExpress &bull; Centro de Distribución Central
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">Centro de Control — Despacho Logístico</h1>
            <p class="text-xs sm:text-sm text-text-muted">Supervisión en tiempo real de preparación de pedidos, envíos con LogiExpress y entregas en tienda.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-green-100 text-green-800 border border-green-200">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                Hub Logístico Activo
            </span>
        </div>
    </div>

    <!-- 4 KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-5 rounded-3xl bg-surface-white border border-border-subtle/60 ambient-shadow">
            <div class="flex items-center justify-between text-text-muted mb-2">
                <span class="text-xs font-semibold">Despachos Totales</span>
                <span class="material-symbols-outlined text-[20px]">package_2</span>
            </div>
            <div class="text-2xl font-bold text-primary mb-1">@(Model?.TotalDespachos ?? 0)</div>
            <span class="text-[11px] text-text-muted">En cola de ubicación</span>
        </div>

        <div class="p-5 rounded-3xl bg-surface-white border border-border-subtle/60 ambient-shadow">
            <div class="flex items-center justify-between text-amber-600 mb-2">
                <span class="text-xs font-semibold">En Preparación</span>
                <span class="material-symbols-outlined text-[20px]">pending_actions</span>
            </div>
            <div class="text-2xl font-bold text-amber-600 mb-1">@(Model?.EnPreparacion ?? 0)</div>
            <span class="text-[11px] text-text-muted">Picking y embalaje</span>
        </div>

        <div class="p-5 rounded-3xl bg-surface-white border border-border-subtle/60 ambient-shadow">
            <div class="flex items-center justify-between text-purple-600 mb-2">
                <span class="text-xs font-semibold">En Tránsito (LogiExpress)</span>
                <span class="material-symbols-outlined text-[20px]">local_shipping</span>
            </div>
            <div class="text-2xl font-bold text-purple-600 mb-1">@(Model?.EnTransito ?? 0)</div>
            <span class="text-[11px] text-text-muted">Ruta de distribución</span>
        </div>

        <div class="p-5 rounded-3xl bg-surface-white border border-border-subtle/60 ambient-shadow">
            <div class="flex items-center justify-between text-green-600 mb-2">
                <span class="text-xs font-semibold">Entregados / Listos</span>
                <span class="material-symbols-outlined text-[20px]">check_circle</span>
            </div>
            <div class="text-2xl font-bold text-green-600 mb-1">@(Model?.Entregados ?? 0)</div>
            <span class="text-[11px] text-green-700 font-medium">Completados</span>
        </div>
    </div>


    <!-- Filters and Search -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex p-1 bg-surface-container-low rounded-2xl border border-border-subtle">
                <a href="/Despacho?filtro=TODOS&ubicacionId=@ubicacionActiva"
                   class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 @(filtro == "TODOS" ? "bg-primary text-on-primary shadow-xs" : "text-text-muted hover:text-primary")">
                    <span>Todos</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px] @(filtro == "TODOS" ? "bg-white/20 text-white" : "bg-surface-container text-text-muted") font-bold">
                        @(Model?.TotalDespachos ?? 0)
                    </span>
                </a>
                <a href="/Despacho?filtro=DOMICILIO&ubicacionId=@ubicacionActiva"
                   class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 @(filtro == "DOMICILIO" ? "bg-primary text-on-primary shadow-xs" : "text-text-muted hover:text-primary")">
                    <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                    <span>Domicilio</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px] @(filtro == "DOMICILIO" ? "bg-white/20 text-white" : "bg-surface-container text-text-muted") font-bold">
                        @(Model?.ConteoDomicilio ?? 0)
                    </span>
                </a>
                <a href="/Despacho?filtro=RECOGIDA_TIENDA&ubicacionId=@ubicacionActiva"
                   class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 @(filtro == "RECOGIDA_TIENDA" ? "bg-primary text-on-primary shadow-xs" : "text-text-muted hover:text-primary")">
                    <span class="material-symbols-outlined text-[14px]">storefront</span>
                    <span>Tienda</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px] @(filtro == "RECOGIDA_TIENDA" ? "bg-white/20 text-white" : "bg-surface-container text-text-muted") font-bold">
                        @(Model?.ConteoTienda ?? 0)
                    </span>
                </a>
            </div>

            <!-- Selector de Sede / Ubicacion -->
            <div class="inline-flex items-center gap-1.5 bg-surface-white px-3 py-1.5 rounded-2xl border border-border-subtle text-xs">
                <span class="material-symbols-outlined text-[16px] text-text-muted">warehouse</span>
                <span class="text-text-muted font-medium">Sede:</span>
                <a href="/Despacho?filtro=@filtro&ubicacionId=TODAS" class="px-2 py-0.5 rounded-lg font-semibold @(ubicacionActiva == "TODAS" ? "bg-secondary text-white" : "text-text-muted hover:text-primary")">Todas</a>
                <a href="/Despacho?filtro=@filtro&ubicacionId=CD-01" class="px-2 py-0.5 rounded-lg font-semibold @(ubicacionActiva == "CD-01" ? "bg-secondary text-white" : "text-text-muted hover:text-primary")">CD-01</a>
                <a href="/Despacho?filtro=@filtro&ubicacionId=TIENDA-01-CENTRAL" class="px-2 py-0.5 rounded-lg font-semibold @(ubicacionActiva == "TIENDA-01-CENTRAL" ? "bg-secondary text-white" : "text-text-muted hover:text-primary")">Tienda Central</a>
            </div>
        </div>
        <div class="text-xs text-text-muted">
            Mostrando <strong>@(Model?.Items?.Count ?? 0)</strong> envíos según filtros
        </div>
    </div>

    <!-- Shipments Table -->
    <div class="bg-surface-white rounded-3xl border border-border-subtle/60 overflow-hidden ambient-shadow">
        @if (Model?.Items != null && Model.Items.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-surface-container-low border-b border-border-subtle text-text-muted font-semibold uppercase text-[10px] tracking-wider">
                        <tr>
                            <th class="py-3.5 px-5">ID Despacho</th>
                            <th class="py-3.5 px-4">Orden Relacionada</th>
                            <th class="py-3.5 px-4">Destino / Ubicación</th>
                            <th class="py-3.5 px-4">Método</th>
                            <th class="py-3.5 px-4">Transportista</th>
                            <th class="py-3.5 px-4">Estado</th>
                            <th class="py-3.5 px-4 text-right">Detalle</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle/50">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-surface-container-low/40 transition-colors">
                                <td class="py-4 px-5 font-mono font-bold text-primary">@item.IdDespacho</td>
                                <td class="py-4 px-4 font-mono text-secondary font-semibold">@item.OrdenId</td>
                                <td class="py-4 px-4 font-medium text-primary">@item.Destino</td>
                                <td class="py-4 px-4">
                                    <span class="inline-flex items-center gap-1.5 font-semibold text-primary">
                                        <span class="material-symbols-outlined text-[16px] text-secondary">@item.MetodoIcon</span>
                                        @item.MetodoLabel
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="font-semibold text-primary">@item.Transportista</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Guia))
                                    {
                                        <span class="text-[10px] font-mono text-text-muted block">@item.Guia</span>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold @item.EstadoBadgeClass">
                                        @item.EstadoLabel
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (item.PuedeEnviarARuta)
                                        {
                                            <form method="post" action="/Despacho/ActualizarEstado" class="inline">
                                                <input type="hidden" name="ordenId" value="@item.OrdenId" />
                                                <input type="hidden" name="nuevoEstado" value="@(item.Metodo == "RECOGIDA_TIENDA" ? "LISTA_PARA_RECOGER" : "EN_TRANSITO")" />
                                                <input type="hidden" name="detalle" value="Despacho enviado a ruta" />
                                                <button type="submit" class="inline-flex items-center gap-1 bg-secondary text-white text-[10px] font-semibold px-2.5 py-1 rounded-lg hover:opacity-90 transition-all shadow-2xs cursor-pointer" title="Avanzar estado logístico">
                                                    <span class="material-symbols-outlined text-[13px]">local_shipping</span>
                                                    <span>@(item.Metodo == "RECOGIDA_TIENDA" ? "Listo Tienda" : "A Ruta")</span>
                                                </button>
                                            </form>
                                        }
                                        else if (item.Estado == "EN_TRANSITO" || item.Estado == "LISTA_PARA_RECOGER")
                                        {
                                            <form method="post" action="/Despacho/ActualizarEstado" class="inline">
                                                <input type="hidden" name="ordenId" value="@item.OrdenId" />
                                                <input type="hidden" name="nuevoEstado" value="ENTREGADA" />
                                                <input type="hidden" name="detalle" value="Paquete entregado exitosamente" />
                                                <button type="submit" class="inline-flex items-center gap-1 bg-emerald-600 text-white text-[10px] font-semibold px-2.5 py-1 rounded-lg hover:opacity-90 transition-all shadow-2xs cursor-pointer" title="Marcar como entregado">
                                                    <span class="material-symbols-outlined text-[13px]">task_alt</span>
                                                    <span>Entregar</span>
                                                </button>
                                            </form>
                                        }

                                        <a href="/Estado?ordenId=@item.OrdenId" class="text-text-muted hover:text-primary font-semibold inline-flex items-center gap-0.5 p-1" title="Ver monitoreo de la orden">
                                            <span class="material-symbols-outlined text-[16px]">visibility</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-12 px-6 text-center">
                <div class="w-12 h-12 rounded-full bg-surface-container-low text-text-muted flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-[26px]">inbox</span>
                </div>
                <h4 class="text-sm font-semibold text-primary mb-1">No hay despachos para este filtro</h4>
                <p class="text-xs text-text-muted">Prueba seleccionando "Todos los Envíos" arriba.</p>
            </div>
        }
    </div>
</div>
