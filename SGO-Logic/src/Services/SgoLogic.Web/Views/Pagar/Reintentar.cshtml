@model SgoLogic.Web.Services.EnlaceReintentoInfoModel?
@{
    ViewData["Title"] = "Reintento de Pago Seguro - MegaStore";
    var error = ViewBag.Error as string;
    var advertencia = ViewBag.Advertencia as string;
    var token = ViewBag.Token as string ?? Model?.Token;
}

<div class="max-w-2xl mx-auto py-8 px-4 sm:px-6">
    <!-- Encabezado de Seguridad -->
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low text-primary text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="material-symbols-outlined text-sm">lock</span>
            <span>Pasarela Segura de Pagos Omnicanal</span>
        </div>
        <h1 class="text-3xl font-extrabold text-primary tracking-tight">Reintento de Cobro</h1>
        <p class="text-sm text-text-muted mt-2">Completa el pago de tu orden de forma segura y directa</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <!-- Mensaje de Error -->
        <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-6">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-red-600 text-2xl mt-0.5">error</span>
                <div class="flex-1">
                    <h3 class="text-sm font-bold text-red-900">No se pudo procesar el enlace</h3>
                    <p class="text-xs text-red-700 mt-1">@error</p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <a href="/Estado" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-red-200 text-red-800 text-xs font-semibold hover:bg-red-50 transition-colors">
                            <span class="material-symbols-outlined text-sm">search</span>
                            <span>Consultar Estado de Orden</span>
                        </a>
                        <a href="/" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-border-subtle text-primary text-xs font-semibold hover:bg-surface-container-low transition-colors">
                            <span class="material-symbols-outlined text-sm">storefront</span>
                            <span>Ir al Catálogo</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(advertencia))
    {
        <!-- Mensaje de Advertencia Transitoria -->
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-6">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-amber-600 text-2xl mt-0.5">warning</span>
                <div class="flex-1">
                    <h3 class="text-sm font-bold text-amber-900">Atención en el procesamiento</h3>
                    <p class="text-xs text-amber-800 mt-1">@advertencia</p>
                </div>
            </div>
        </div>
    }

    @if (Model != null)
    {
        @if (string.Equals(Model.EstadoPago, "APLICADO", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Orden Ya Pagada Exitosamente -->
            <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-emerald-200/80 ambient-shadow mb-6 text-center">
                <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-4xl">check_circle</span>
                </div>
                <h3 class="text-xl font-extrabold text-primary mb-2">
                    Esta orden ya se encuentra pagada
                </h3>
                <p class="text-xs text-text-muted max-w-md mx-auto mb-6">
                    El cobro correspondiente a esta orden fue confirmado exitosamente. No se requiere ningún cargo adicional.
                </p>

                <div class="bg-surface-container-low rounded-2xl p-5 max-w-md mx-auto mb-6 text-left space-y-2.5 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Orden Asociada:</span>
                        <span class="font-mono font-bold text-primary">@Model.OrdenId</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Monto Pagado:</span>
                        <span class="font-bold text-emerald-700 font-mono text-sm">@Model.Moneda @Model.Monto.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Estado del Pago:</span>
                        <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            <span>APLICADO</span>
                        </span>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    <a href="/Estado/Comprobante?ordenId=@Model.OrdenId" class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-full text-xs font-bold shadow-sm hover:opacity-95 transition-all">
                        <span class="material-symbols-outlined text-base">receipt_long</span>
                        <span>Ver Comprobante Digital</span>
                    </a>
                    <a href="/Estado?ordenId=@Model.OrdenId" class="inline-flex items-center gap-2 bg-white border border-border-subtle text-primary px-6 py-3 rounded-full text-xs font-bold hover:bg-surface-container-low transition-all">
                        <span class="material-symbols-outlined text-base">visibility</span>
                        <span>Ver Estado de la Orden</span>
                    </a>
                </div>
            </div>
        }
        else if (string.Equals(Model.EstadoPago, "RECHAZADO", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Cobro Rechazado Definitivo -->
            <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-red-200/80 ambient-shadow mb-6 text-center">
                <div class="w-16 h-16 rounded-full bg-red-100 text-red-700 flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-4xl">cancel</span>
                </div>
                <h3 class="text-xl font-extrabold text-primary mb-2">
                    Cobro Rechazado
                </h3>
                <p class="text-xs text-text-muted max-w-md mx-auto mb-6">
                    La pasarela de pagos rechazó el intento de cobro con el medio registrado. Consulta el estado de tu orden para más detalles.
                </p>

                <div class="bg-surface-container-low rounded-2xl p-5 max-w-md mx-auto mb-6 text-left space-y-2.5 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Orden Asociada:</span>
                        <span class="font-mono font-bold text-primary">@Model.OrdenId</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Monto:</span>
                        <span class="font-bold text-primary">@Model.Moneda @Model.Monto.ToString("N2")</span>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    <a href="/Estado?ordenId=@Model.OrdenId" class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-full text-xs font-bold shadow-sm hover:opacity-95 transition-all">
                        <span class="material-symbols-outlined text-base">visibility</span>
                        <span>Consultar Estado de la Orden</span>
                    </a>
                </div>
            </div>
        }
        else if (Model.Usado || !Model.EstaVigente)
        {
            <!-- Enlace Vencido o Ya Utilizado -->
            <div class="bg-surface-white rounded-2xl p-6 border border-border-subtle ambient-shadow mb-6 text-center">
                <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-3xl">schedule</span>
                </div>
                <h3 class="text-lg font-bold text-primary mb-2">
                    @(Model.Usado ? "Este enlace ya fue utilizado" : "Este enlace ha expirado")
                </h3>
                <p class="text-xs text-text-muted max-w-md mx-auto mb-6">
                    @(Model.Usado
                        ? "El pago asociado a este enlace ya fue procesado o se registró un intento previo con este token de seguridad."
                        : "Por motivos de seguridad, los enlaces de reintento tienen un tiempo de validez limitado.")
                </p>

                <div class="bg-surface-container-low rounded-xl p-4 max-w-sm mx-auto mb-6 text-left space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Orden Asociada:</span>
                        <span class="font-mono font-bold text-primary">@Model.OrdenId</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Monto:</span>
                        <span class="font-bold text-primary">@Model.Moneda @Model.Monto.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Expiración:</span>
                        <span class="text-text-muted">@FechaHelper.Formatear(Model.ExpiraEn)</span>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    <a href="/Estado?ordenId=@Model.OrdenId" class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-full text-xs font-bold shadow-sm hover:opacity-95 transition-all">
                        <span class="material-symbols-outlined text-sm">visibility</span>
                        <span>Ver Estado Actual de la Orden</span>
                    </a>
                    <a href="/Estado/Comprobante?ordenId=@Model.OrdenId" class="inline-flex items-center gap-2 bg-white border border-border-subtle text-primary px-5 py-2.5 rounded-full text-xs font-bold hover:bg-surface-container-low transition-all">
                        <span class="material-symbols-outlined text-sm">receipt_long</span>
                        <span>Ver Comprobante</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Tarjeta de Cobro Vigente -->
            <div class="bg-surface-white rounded-3xl p-6 sm:p-8 border border-border-subtle/80 ambient-shadow mb-6">
                <!-- Estado y Alerta -->
                <div class="flex items-center justify-between pb-4 border-b border-border-subtle/60 mb-6">
                    <div>
                        <span class="text-xs text-text-muted block">Orden a Pagar</span>
                        <span class="text-lg font-bold font-mono text-primary">@Model.OrdenId</span>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Enlace Vigente</span>
                    </span>
                </div>

                <!-- Detalle Económico -->
                <div class="bg-surface-container-low rounded-2xl p-5 mb-6 space-y-3">
                    <div class="flex justify-between items-baseline">
                        <span class="text-xs text-text-muted font-medium">Total a Pagar</span>
                        <span class="text-2xl font-extrabold text-primary font-mono">
                            @Model.Moneda @Model.Monto.ToString("N2")
                        </span>
                    </div>

                    <div class="pt-3 border-t border-border-subtle/40 flex justify-between items-center text-xs">
                        <span class="text-text-muted">Medio de Pago Registrado:</span>
                        <span class="font-semibold text-primary inline-flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base text-text-muted">credit_card</span>
                            @(string.IsNullOrWhiteSpace(Model.Marca) ? "Tarjeta" : Model.Marca)
                            @(string.IsNullOrWhiteSpace(Model.UltimosCuatro) ? "" : $"•••• {Model.UltimosCuatro}")
                        </span>
                    </div>

                    <div class="flex justify-between items-center text-xs">
                        <span class="text-text-muted">Válido hasta:</span>
                        <span class="font-mono text-text-muted">
                            @FechaHelper.Formatear(Model.ExpiraEn)
                        </span>
                    </div>
                </div>

                <!-- Explicación al Cliente -->
                <div class="text-xs text-text-muted space-y-2 mb-6 leading-relaxed">
                    <p>
                        Tu orden se encuentra reservada. El intento anterior no pudo completarse debido a una respuesta no disponible o timeout momentáneo con la pasarela de pagos PayKlik.
                    </p>
                    <p class="font-medium text-primary">
                        Al presionar el botón inferior, se efectuará un reintento de cobro protegido por llave de idempotencia para garantizar que no existan cobros duplicados.
                    </p>
                </div>

                <!-- Formulario de Reintento -->
                <form asp-action="ProcesarReintento" method="post" id="form-reintentar" onsubmit="deshabilitarBoton()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@Model.Token" />

                    <button type="submit" id="btn-reintentar" class="w-full inline-flex items-center justify-center gap-2.5 bg-primary text-on-primary py-4 px-6 rounded-2xl font-bold text-sm shadow-md hover:opacity-95 active:scale-[0.99] transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-lg" id="icono-btn">check_circle</span>
                        <span id="texto-btn">Confirmar y Reintentar Cobro Ahora</span>
                    </button>
                </form>
            </div>
        }
    }

    <!-- Sellos de Confianza y Seguridad -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/40">
            <span class="material-symbols-outlined text-primary text-xl block mb-1">verified_user</span>
            <span class="text-[11px] font-bold text-primary block">Encriptación TLS 1.3</span>
            <span class="text-[10px] text-text-muted">Transacción bancaria segura</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/40">
            <span class="material-symbols-outlined text-primary text-xl block mb-1">receipt</span>
            <span class="text-[11px] font-bold text-primary block">Facturación SAT FEL</span>
            <span class="text-[10px] text-text-muted">Certificación tributaria inmediata</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/40">
            <span class="material-symbols-outlined text-primary text-xl block mb-1">shield</span>
            <span class="text-[11px] font-bold text-primary block">Idempotencia Garantizada</span>
            <span class="text-[10px] text-text-muted">Protección anti-duplicados</span>
        </div>
    </div>
</div>

<script>
    function deshabilitarBoton() {
        const btn = document.getElementById('btn-reintentar');
        const icono = document.getElementById('icono-btn');
        const texto = document.getElementById('texto-btn');
        if (btn) {
            setTimeout(() => {
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
                if (icono) {
                    icono.innerText = 'progress_activity';
                    icono.classList.add('animate-spin');
                }
                if (texto) {
                    texto.innerText = 'Procesando cobro seguro...';
                }
            }, 10);
        }
    }
</script>
