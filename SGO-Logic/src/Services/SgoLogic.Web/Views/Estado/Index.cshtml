@model SgoLogic.Web.Services.OrdenEstadoModel?
@{
    var isStaff = (bool)(ViewBag.IsStaff ?? false);
    ViewData["Title"] = isStaff ? "Supervisión Global de Órdenes" : "Mis Pedidos & Rastreo de Guías";
    var despacho = ViewBag.Despacho as SgoLogic.Web.Services.DespachoOrdenModel;
    var tiendaOrigen = ViewBag.TiendaOrigen as string;
    var isAuthenticated = (bool)(ViewBag.IsAuthenticated ?? false);
    var userEmail = ViewBag.UserEmail as string;
    var historial = ViewBag.HistorialDespachos as List<SgoLogic.Web.Controllers.OrdenConDespachoItem>;
    var totalOrdenes = (int)(ViewBag.TotalOrdenes ?? (historial?.Count ?? 0));
    var buscar = ViewBag.Buscar as string;
    var filtro = ViewBag.Filtro as string ?? "TODOS";
    var reembolso = ViewBag.Reembolso as SgoLogic.Web.Services.ReembolsoOrdenVista;
    var notasCredito = ViewBag.NotasCredito as List<SgoLogic.Web.Services.FacturaModel> ?? new List<SgoLogic.Web.Services.FacturaModel>();
}

<!-- Header -->
<div class="mb-8">
    @if (isStaff)
    {
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">admin_panel_settings</span>
            Personal de Operaciones &bull; Supervisión Integral de Órdenes
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-2">
            Consola de Supervisión — Todas las Órdenes del Sistema
        </h1>
        <p class="text-xs sm:text-sm text-text-muted max-w-2xl">
            Monitoreo transaccional de todas las compras del sistema, correlativos, facturación SAT FEL y seguimiento de guías de despacho.
        </p>
    }
    else
    {
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold mb-2">
            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">shield</span>
            Privacidad Garantizada &bull; Trazabilidad Segura por Usuario
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-2">
            Mis Pedidos y Guías de Envío
        </h1>
        <p class="text-xs sm:text-sm text-text-muted max-w-2xl">
            Consulta el estado en tiempo real de tus compras, asignación de guías de despacho LogiExpress, certificación fiscal SAT FEL y seguimiento logístico.
        </p>
    }
</div>

@if (ViewBag.Error != null)
{
    <div class="mb-8 bg-error-container text-on-error-container border border-error/20 rounded-2xl p-4 flex items-center gap-3 ambient-shadow">
        <span class="material-symbols-outlined text-error" style="font-variation-settings: 'FILL' 1;">error</span>
        <div class="text-sm font-medium">@ViewBag.Error</div>
    </div>
}

@if (!isAuthenticated)
{
    <!-- Pantalla de Privacidad para Usuarios No Autenticados (Sin buscador arbitrario) -->
    <div class="bg-surface-white rounded-3xl ambient-shadow border border-border-subtle/50 p-8 md:p-12 text-center max-w-2xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-secondary-fixed/50 text-secondary flex items-center justify-center mx-auto mb-5 shadow-sm">
            <span class="material-symbols-outlined text-[34px]">lock</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-primary mb-3">
            Protección de Privacidad de Envíos
        </h2>
        <p class="text-xs sm:text-sm text-text-muted mb-6 leading-relaxed">
            Por estrictas políticas de protección de datos y privacidad de MegaStore, el rastreo de guías de envío y estados de compra es exclusivo para el titular de la cuenta. Inicia sesión para ver tu lista de pedidos y guías asociadas.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/Auth/Login?returnUrl=/Estado"
               class="w-full sm:w-auto bg-primary text-on-primary px-6 py-3 rounded-2xl text-xs sm:text-sm font-bold hover:opacity-90 transition-opacity active:scale-95 shadow-md flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[18px]">login</span>
                Iniciar Sesión
            </a>
            <a href="/Auth/Registro"
               class="w-full sm:w-auto bg-surface-container-low hover:bg-surface-container text-primary px-6 py-3 rounded-2xl text-xs sm:text-sm font-semibold transition-colors border border-border-subtle/60 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Crear Cuenta
            </a>
        </div>
    </div>
}
else if (Model == null)
{
    <!-- Listado de Pedidos y Guías -->
    <div class="bg-surface-white rounded-3xl ambient-shadow border border-border-subtle/50 p-6 md:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-border-subtle/60 gap-3">
            <div>
                <h2 class="text-lg sm:text-xl font-bold text-primary">
                    @(isStaff ? "Todas las Órdenes Registradas en MegaStore" : "Tus Compras y Envíos Registrados")
                </h2>
                <p class="text-xs text-text-muted">
                    @if (isStaff)
                    {
                        <span>Consola de supervisión global &bull; Mostrando <strong>@(historial?.Count ?? 0)</strong> de <strong>@totalOrdenes</strong> órdenes totales</span>
                    }
                    else
                    {
                        <span>Mostrando pedidos vinculados a <strong class="text-primary">@userEmail</strong></span>
                    }
                </p>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs text-text-muted font-medium">Sincronización en vivo</span>
            </div>
        </div>

        @if (isStaff)
        {
            <!-- Buscador y Filtros para Administradores -->
            <form method="get" action="/Estado" class="mb-5 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 p-3 bg-surface-container-low rounded-2xl border border-border-subtle/80">
                <div class="flex-1 flex items-center gap-2 bg-surface-white px-3 py-2 rounded-xl border border-border-subtle focus-within:border-secondary">
                    <span class="material-symbols-outlined text-text-muted text-[18px]">search</span>
                    <input type="text" name="buscar" value="@buscar" placeholder="Buscar por No. Orden, ID interno, correo o guía..." class="w-full text-xs bg-transparent border-0 focus:outline-none text-primary placeholder-text-muted/60" />
                    @if (!string.IsNullOrWhiteSpace(buscar))
                    {
                        <a href="/Estado?filtro=@filtro" class="text-text-muted hover:text-primary" title="Limpiar búsqueda">
                            <span class="material-symbols-outlined text-[16px]">close</span>
                        </a>
                    }
                </div>
                <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0">
                    <input type="hidden" name="filtro" value="@filtro" />
                    <button type="submit" class="px-4 py-2 bg-primary text-on-primary rounded-xl text-xs font-bold hover:opacity-90 transition-all flex items-center gap-1.5 flex-shrink-0 cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">filter_list</span>
                        Buscar
                    </button>
                    <a href="/Despacho" class="px-4 py-2 bg-secondary text-white rounded-xl text-xs font-bold hover:bg-secondary/90 transition-all flex items-center gap-1.5 flex-shrink-0">
                        <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                        Ir a Despacho
                    </a>
                </div>
            </form>

            <!-- Status Filter Chips -->
            <div class="flex flex-wrap items-center gap-1.5 mb-6">
                <a href="/Estado?filtro=TODOS@(string.IsNullOrWhiteSpace(buscar) ? "" : $"&buscar={buscar}")"
                   class="px-3 py-1 rounded-xl text-xs font-semibold transition-all @(filtro == "TODOS" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-text-muted hover:text-primary")">
                    Todas (@totalOrdenes)
                </a>
                <a href="/Estado?filtro=DESPACHO_SOLICITADO@(string.IsNullOrWhiteSpace(buscar) ? "" : $"&buscar={buscar}")"
                   class="px-3 py-1 rounded-xl text-xs font-semibold transition-all @(filtro == "DESPACHO_SOLICITADO" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-text-muted hover:text-primary")">
                    En Despacho
                </a>
                <a href="/Estado?filtro=EN_TRANSITO@(string.IsNullOrWhiteSpace(buscar) ? "" : $"&buscar={buscar}")"
                   class="px-3 py-1 rounded-xl text-xs font-semibold transition-all @(filtro == "EN_TRANSITO" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-text-muted hover:text-primary")">
                    En Tránsito
                </a>
                <a href="/Estado?filtro=ENTREGADA@(string.IsNullOrWhiteSpace(buscar) ? "" : $"&buscar={buscar}")"
                   class="px-3 py-1 rounded-xl text-xs font-semibold transition-all @(filtro == "ENTREGADA" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-text-muted hover:text-primary")">
                    Entregadas
                </a>
                <a href="/Estado?filtro=RECHAZADA@(string.IsNullOrWhiteSpace(buscar) ? "" : $"&buscar={buscar}")"
                   class="px-3 py-1 rounded-xl text-xs font-semibold transition-all @(filtro == "RECHAZADA" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-text-muted hover:text-primary")">
                    Rechazadas / Canceladas
                </a>
            </div>
        }

        @if (historial == null || !historial.Any())
        {
            <div class="py-12 text-center">
                <div class="w-14 h-14 rounded-2xl bg-surface-container text-text-muted flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-[30px]">local_mall</span>
                </div>
                <h3 class="text-base font-bold text-primary mb-1">
                    @(isStaff ? "No se encontraron órdenes registradas" : "No tienes pedidos registrados")
                </h3>
                <p class="text-xs text-text-muted max-w-sm mx-auto mb-5">
                    @(isStaff ? "No hay órdenes que coincidan con los filtros aplicados en la plataforma." : "Aún no has realizado ninguna compra con esta cuenta. Explora nuestro catálogo y realiza tu primer pedido.")
                </p>
                @if (isStaff)
                {
                    <a href="/Estado" class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-xl text-xs font-bold hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined text-[16px]">refresh</span>
                        Limpiar Filtros
                    </a>
                }
                else
                {
                    <a href="/Catalogo" class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-xl text-xs font-bold hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
                        Ir al Catálogo
                    </a>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-2xl border border-border-subtle/60">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-surface-bright/80 border-b border-border-subtle text-text-muted uppercase font-semibold text-[11px] tracking-wider">
                            <th class="py-3.5 px-4">Orden</th>
                            <th class="py-3.5 px-4">Fecha</th>
                            @if (isStaff)
                            {
                                <th class="py-3.5 px-4">Cliente</th>
                            }
                            <th class="py-3.5 px-4">Estado del Pedido</th>
                            <th class="py-3.5 px-4">Guía de Despacho</th>
                            <th class="py-3.5 px-4">Estado Envío</th>
                            <th class="py-3.5 px-4 text-right">Total</th>
                            <th class="py-3.5 px-4 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle/40">
                        @foreach (var item in historial)
                        {
                            var ord = item.Orden;
                            var desp = item.Despacho;
                            var badgeClass = ord.Estado switch
                            {
                                "CREADA" => "bg-blue-100 text-blue-800",
                                "COBRO_SOLICITADO" or "PAGO_PENDIENTE" or "EVALUACION_CREDITO_SOLICITADA" => "bg-amber-100 text-amber-800",
                                "PAGO_APLICADO" or "CREDITO_APROBADO" or "CONFIRMADA" => "bg-secondary-fixed text-on-secondary-fixed",
                                "DESPACHO_SOLICITADO" or "EN_PREPARACION" => "bg-purple-100 text-purple-800",
                                "EN_TRANSITO" => "bg-indigo-100 text-indigo-800",
                                "LISTA_PARA_RECOGER" or "ENTREGADA" => "bg-emerald-100 text-emerald-800",
                                "CANCELADA" or "RECHAZADA" => "bg-error-container text-error",
                                _ => "bg-surface-container text-text-muted"
                            };

                            <tr class="hover:bg-surface-container-low/40 transition-colors">
                                <td class="py-4 px-4 font-mono font-bold text-primary">
                                    @(ord.NumeroOrden ?? ord.OrdenId)
                                </td>
                                <td class="py-4 px-4 text-text-muted whitespace-nowrap">
                                    @FechaHelper.Formatear(ord.CreadaEn ?? ord.ActualizadaEn)
                                </td>
                                @if (isStaff)
                                {
                                    <td class="py-4 px-4 font-mono text-[11px] text-text-muted truncate max-w-[150px]" title="@(ord.ClienteId ?? "")">
                                        @(string.IsNullOrWhiteSpace(ord.ClienteId) ? "N/D" : ord.ClienteId)
                                    </td>
                                }
                                <td class="py-4 px-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold @badgeClass">
                                        @SgoLogic.Web.Services.EtiquetasEstadoOrden.Etiqueta(ord.Estado)
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    @if (desp != null && !string.IsNullOrWhiteSpace(desp.GuiaId))
                                    {
                                        <span class="font-mono text-secondary font-bold">@desp.GuiaId</span>
                                    }
                                    else if (desp?.MetodoEntrega == "RECOGIDA_TIENDA")
                                    {
                                        <span class="text-emerald-700 font-semibold">Recogida en Tienda</span>
                                    }
                                    else if (ord.Estado == "CANCELADA" || ord.Estado == "RECHAZADA")
                                    {
                                        <span class="text-text-muted font-medium">No aplica</span>
                                    }
                                    else
                                    {
                                        <span class="text-amber-600 font-medium">Asignando guía...</span>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    <span class="font-semibold text-primary">
                                        @if (ord.Estado == "CANCELADA" || ord.Estado == "RECHAZADA")
                                        {
                                            <span class="text-text-muted">CANCELADO</span>
                                        }
                                        else
                                        {
                                            @(desp?.Estado ?? (ord.Estado == "DESPACHO_SOLICITADO" ? "SOLICITADO" : "EN COLA"))
                                        }
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-right font-bold text-primary whitespace-nowrap">
                                    Q @ord.Total.ToString("F2")
                                </td>
                                <td class="py-4 px-4 text-center whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a href="/Estado?ordenId=@ord.OrdenId"
                                           class="inline-flex items-center gap-1 bg-surface-container-low hover:bg-primary hover:text-on-primary text-primary px-3 py-1.5 rounded-xl font-semibold transition-all shadow-2xs text-[11px]">
                                            <span>Detalle</span>
                                            <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                        </a>
                                        @if (isStaff && !string.IsNullOrWhiteSpace(ord.ClienteId))
                                        {
                                            <a href="/Vision360?clienteId=@ord.ClienteId"
                                               class="inline-flex items-center p-1.5 rounded-xl text-text-muted hover:text-secondary hover:bg-secondary-fixed/40 transition-all" title="Ver en Visión 360">
                                                <span class="material-symbols-outlined text-[15px]">support_agent</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <!-- Detalle Completo de la Orden Seleccionada -->
    @if (isStaff)
    {
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3 bg-secondary-fixed/30 border border-secondary-container/40 p-3.5 rounded-2xl">
            <div class="flex flex-wrap items-center gap-2">
                <a href="/Estado" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary bg-surface-white hover:bg-surface-container px-3 py-1.5 rounded-xl border border-border-subtle shadow-2xs transition-all">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                    Volver a Todas las Órdenes
                </a>
                <a href="/Despacho" class="inline-flex items-center gap-1.5 text-xs font-semibold text-secondary bg-surface-white hover:bg-surface-container px-3 py-1.5 rounded-xl border border-border-subtle shadow-2xs transition-all">
                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                    Ir a Control de Despacho
                </a>
                @if (!string.IsNullOrWhiteSpace(Model.ClienteId))
                {
                    <a href="/Vision360?clienteId=@Model.ClienteId" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary bg-surface-white hover:bg-surface-container px-3 py-1.5 rounded-xl border border-border-subtle shadow-2xs transition-all">
                        <span class="material-symbols-outlined text-[16px]">support_agent</span>
                        Visión 360 del Cliente
                    </a>
                }
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-secondary uppercase tracking-wider">
                <span class="material-symbols-outlined text-[15px]">admin_panel_settings</span>
                Modo Supervisión Global
            </span>
        </div>
    }
    else
    {
        <div class="mb-4">
            <a href="/Estado" class="inline-flex items-center gap-1.5 text-xs font-semibold text-secondary hover:underline">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                Volver a mis compras y guías
            </a>
        </div>
    }

    <div class="bg-surface-white rounded-3xl ambient-shadow border border-border-subtle/50 p-6 md:p-8 mb-8"
         id="orden-container"
         data-orden-id="@Model.OrdenId"
         data-estado="@Model.Estado"
         data-despacho-estado="@(despacho?.Estado ?? "")"
         data-despacho-guia="@(despacho?.GuiaId ?? "")">

        <!-- Card Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-border-subtle/60 gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[28px]">inventory_2</span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Orden de Compra</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" title="Sincronizacion reactiva activa"></span>
                        <span class="text-[10px] text-text-muted font-mono" id="sync-status">Sincronizado</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold text-primary tracking-tight font-mono">@(Model.NumeroOrden ?? Model.OrdenId)</h2>
                    <div class="text-xs text-text-muted mt-1">
                        Fecha: <span class="font-medium text-primary">@FechaHelper.Formatear(Model.CreadaEn ?? Model.ActualizadaEn)</span>
                    </div>
                </div>
            </div>

            @{
                var (badgeBg, badgeText, badgeIcon) = Model.Estado switch
                {
                    "CREADA" => ("bg-blue-100 text-blue-800 border-blue-200", "CREADA", "hourglass_top"),
                    "COBRO_SOLICITADO" or "PAGO_PENDIENTE" => ("bg-amber-100 text-amber-800 border-amber-200", Model.Estado, "pending"),
                    "EVALUACION_CREDITO_SOLICITADA" => ("bg-amber-100 text-amber-800 border-amber-200", "Confirmando crédito", "pending"),
                    "CREDITO_APROBADO" => ("bg-secondary-fixed text-on-secondary-fixed border-secondary-container/50", "Crédito aprobado", "verified"),
                    "PAGO_APLICADO" or "CONFIRMADA" or "CONFIRMADA_PENDIENTE_FISCAL" => ("bg-secondary-fixed text-on-secondary-fixed border-secondary-container/50", Model.Estado, "verified"),
                    "DESPACHO_SOLICITADO" or "EN_PREPARACION" => ("bg-purple-100 text-purple-800 border-purple-200", Model.Estado, "inventory"),
                    "EN_TRANSITO" => ("bg-indigo-100 text-indigo-800 border-indigo-200", "EN TRANSITO", "local_shipping"),
                    "LISTA_PARA_RECOGER" => ("bg-emerald-100 text-emerald-800 border-emerald-200", "LISTA PARA RECOGER", "storefront"),
                    "ENTREGADA" => ("bg-emerald-100 text-emerald-800 border-emerald-200", "ENTREGADA", "task_alt"),
                    "CANCELADA" or "RECHAZADA" => ("bg-error-container text-error border-error/30", Model.Estado, "cancel"),
                    _ => ("bg-surface-container-high text-on-surface-variant border-border-subtle", Model.Estado ?? "DESCONOCIDO", "help")
                };
            }

            <span id="badge-estado-principal" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold border @badgeBg self-start sm:self-auto shadow-2xs">
                <span class="material-symbols-outlined text-[16px]">@badgeIcon</span>
                <span id="badge-estado-texto">@badgeText</span>
            </span>
        </div>

        @{
            var isCancelledOrRejected = Model.Estado == "CANCELADA" || Model.Estado == "RECHAZADA";
        }

        @if (reembolso is not null)
        {
            <!-- Reembolso a la tarjeta: primero y destacado; se actualiza solo mientras esta en proceso -->
            <partial name="_ReembolsoOrden" model="new SgoLogic.Web.Services.ReembolsoBannerModel(Model.OrdenId, reembolso)" />
        }

        @if (isCancelledOrRejected)
        {
            var esRechazada = Model.Estado == "RECHAZADA";
            <div class="mb-6 p-4 rounded-2xl border flex items-start gap-3 @(esRechazada ? "bg-red-50 border-red-200 text-red-950" : "bg-surface-white border-border-subtle text-primary")">
                <span class="material-symbols-outlined text-[24px] flex-shrink-0 mt-0.5 @(esRechazada ? "text-red-600" : "text-primary")">@(esRechazada ? "error" : "task_alt")</span>
                <div class="flex-1">
                    <h3 class="font-bold text-sm">
                        @(esRechazada ? "Orden rechazada" : "Orden cancelada")
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(Model.MotivoUltimoCambio))
                    {
                        <p class="text-xs mt-1 leading-relaxed opacity-90">
                            Motivo: <strong>@Model.MotivoUltimoCambio</strong>
                        </p>
                    }
                    else if (esRechazada)
                    {
                        <p class="text-xs mt-1 leading-relaxed opacity-90">No fue posible completar tu compra.</p>
                    }
                </div>
            </div>
        }

        <!-- Saga Visual Stepper -->
        <div class="mb-8 p-5 bg-surface-container-low/40 rounded-2xl border border-border-subtle/50">
            <span class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-4">Progreso de la Saga Transaccional:</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                <!-- Step 1: Creada / Cobro -->
                <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/70 flex items-center gap-2.5">
                    @if (isCancelledOrRejected)
                    {
                        <span class="w-6 h-6 rounded-full bg-red-500 text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-[14px]">close</span>
                        </span>
                        <div>
                            <div class="font-bold text-red-900">1. Transacción</div>
                            <div class="text-[11px] text-red-700 truncate max-w-[130px]" title="@(Model.MotivoUltimoCambio ?? "Rechazada")">@(Model.MotivoUltimoCambio ?? "Rechazada")</div>
                        </div>
                    }
                    else
                    {
                        <span class="w-6 h-6 rounded-full bg-emerald-500 text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </span>
                        <div>
                            <div class="font-bold text-primary">1. Creada & Cobro</div>
                            <div class="text-[11px] text-text-muted">@(SgoLogic.Web.Services.EtiquetasEstadoOrden.EsRutaCredito(Model.Estado) ? SgoLogic.Web.Services.EtiquetasEstadoOrden.Etiqueta(Model.Estado) : "Tarjeta tokenizada")</div>
                        </div>
                    }
                </div>

                <!-- Step 2: Confirmación Fiscal -->
                @{
                    var step2Done = !isCancelledOrRejected && Model.DocumentoFiscalId != null;
                    var step2Pending = !isCancelledOrRejected && (Model.Estado == "CONFIRMADA" || Model.Estado == "PAGO_APLICADO" || Model.Estado == "CONFIRMADA_PENDIENTE_FISCAL");
                }
                <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/70 flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full @(step2Done ? "bg-emerald-500 text-white" : "bg-surface-container text-text-muted") font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                        @if (step2Done)
                        {
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        }
                        else if (isCancelledOrRejected)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>2</span>
                        }
                    </span>
                    <div>
                        <div class="font-bold @(isCancelledOrRejected ? "text-text-muted" : "text-primary")">2. Certificación Fiscal</div>
                        <div class="text-[11px] text-text-muted">@(isCancelledOrRejected ? "No Aplica" : (step2Done ? "SAT FEL (DTE)" : (step2Pending ? "En Certificación" : "Pendiente")))</div>
                    </div>
                </div>

                <!-- Step 3: Preparación / Despacho -->
                @{
                    var step3Done = !isCancelledOrRejected && (Model.Estado == "EN_PREPARACION" || Model.Estado == "EN_TRANSITO" || Model.Estado == "LISTA_PARA_RECOGER" || Model.Estado == "ENTREGADA");
                    var step3Pending = !isCancelledOrRejected && Model.Estado == "DESPACHO_SOLICITADO";
                }
                <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/70 flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full @(step3Done ? "bg-emerald-500 text-white" : "bg-surface-container text-text-muted") font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                        @if (step3Done)
                        {
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        }
                        else if (isCancelledOrRejected)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>3</span>
                        }
                    </span>
                    <div>
                        <div class="font-bold @(isCancelledOrRejected ? "text-text-muted" : "text-primary")">3. Preparación</div>
                        <div class="text-[11px] text-text-muted">@(isCancelledOrRejected ? "No Aplica" : (step3Done ? "Preparado" : (step3Pending ? "Asignando Logística" : "Pendiente")))</div>
                    </div>
                </div>

                <!-- Step 4: Entrega Final -->
                @{
                    var step4Done = !isCancelledOrRejected && Model.Estado == "ENTREGADA";
                }
                <div class="p-3 rounded-xl bg-surface-white border border-border-subtle/70 flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full @(step4Done ? "bg-emerald-500 text-white" : "bg-surface-container text-text-muted") font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                        @if (step4Done)
                        {
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        }
                        else if (isCancelledOrRejected)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>4</span>
                        }
                    </span>
                    <div>
                        <div class="font-bold @(isCancelledOrRejected ? "text-text-muted" : "text-primary")">4. Entrega</div>
                        <div class="text-[11px] text-text-muted">@(isCancelledOrRejected ? "No Aplica" : (Model.MetodoEntrega == "RECOGIDA_TIENDA" ? "Mostrador Tienda" : "LogiExpress"))</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3-Column Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <!-- Card 1: Montos & Pago -->
            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle/60">
                <div class="flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider mb-3">
                    <span class="material-symbols-outlined text-secondary text-[18px]">payments</span>
                    Pago & Transacción
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Total:</span>
                        <span class="font-bold text-primary">@(Model.Moneda ?? "GTQ") @(Model.Total?.ToString("F2") ?? "0.00")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Fecha Creación:</span>
                        <span class="font-medium text-primary">@FechaHelper.Formatear(Model.CreadaEn ?? Model.ActualizadaEn)</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Canal:</span>
                        <span class="font-semibold text-primary">@(Model.Canal ?? "WEB")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">ID Transacción:</span>
                        @if (!string.IsNullOrWhiteSpace(Model.PagoId))
                        {
                            <span class="font-mono text-secondary font-bold">@Model.PagoId</span>
                        }
                        else if (isCancelledOrRejected)
                        {
                            <span class="font-mono text-text-muted font-semibold">No Aplicado</span>
                        }
                        else
                        {
                            <span class="font-mono text-amber-600 font-medium">En Proceso</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Card 2: Fiscal SAT FEL -->
            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle/60">
                <div class="flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider mb-3">
                    <span class="material-symbols-outlined text-secondary text-[18px]">receipt_long</span>
                    Facturación SAT FEL
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Certificación:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-bold text-text-muted">No Emitido</span>
                        }
                        else if (Model.DocumentoFiscalId != null)
                        {
                            <span class="font-bold text-primary">Certificado FEL</span>
                        }
                        else
                        {
                            <span class="font-bold text-amber-700">En Proceso</span>
                        }
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">DTE No.:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-mono text-text-muted">No Aplica</span>
                        }
                        else
                        {
                            <span class="font-mono text-secondary font-bold truncate max-w-[150px]">@(Model.DocumentoFiscalId ?? "Pendiente")</span>
                        }
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">IVA 12% Incluido:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-semibold text-text-muted">No Aplicado</span>
                        }
                        else if (Model.DocumentoFiscalId != null)
                        {
                            <span class="font-semibold text-emerald-700">Certificado</span>
                        }
                        else
                        {
                            <span class="font-semibold text-amber-700">En Trámite</span>
                        }
                    </div>
                    @if (notasCredito.Count > 0)
                    {
                        <div class="flex justify-between">
                            <span class="text-text-muted">Nota de crédito:</span>
                            <span class="font-semibold text-primary">@(notasCredito.Any(n => n.EstaCertificada) ? "Emitida" : "En trámite")</span>
                        </div>
                    }
                    @if (isCancelledOrRejected && notasCredito.Count > 0)
                    {
                        <div class="pt-2">
                            <a href="/Estado/Factura?ordenId=@Uri.EscapeDataString(Model.OrdenId)"
                               class="w-full inline-flex items-center justify-center gap-1.5 bg-surface-white hover:bg-surface-container text-primary px-3 py-2 rounded-xl text-xs font-semibold border border-border-subtle/70 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">description</span>
                                Ver factura y nota de crédito
                            </a>
                        </div>
                    }
                    @if (!isCancelledOrRejected)
                    {
                        <div class="pt-2">
                            <a href="/Estado/Factura?ordenId=@Uri.EscapeDataString(Model.OrdenId)"
                               class="w-full inline-flex items-center justify-center gap-1.5 bg-surface-white hover:bg-surface-container text-primary px-3 py-2 rounded-xl text-xs font-semibold border border-border-subtle/70 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">description</span>
                                Ver factura
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Card 3: Despacho Logístico -->
            <div class="p-5 rounded-2xl bg-surface-container-low/40 border border-border-subtle/60">
                <div class="flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider mb-3">
                    <span class="material-symbols-outlined text-secondary text-[18px]">local_shipping</span>
                    Logística & Despacho
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-text-muted">Método:</span>
                        <span class="font-bold text-primary">@(Model.MetodoEntrega ?? "DOMICILIO")</span>
                    </div>
                    @if (!isCancelledOrRejected && !string.IsNullOrWhiteSpace(tiendaOrigen))
                    {
                        <div class="flex items-start gap-1.5 p-2 rounded-lg bg-amber-50 border border-amber-200/70 text-amber-900 font-medium">
                            <span class="material-symbols-outlined text-[15px]">storefront</span>
                            <span>Este envío sale desde la tienda @tiendaOrigen</span>
                        </div>
                    }
                    <div class="flex justify-between">
                        <span class="text-text-muted">Transportista:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-semibold text-text-muted">No Aplica</span>
                        }
                        else
                        {
                            <span class="font-semibold text-primary">@(despacho?.Transportista ?? (Model.MetodoEntrega == "RECOGIDA_TIENDA" ? "Flota Interna" : "LogiExpress"))</span>
                        }
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-muted">Guía de Envío:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-mono text-text-muted font-semibold">No Asignada</span>
                        }
                        else if (Model.MetodoEntrega == "RECOGIDA_TIENDA")
                        {
                            <span class="font-semibold text-emerald-700">Recogida en Tienda</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(despacho?.GuiaId))
                        {
                            <span class="inline-flex items-center gap-1.5 font-mono text-secondary font-bold bg-surface-container px-2.5 py-1 rounded-lg border border-border-subtle/70" title="Guía Oficial LogiExpress">
                                <span class="material-symbols-outlined text-[14px] text-secondary">local_shipping</span>
                                @(despacho?.GuiaId)
                            </span>
                        }
                        else
                        {
                            <span class="font-mono text-amber-600 font-medium">Asignando guía...</span>
                        }
                    </div>
                    <div class="flex justify-between pt-1 border-t border-border-subtle/40">
                        <span class="text-text-muted">Estado del Envío:</span>
                        @if (isCancelledOrRejected)
                        {
                            <span class="font-bold text-text-muted">CANCELADO</span>
                        }
                        else
                        {
                            <span class="font-bold text-primary">@(despacho?.Estado ?? (Model.Estado == "DESPACHO_SOLICITADO" ? "SOLICITADO" : "EN COLA"))</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Incidencias del Pedido -->
        <div class="pt-6 border-t border-border-subtle/60">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
                <div class="flex items-center gap-2 font-bold text-primary text-base">
                    <span class="material-symbols-outlined text-text-muted">report_problem</span>
                    <span>Incidencias del Pedido</span>
                </div>
                <a href="/Incidencias/Crear?ordenId=@Model.OrdenId"
                   class="inline-flex items-center gap-1.5 bg-surface-container-low hover:bg-surface-variant text-primary px-4 py-2 rounded-xl text-xs font-semibold transition-colors border border-border-subtle/50 shadow-2xs">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    Levantar Nueva Incidencia
                </a>
            </div>

            @if (Model.Incidencias == null || !Model.Incidencias.Any())
            {
                <div class="bg-surface-bright/50 rounded-2xl p-5 text-center text-xs text-text-muted border border-border-subtle/40">
                    No se registran incidencias ni reclamos sobre esta orden. El pedido cursa normalmente.
                </div>
            }
            else
            {
                <div class="overflow-x-auto rounded-2xl border border-border-subtle/50">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-surface-bright/60 border-b border-border-subtle text-text-muted uppercase font-semibold">
                                <th class="py-3 px-4">Fecha</th>
                                <th class="py-3 px-4">Descripción del Reclamo</th>
                                <th class="py-3 px-4">Estado</th>
                                <th class="py-3 px-4">Resolución de Soporte</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-subtle/50">
                            @foreach (var inc in Model.Incidencias)
                            {
                                <tr>
                                    <td class="py-3 px-4 text-text-muted whitespace-nowrap">@FechaHelper.Formatear(inc.CreadaEn)</td>
                                    <td class="py-3 px-4 text-primary font-medium">@inc.Descripcion</td>
                                    <td class="py-3 px-4">
                                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold @(inc.Estado == "RESUELTA" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                            @inc.Estado
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-text-muted">@(inc.Resolucion ?? "En revision por operador logistico")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<script>
    const container = document.getElementById('orden-container');
    if (container) {
        const ordenId = container.getAttribute('data-orden-id');
        let estadoActual = container.getAttribute('data-estado');
        let despachoEstadoActual = container.getAttribute('data-despacho-estado') || '';
        let despachoGuiaActual = container.getAttribute('data-despacho-guia') || '';
        const syncStatus = document.getElementById('sync-status');

        const terminalStates = ['ENTREGADA', 'CANCELADA', 'RECHAZADA', 'CANCELADA_RESERVA_VENCIDA', 'DEVUELTA'];

        if (!terminalStates.includes(estadoActual)) {
            const interval = setInterval(async () => {
                try {
                    const res = await fetch(`/Estado/Api/${ordenId}`);
                    if (res.ok) {
                        const data = await res.json();
                        const orden = data.orden;
                        const desp = data.despacho;

                        const ordenCambio = orden && orden.estado !== estadoActual;
                        const despachoEstadoCambio = desp && desp.estado && desp.estado !== despachoEstadoActual;
                        const despachoGuiaCambio = desp && desp.guiaId && desp.guiaId !== despachoGuiaActual;

                        if (ordenCambio || despachoEstadoCambio || despachoGuiaCambio) {
                            if (syncStatus) syncStatus.textContent = 'Actualizando...';
                            window.location.reload();
                        }
                    }
                } catch (err) {
                    console.log('Polling sync error:', err);
                }
            }, 2500);
        }
    }
</script>
