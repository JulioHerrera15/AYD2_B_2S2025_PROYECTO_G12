@model SgoLogic.Web.Services.OrdenEstadoModel?

@{
    ViewData["Title"] = "Consulta de Estado";
}

<!-- Header -->
<div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-2">
        Consulta de Estado y Trazabilidad
    </h1>
    <p class="text-sm text-text-muted max-w-2xl">
        Seguimiento en tiempo real de órdenes con modelo de lectura CQRS, regla de estado autoritativo por eventos e histórico de incidencias.
    </p>
</div>

<!-- Search Input Card -->
<div class="bg-surface-white rounded-2xl ambient-shadow border border-border-subtle/50 p-5 md:p-6 mb-8">
    <form method="get" action="/Estado" class="relative max-w-2xl">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-[22px]">search</span>
        <input type="text" 
               name="ordenId" 
               class="w-full bg-surface-container-low border-none rounded-full py-3.5 pl-12 pr-32 focus:bg-surface-white focus:ring-2 focus:ring-secondary text-sm font-medium text-primary placeholder:text-text-muted transition-all" 
               placeholder="Ingrese ID de la orden (ej: ORD-2026-001 o UUID)..." 
               value="@ViewBag.OrdenId" 
               required />
        <button type="submit" 
                class="absolute right-2 top-1/2 -translate-y-1/2 bg-primary text-on-primary px-5 py-2 rounded-full text-xs font-semibold hover:opacity-90 transition-opacity active:scale-95 shadow-sm">
            Consultar
        </button>
    </form>
    <div class="mt-3 flex flex-wrap items-center gap-2 pt-2">
        <span class="text-xs text-text-muted font-medium">Órdenes de prueba activas:</span>
        <a href="/Estado?ordenId=ORD-2026-001" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-low hover:bg-secondary-fixed text-primary transition-colors border border-border-subtle/40">ORD-2026-001 (CONFIRMADA)</a>
        <a href="/Estado?ordenId=ORD-8950" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-low hover:bg-secondary-fixed text-primary transition-colors border border-border-subtle/40">ORD-8950 (CREADA)</a>
        <a href="/Estado?ordenId=ORD-8951" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-low hover:bg-secondary-fixed text-primary transition-colors border border-border-subtle/40">ORD-8951 (CANCELADA)</a>
        <a href="/Estado?ordenId=ORD-8952" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-low hover:bg-secondary-fixed text-primary transition-colors border border-border-subtle/40">ORD-8952 (ENTREGADA)</a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="mb-8 bg-error-container text-on-error-container border border-error/20 rounded-xl p-4 flex items-center gap-3 ambient-shadow">
        <span class="material-symbols-outlined text-error" style="font-variation-settings: 'FILL' 1;">error</span>
        <div class="text-sm font-medium">@ViewBag.Error</div>
    </div>
}

@if (Model != null)
{
    <!-- Order Card -->
    <div class="bg-surface-white rounded-2xl ambient-shadow border border-border-subtle/50 p-6 md:p-8 mb-8">
        <!-- Card Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-border-subtle/60 gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-surface-container-low text-primary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[24px]">inventory_2</span>
                </div>
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Orden de Compra</span>
                    <h2 class="text-xl font-bold text-primary tracking-tight">@Model.OrdenId</h2>
                </div>
            </div>

            @{
                var (badgeBg, badgeText, badgeIcon) = Model.Estado switch
                {
                    "CREADA" => ("bg-secondary-fixed text-on-secondary-fixed", "CREADA", "hourglass_top"),
                    "CONFIRMADA" or "CONFIRMADA_PENDIENTE_FISCAL" => ("bg-secondary-fixed text-on-secondary-fixed", Model.Estado, "check_circle"),
                    "ENTREGADA" => ("bg-emerald-100 text-emerald-800", "ENTREGADA", "task_alt"),
                    "CANCELADA" or "RECHAZADA" => ("bg-error-container text-error", Model.Estado, "cancel"),
                    _ => ("bg-surface-container-high text-on-surface-variant", Model.Estado ?? "DESCONOCIDO", "help")
                };
            }

            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold @badgeBg self-start sm:self-auto">
                <span class="material-symbols-outlined text-[15px]">@badgeIcon</span>
                @badgeText
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.MotivoUltimoCambio))
        {
            <div class="mb-6 @(Model.Estado == "RECHAZADA" || Model.Estado == "CANCELADA" ? "bg-error-container/60 border-error/40 text-on-error-container" : "bg-secondary-fixed/40 border-secondary/30 text-on-secondary-fixed") border rounded-2xl p-4 flex items-start gap-3.5 ambient-shadow">
                <span class="material-symbols-outlined @(Model.Estado == "RECHAZADA" || Model.Estado == "CANCELADA" ? "text-error" : "text-secondary") text-[24px] mt-0.5" style="font-variation-settings: 'FILL' 1;">
                    @(Model.Estado == "RECHAZADA" ? "cancel" : Model.Estado == "CANCELADA" ? "block" : "info")
                </span>
                <div>
                    <div class="text-xs font-bold uppercase tracking-wider mb-1">
                        @(Model.Estado == "RECHAZADA" ? "Motivo del Rechazo de la Orden" : Model.Estado == "CANCELADA" ? "Motivo de la Cancelación" : "Detalle del Estado")
                    </div>
                    <div class="text-sm font-semibold">
                        @Model.MotivoUltimoCambio
                    </div>
                </div>
            </div>
        }

        <!-- Details Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 mb-8">
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Correlativo</span>
                <span class="text-sm font-semibold text-primary">@(Model.NumeroOrden ?? "N/A")</span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Canal</span>
                <span class="text-sm font-semibold text-primary">@(Model.Canal ?? "ONLINE")</span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Método de Entrega</span>
                <span class="text-sm font-semibold text-primary">@(Model.MetodoEntrega ?? "STANDARD")</span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Monto Total</span>
                <span class="text-lg font-bold text-primary tracking-tight">
                    @(Model.Moneda ?? "GTQ") @(Model.Total?.ToString("N2") ?? "0.00")
                </span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">ID de Pago</span>
                <span class="text-xs font-mono bg-surface-container-low px-2 py-1 rounded text-primary block truncate">
                    @(Model.PagoId ?? "Pendiente")
                </span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Certificación Fiscal (SAT)</span>
                <span class="text-xs font-mono bg-surface-container-low px-2 py-1 rounded text-primary block truncate">
                    @(Model.DocumentoFiscalId ?? "Pendiente")
                </span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Fecha de Creación</span>
                <span class="text-sm text-primary font-medium">
                    @(Model.CreadaEn?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                </span>
            </div>
            <div>
                <span class="text-xs text-text-muted block mb-1 font-medium">Última Actualización</span>
                <span class="text-sm text-primary font-medium">
                    @(Model.ActualizadaEn?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                </span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.MotivoUltimoCambio))
            {
                <div class="col-span-2 sm:col-span-3 lg:col-span-4 bg-surface-container-low/50 p-3 rounded-xl border border-border-subtle/50">
                    <span class="text-xs text-text-muted block mb-0.5 font-medium">Motivo / Causa del Estado Actual</span>
                    <span class="text-sm font-bold @(Model.Estado == "RECHAZADA" ? "text-error" : "text-primary")">
                        @Model.MotivoUltimoCambio
                    </span>
                </div>
            }
        </div>

        <!-- Incidents List -->
        <div class="pt-6 border-t border-border-subtle/60">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
                <div class="flex items-center gap-2 font-bold text-primary text-base">
                    <span class="material-symbols-outlined text-text-muted">report_problem</span>
                    <span>Incidencias Registradas (HU-021)</span>
                </div>
                <a href="/Incidencias/Crear?ordenId=@Model.OrdenId" 
                   class="inline-flex items-center gap-1.5 bg-surface-container-low hover:bg-surface-variant text-primary px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors self-start sm:self-auto border border-border-subtle/50">
                    <span class="material-symbols-outlined text-[15px]">add</span>
                    Levantar Incidencia
                </a>
            </div>

            @if (Model.Incidencias == null || !Model.Incidencias.Any())
            {
                <div class="bg-surface-bright/50 rounded-xl p-5 text-center text-xs text-text-muted border border-border-subtle/40">
                    No se registran incidencias operativas para esta orden.
                </div>
            }
            else
            {
                <div class="overflow-x-auto rounded-xl border border-border-subtle/50">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-surface-bright/60 border-b border-border-subtle text-xs text-text-muted uppercase font-semibold">
                                <th class="py-3 px-4">Fecha</th>
                                <th class="py-3 px-4">Descripción del Problema</th>
                                <th class="py-3 px-4">Estado</th>
                                <th class="py-3 px-4">Resolución</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-subtle/50">
                            @foreach (var inc in Model.Incidencias)
                            {
                                <tr class="hover:bg-surface-bright/30 transition-colors text-sm">
                                    <td class="py-3.5 px-4 text-xs text-text-muted whitespace-nowrap">
                                        @inc.CreadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4 font-medium text-primary">
                                        @inc.Descripcion
                                    </td>
                                    <td class="py-3.5 px-4 whitespace-nowrap">
                                        @if (inc.Estado == "ABIERTA")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-error-container text-error text-[11px] font-bold">
                                                <span class="material-symbols-outlined text-[13px]">pending</span>
                                                ABIERTA
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[11px] font-bold">
                                                <span class="material-symbols-outlined text-[13px]">check</span>
                                                RESUELTA
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-text-muted">
                                        @(inc.Resolucion ?? "En revisión por equipo de soporte")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
