{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "RabbitMq": ""
  },
  "Outbox": {
    "Source": "pagos",
    "PollingIntervalMs": 2000,
    "BatchSize": 20,
    "MaxReintentos": 5
  },
  "PayKlik": {
    "BaseUrl": "",
    "TimeoutMs": 5000,
    "VentanaSegundos": 30,
    "MinimoLlamadas": 3,
    "RatioFallo": 0.5,
    "AperturaSegundos": 15,
    "MaxReintentos": 1,
    "BackoffBaseMs": 1000
  },
  "Reintento": {
    "ExpiracionMinutos": 60
  },
  "Pagos": {
    "Reembolsos": {
      "MaxIntentos": 8,
      "BackoffBaseSegundos": 5,
      "BackoffMaximoSegundos": 60,
      "IntervaloSegundos": 5,
      "Lote": 50
    }
  },
  "Boveda": {
    "ClaveCifrado": "",
    "TokenTtlMinutos": 30,
    "IntervaloExpiracionSegundos": 60
  },
  "Auth": {
    "JwtSecret": ""
  }
}
