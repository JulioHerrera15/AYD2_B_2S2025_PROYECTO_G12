# Copia este archivo a .env (no se sube al repo) antes de correr docker compose up.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL: un usuario/contrasena compartido para los tres contenedores, cada
# uno con su propia base y su propio volumen (ADR-006). db-operacional aloja
# ademas las bases de sample-api y sample-worker, una por servicio.
POSTGRES_USER=sgo_admin
POSTGRES_PASSWORD=change_me

POSTGRES_OPERACIONAL_DB=sgo_operacional
POSTGRES_OPERACIONAL_MULTIPLE_DATABASES=sgo_sample_api,sgo_sample_worker
POSTGRES_FINANZAS_DB=sgo_finanzas
POSTGRES_AUDITORIA_DB=sgo_auditoria

# RabbitMQ
RABBITMQ_USER=sgo_admin
RABBITMQ_PASSWORD=change_me

# Redis (el carrito y las reservas con TTL de otros contextos la necesitan)
REDIS_PASSWORD=change_me

# Outbox (seccion Outbox de appsettings, ver docs/contratos/PLANTILLA-SERVICIO.md)
OUTBOX_POLLING_MS=2000
OUTBOX_MAX_REINTENTOS=5
OUTBOX_BATCH_SIZE=20