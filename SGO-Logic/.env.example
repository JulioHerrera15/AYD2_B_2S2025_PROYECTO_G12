# Copia este archivo a .env (no se sube al repo) antes de correr docker compose up.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL: un usuario/contrasena compartido para los tres contenedores, cada
# uno con su propia base y su propio volumen (ADR-006). db-operacional aloja una
# base por servicio.
POSTGRES_USER=sgo_admin
POSTGRES_PASSWORD=change_me

POSTGRES_OPERACIONAL_DB=sgo_operacional
POSTGRES_OPERACIONAL_MULTIPLE_DATABASES=sgo_ordenes,sgo_inventario,sgo_auth,sgo_consulta_estado,sgo_notificaciones,sgo_integracion_pos,sgo_integracion_erp,sgo_despacho
POSTGRES_FINANZAS_DB=sgo_finanzas
POSTGRES_FINANZAS_MULTIPLE_DATABASES=sgo_pagos,sgo_facturacion
POSTGRES_AUDITORIA_DB=sgo_auditoria

# Usuario restringido de aplicacion para db-auditoria: solo INSERT+SELECT sobre
# eventos_auditoria (HU-006). Las migraciones NO corren con este usuario, corren
# con POSTGRES_USER/POSTGRES_PASSWORD (ver documentacion/docs/AUDITORIA.md).
PG_AUDIT_USER=auditoria_app
PG_AUDIT_PASS=change_me

# RabbitMQ
RABBITMQ_USER=sgo_admin
RABBITMQ_PASSWORD=change_me

# Redis: carrito de Auth y modelo de lectura de Consulta de Estado. Las retenciones
# de stock del carrito viven en Postgres (Inventario) y las vence un worker, no un TTL de Redis.
REDIS_PASSWORD=change_me

OUTBOX_POLLING_MS=500
OUTBOX_MAX_REINTENTOS=5
OUTBOX_BATCH_SIZE=200

# Auth (JWT y carrito)
JWT_SECRET=change_me_at_least_32_chars_long_secret
AUTH_JWT_EXPIRACION_MINUTOS=60
AUTH_CARRITO_TTL_SEGUNDOS=86400

# Pagos: boveda transitoria de tokens de tarjeta (tabla pagos.token_pago). La clave
# AES-256 va en base64 y debe tener 32 bytes; sin ella pagos-api no arranca. Esta es
# solo para desarrollo: genera otra con "openssl rand -base64 32" fuera de la demo.
PAGOS_CLAVE_CIFRADO=VRk3YiE2FzAX8cbZXh98V2S7WUCNnaU2pyJwxZls+Nc=
# Vigencia del token en minutos: cubre la saga y los reintentos cortos con PayKlik caido.
PAGOS_TOKEN_TTL_MINUTOS=30

# Inventario: cuanto retiene stock un producto en el carrito (segundos, se recorta
# a [60, 3600]). Cualquier cambio en el carrito renueva el plazo de todas sus lineas.
INVENTARIO_CARRITO_TTL_SEGUNDOS=900

# Gateway (ADR-020: autenticación en el borde con JWT)
GATEWAY_EXIGIR_JWT=false

# Datos de demo (servicio seed-datos): usuarios con contrasena 1234, ordenes,
# envios, pagos, facturas e incidencias. Solo siembra bases vacias.
SEED_HABILITADO=true

# Mock de mensajeria — poner true para demostrar aislamiento de fallos en Notificaciones
MOCK_MENSAJERIA_FORZAR_FALLA=false

# Proveedor SMTP para envio real de correos (Gmail, Outlook, etc.)
# NOTA GMAIL: Si la cuenta tiene 2FA o rechaza contrasena normal (error 534),
# Google requiere generar una 'Contrasena de aplicacion' de 16 caracteres en:
# https://myaccount.google.com/apppasswords y colocarla en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=proyectos.usac.2023@gmail.com
SMTP_PASSWORD="ccts mvbx ejmh pyyj"
SMTP_ENABLE_SSL=true
SMTP_FROM=proyectos.usac.2023@gmail.com

# Integración ERP (integracion-erp-worker) — la direccion del mock (mock-erp)
# va fija por red interna en docker-compose.yml, no por variable de entorno.
ERP_FORMATO=CSV
ERP_TIMEOUT_MS=5000
ERP_MAX_REINTENTOS=3
ERP_MAX_INTENTOS_LOTE=5
ERP_INTERVALO_MINUTOS=30
ERP_INTERVALO_CONCILIACION_HORAS=24

# Grafana (observabilidad)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me