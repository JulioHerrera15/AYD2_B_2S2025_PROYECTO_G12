# Copia este archivo a .env (no se sube al repo) antes de correr docker compose up.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL: un usuario/contrasena compartido para los tres contenedores, cada
# uno con su propia base y su propio volumen (ADR-006). db-operacional aloja
# ademas las bases de sample-api y sample-worker, una por servicio.
POSTGRES_USER=sgo_admin
POSTGRES_PASSWORD=change_me

POSTGRES_OPERACIONAL_DB=sgo_operacional
POSTGRES_OPERACIONAL_MULTIPLE_DATABASES=sgo_sample_api,sgo_sample_worker,sgo_ordenes,sgo_inventario,sgo_auth,sgo_consulta_estado,sgo_notificaciones
POSTGRES_FINANZAS_DB=sgo_finanzas
POSTGRES_FINANZAS_MULTIPLE_DATABASES=sgo_pagos,sgo_facturacion
POSTGRES_AUDITORIA_DB=sgo_auditoria

# Usuario restringido de aplicacion para db-auditoria: solo INSERT+SELECT sobre
# eventos_auditoria (HU-006). Las migraciones NO corren con este usuario, corren
# con POSTGRES_USER/POSTGRES_PASSWORD (ver documentacion/docs/AUDITORIA.md).
PG_AUDIT_USER=auditoria_app
PG_AUDIT_PASS=change_me

# RabbitMQ
RABBITMQ_USER=sgo_admin
RABBITMQ_PASSWORD=change_me

# Redis (el carrito y las reservas con TTL de otros contextos la necesitan)
REDIS_PASSWORD=change_me

OUTBOX_POLLING_MS=2000
OUTBOX_MAX_REINTENTOS=5
OUTBOX_BATCH_SIZE=20

# Auth (JWT y carrito)
JWT_SECRET=change_me_at_least_32_chars_long_secret
AUTH_JWT_EXPIRACION_MINUTOS=60
AUTH_CARRITO_TTL_SEGUNDOS=86400

# Mock de mensajeria — poner true para demostrar aislamiento de fallos en Notificaciones
MOCK_MENSAJERIA_FORZAR_FALLA=false

# Grafana (observabilidad)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me